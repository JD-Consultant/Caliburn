# Copy to .env. This is a new deployment; do not use an existing business database.
# Use only URL-safe characters because this value also appears in a database URL.
CALIBURN_POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
CALIBURN_APP_PORT=8101
CALIBURN_POSTGRES_PORT=55441
CALIBURN_QDRANT_PORT=6335
