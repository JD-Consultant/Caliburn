# Qdrant
QDRANT_URL=https://qdrant.yokosama.com
QDRANT_API_KEY=
QDRANT_TIMEOUT=300

# Source data
# Drop OCS JSON copies under <OCS_SOURCE_ROOT>/<subdir>/*.json before `index`.
# source_file payload is computed relative to OCS_SOURCE_ROOT.
OCS_SOURCE_ROOT=./data
OCS_SOURCE_ROOT_ALIAS=jd-ocs

# Collection / schema
QDRANT_COLLECTION=ocs_v3
SCHEMA_VERSION=ocs-index-v2
EMBEDDING_PROVIDER=bge-m3

# Embedding
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_USE_FP16=false
BGE_M3_BATCH_SIZE=8

# Pipeline
INDEX_BATCH_SIZE=32
MANIFEST_PATH=.data/manifest.json

# Query API (optional extra: `uv sync --extra api`)
# Run: jd-ocs-indexer serve --host 127.0.0.1 --port 8000
# Endpoints: POST /search, POST /task-pool, GET /profile/{ocs_code}/pairs,
#            GET /healthz, GET /stats  (OpenAPI docs at /docs)
