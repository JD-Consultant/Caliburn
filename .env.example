# Qdrant
QDRANT_URL=https://qdrant.yokosama.com
QDRANT_API_KEY=

# Source data
OCS_SOURCE_ROOT=S:/jd-pdf-to-json
OCS_SOURCE_ROOT_ALIAS=jd-pdf-to-json

# Collection / schema
QDRANT_COLLECTION=ocs_bgem3_v2
SCHEMA_VERSION=ocs-index-v2
EMBEDDING_PROVIDER=bge-m3

# Embedding
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_USE_FP16=false
BGE_M3_BATCH_SIZE=8

# Pipeline
INDEX_BATCH_SIZE=64
MANIFEST_PATH=.data/manifest.json
