# Copy to the root .env for Docker Compose only; never commit the filled file.
# Set once, then retain the same password for this database volume.
# Use a long URL-safe password: letters, digits, hyphens and underscores.
CALIBURN_POSTGRES_PASSWORD=
CALIBURN_APP_PORT=8100
CALIBURN_POSTGRES_PORT=55440
# Optional backend-only key file. Missing file leaves AI disabled.
CALIBURN_OPENAI_ENV_FILE=./apps/api/.env
