# Caliburn api — copy to .env and fill secrets. .env is gitignored.

# App
DEBUG=false

# PostgreSQL — matches docker compose `db`. Default already correct.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/caliburn
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/caliburn

# OpenRouter LLM gateway (D10) — per-role models, OpenAI-compatible.
# Empty key → AI/deep features degrade gracefully (catalog-only, no LLM calls).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_DEEP=deepseek/deepseek-chat
MODEL_INDICATOR=deepseek/deepseek-chat
MODEL_CHEAP=deepseek/deepseek-chat

# jd-ocs-indexer query API (the indexer's `serve` on :8000)
INDEXER_BASE_URL=http://localhost:8000
INDEXER_API_KEY=
INDEXER_TIMEOUT_S=30

# Document output
DOCUMENT_OUTPUT_DIR=./output/documents

# CJK font for PDF/XLSX export (blank = auto-detect platform default)
# Windows: C:/Windows/Fonts/NotoSansTC-VF.ttf
# FONT_PATH=
