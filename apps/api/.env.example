# Caliburn API — copy to .env and fill secrets. .env is gitignored.

DEBUG=false

# PostgreSQL — matches docker compose `db`.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/caliburn
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/caliburn

# OpenRouter gateway.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Versioned consultant profile. Use one exact model and one provider; no fallback.
CONSULTANT_PROFILE_ID=primary-consultant
CONSULTANT_PROFILE_REVISION=1
CONSULTANT_MODEL=anthropic/claude-opus-5
CONSULTANT_PROVIDER=Anthropic
CONSULTANT_MAX_OUTPUT_TOKENS=4096
CONSULTANT_REASONING_EFFORT=high
CONSULTANT_TIMEOUT_SECONDS=90

# Versioned bounded-run policy.
CONSULTANT_POLICY_REVISION=3
CONSULTANT_MAX_CONTEXT_TOKENS=24000
CONSULTANT_MAX_MODEL_CALLS=5
CONSULTANT_MAX_TOTAL_TOOL_CALLS=12
CONSULTANT_MODEL_RETRY_COUNT=1
CONSULTANT_TOOL_RETRY_COUNT=1
CONSULTANT_MAX_ELAPSED_SECONDS=180
CONSULTANT_MAX_TOTAL_TOKENS=32000
CONSULTANT_MAX_COST_USD=2.00
