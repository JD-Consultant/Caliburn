	caliburn.features.work_memory.position_persistence
	caliburn.features.work_memory.revision_persistence
allowed_importers =
	caliburn.features.work_memory
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:job_consultant-role]
name = job_consultant: roles cannot depend on another role
type = forbidden
source_modules =
	caliburn.agents.job_consultant
forbidden_modules =
	caliburn.agents.work_situation_analyst
	caliburn.agents.work_understanding_analyst

[importlinter:contract:memory_analysis-role]
name = memory_analysis: roles cannot depend on another role
type = forbidden
source_modules =
	caliburn.agents.memory_analysis
forbidden_modules =
	caliburn.agents.job_consultant
	caliburn.agents.work_situation_analyst
	caliburn.agents.work_understanding_analyst

[importlinter:contract:work_situation_analyst-role]
name = work_situation_analyst: roles cannot depend on another role
type = forbidden
source_modules =
	caliburn.agents.work_situation_analyst
forbidden_modules =
	caliburn.agents.job_consultant
	caliburn.agents.work_understanding_analyst

[importlinter:contract:work_understanding_analyst-role]
name = work_understanding_analyst: roles cannot depend on another role
type = forbidden
source_modules =
	caliburn.agents.work_understanding_analyst
forbidden_modules =
	caliburn.agents.job_consultant
	caliburn.agents.work_situation_analyst

[importlinter:contract:pure-domain]
name = Domain values and transformations have no transitive I/O dependency
type = forbidden
source_modules =
	caliburn.features.executions.budget_models
	caliburn.features.executions.history_models
	caliburn.features.executions.models
	caliburn.features.interview_plans.models
	caliburn.features.interviews.models
	caliburn.features.job_description.area_changes
	caliburn.features.job_description.areas
	caliburn.features.job_description.candidates
	caliburn.features.job_description.capability_changes
	caliburn.features.job_description.collaborator_changes
	caliburn.features.job_description.compound_changes
	caliburn.features.job_description.condition_changes
	caliburn.features.job_description.item_results
	caliburn.features.job_description.models
	caliburn.features.job_description.source_changes
	caliburn.features.job_description.task_changes
	caliburn.features.job_description.tasks
	caliburn.features.job_description.work_models
	caliburn.features.job_files.models
	caliburn.features.occupation_references.models
	caliburn.features.work_memory.batch_models
	caliburn.features.work_memory.candidates
	caliburn.features.work_memory.changes
	caliburn.features.work_memory.consolidation_models
	caliburn.features.work_memory.models
	caliburn.features.work_memory.read_models
	caliburn.features.work_memory.revisions
	caliburn.features.work_memory.stage_changes
forbidden_modules =
	fastapi
	sqlalchemy
	psycopg
	langgraph
	openai
