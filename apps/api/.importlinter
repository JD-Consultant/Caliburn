# Dependency policies: docs/standards/code-organization.md section 2.
# Import Linter owns import resolution; TYPE_CHECKING remains part of the graph.
[importlinter]
root_package = caliburn
include_external_packages = True
exclude_type_checking_imports = False

[importlinter:contract:adapters-direction]
name = adapters: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.adapters
forbidden_modules =
	caliburn.features
	caliburn.agent_execution
	caliburn.workflows
	caliburn.transport
	caliburn.agents
	caliburn.settings
	caliburn.bootstrap

[importlinter:contract:features-direction]
name = features: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.features
forbidden_modules =
	caliburn.workflows
	caliburn.transport
	caliburn.contracts
	caliburn.agents
	caliburn.bootstrap

[importlinter:contract:agent_execution-direction]
name = agent_execution: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.agent_execution
forbidden_modules =
	caliburn.features
	caliburn.workflows
	caliburn.transport
	caliburn.agents
	caliburn.bootstrap

[importlinter:contract:workflows-direction]
name = workflows: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.workflows
forbidden_modules =
	caliburn.transport
	caliburn.contracts
	caliburn.agents
	caliburn.bootstrap

[importlinter:contract:transport-direction]
name = transport: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.transport
forbidden_modules =
	caliburn.agents
	caliburn.bootstrap

[importlinter:contract:agents-direction]
name = agents: dependencies point toward owned lower layers
type = forbidden
source_modules =
	caliburn.agents
forbidden_modules =
	caliburn.bootstrap

[importlinter:contract:composition-is-external]
name = Product layers do not import composition options or offline diagnostics
type = forbidden
source_modules =
	caliburn.adapters
	caliburn.features
	caliburn.agent_execution
	caliburn.workflows
	caliburn.transport
	caliburn.agents
forbidden_modules =
	caliburn.app_composition
	caliburn.diagnostics

[importlinter:contract:retired-packages]
name = Retired standalone authorities cannot re-enter the App
type = forbidden
source_modules =
	caliburn
forbidden_modules =
	jd_relational
	caliburn_memory

[importlinter:contract:transport-no-sql]
name = Transport delegates persistence through workflows or feature APIs
type = forbidden
source_modules =
	caliburn.transport
forbidden_modules =
	sqlalchemy
	psycopg
allow_indirect_imports = True

[importlinter:contract:executions-persistence]
name = executions: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.executions.budget_persistence
	caliburn.features.executions.history_persistence
	caliburn.features.executions.persistence
allowed_importers =
	caliburn.features.executions
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:interview_plans-persistence]
name = interview_plans: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.interview_plans.persistence
allowed_importers =
	caliburn.features.interview_plans
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:interviews-persistence]
name = interviews: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.interviews.persistence
allowed_importers =
	caliburn.features.interviews
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:job_description-persistence]
name = job_description: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.job_description.area_persistence
	caliburn.features.job_description.candidate_persistence
	caliburn.features.job_description.capability_persistence
	caliburn.features.job_description.collaborator_persistence
	caliburn.features.job_description.condition_persistence
	caliburn.features.job_description.model_reference_persistence
	caliburn.features.job_description.persistence
	caliburn.features.job_description.source_persistence
	caliburn.features.job_description.task_persistence
allowed_importers =
	caliburn.features.job_description
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:job_files-persistence]
name = job_files: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.job_files.persistence
allowed_importers =
	caliburn.features.job_files
	caliburn.workflows
	caliburn.diagnostics
	caliburn.migrations

[importlinter:contract:occupation_references-persistence]
name = occupation_references: persistence belongs to its feature
type = protected
protected_modules =
	caliburn.features.occupation_references.persistence
allowed_importers =
	caliburn.features.occupation_references
