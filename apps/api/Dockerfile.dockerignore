# Allow only the JD App's build inputs. Never send credentials, local data,
# experimental reports, Git history or unrelated RAG packages to the builder.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/
!apps/api/
!apps/api/pyproject.toml
!apps/api/uv.lock
