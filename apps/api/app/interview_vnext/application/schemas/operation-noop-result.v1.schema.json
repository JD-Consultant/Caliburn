{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Portable pointer that always carries the content integrity fields.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "content_hash",
        "byte_size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A successful verified operation whose accepted proposal set is empty.",
  "properties": {
    "schema_version": {
      "const": "operation_noop_result.v1",
      "default": "operation_noop_result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "completion_event_id": {
      "format": "uuid",
      "title": "Completion Event Id",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Reason Code",
      "type": "string"
    },
    "state_before_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Before Hash",
      "type": "string"
    },
    "state_after_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State After Hash",
      "type": "string"
    },
    "accepted_count": {
      "const": 0,
      "default": 0,
      "title": "Accepted Count",
      "type": "integer"
    },
    "dropped_count": {
      "minimum": 0,
      "title": "Dropped Count",
      "type": "integer"
    },
    "verification_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "operation_id",
    "completion_event_id",
    "reason_code",
    "state_before_hash",
    "state_after_hash",
    "dropped_count",
    "verification_artifact"
  ],
  "title": "Caliburn interview vNext verified no-op operation result v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/operation-noop-result.v1.schema.json"
}
