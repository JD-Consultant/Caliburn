{
  "$defs": {
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "gap.v2",
          "default": "gap.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "gap_id": {
          "format": "uuid",
          "title": "Gap Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/GapDimension"
        },
        "question_goal": {
          "minLength": 1,
          "title": "Question Goal",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GapStatus",
          "default": "open"
        },
        "priority_features": {
          "$ref": "#/$defs/GapPriorityFeatures"
        },
        "asked_turn_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Asked Turn Ids",
          "type": "array"
        },
        "resolution_turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Turn Id"
        },
        "resolution_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Resolution Evidence Ids",
          "type": "array"
        },
        "unresolved_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Reason"
        }
      },
      "required": [
        "gap_id",
        "session_id",
        "episode_id",
        "dimension",
        "question_goal",
        "priority_features"
      ],
      "title": "Gap",
      "type": "object"
    },
    "GapDimension": {
      "enum": [
        "trigger_input",
        "action_decision",
        "output_recipient",
        "purpose",
        "ownership_collaboration",
        "condition_tool",
        "standard_result",
        "frequency_importance",
        "exception_rework",
        "contradiction",
        "emergent"
      ],
      "title": "GapDimension",
      "type": "string"
    },
    "GapPriorityFeatures": {
      "additionalProperties": false,
      "properties": {
        "jd_value": {
          "$ref": "#/$defs/ValueLevel"
        },
        "contradiction": {
          "default": false,
          "title": "Contradiction",
          "type": "boolean"
        },
        "redundancy": {
          "default": false,
          "title": "Redundancy",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "low"
        },
        "burden": {
          "$ref": "#/$defs/ValueLevel",
          "default": "low"
        }
      },
      "required": [
        "jd_value"
      ],
      "title": "GapPriorityFeatures",
      "type": "object"
    },
    "GapStatus": {
      "enum": [
        "open",
        "asked",
        "answered",
        "declined",
        "not_applicable",
        "deferred"
      ],
      "title": "GapStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "low",
        "medium",
        "high",
        "prohibited"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "ValueLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ValueLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "apply_gap_proposals_command.v1",
      "default": "apply_gap_proposals_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "minItems": 1,
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "episode_id",
    "gaps"
  ],
  "title": "Caliburn interview vNext apply gap proposals command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/apply-gap-proposals-command.v1.schema.json"
}
