{
  "$defs": {
    "Inference": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "inference.v2",
          "default": "inference.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "inference_id": {
          "format": "uuid",
          "title": "Inference Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Type",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "contradicting_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "reference_urns": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 3,
            "type": "string"
          },
          "title": "Reference Urns",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/InferenceStatus",
          "default": "candidate"
        },
        "method": {
          "$ref": "#/$defs/InferenceMethod"
        },
        "operation_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Operation Name",
          "type": "string"
        },
        "operation_definition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Definition Hash",
          "type": "string"
        },
        "supersedes": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "superseded_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "decision_evidence_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Evidence Id"
        },
        "uncertainty_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Reason"
        }
      },
      "required": [
        "inference_id",
        "session_id",
        "type",
        "statement",
        "supporting_evidence_ids",
        "method",
        "operation_name",
        "operation_definition_hash"
      ],
      "title": "Inference",
      "type": "object"
    },
    "InferenceMethod": {
      "enum": [
        "llm",
        "rule",
        "human"
      ],
      "title": "InferenceMethod",
      "type": "string"
    },
    "InferenceStatus": {
      "enum": [
        "candidate",
        "confirmed_by_employee",
        "rejected",
        "superseded",
        "insufficient"
      ],
      "title": "InferenceStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "apply_inference_proposals_command.v1",
      "default": "apply_inference_proposals_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "inferences": {
      "items": {
        "$ref": "#/$defs/Inference"
      },
      "minItems": 1,
      "title": "Inferences",
      "type": "array"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "inferences"
  ],
  "title": "Caliburn interview vNext apply inference proposals command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/apply-inference-proposals-command.v1.schema.json"
}
