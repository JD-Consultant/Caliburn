{
  "$defs": {
    "EpisodeStatus": {
      "enum": [
        "open",
        "closing",
        "closed"
      ],
      "title": "EpisodeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "episode_state.v1",
      "default": "episode_state.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EpisodeStatus",
      "default": "open"
    },
    "opened_turn_id": {
      "format": "uuid",
      "title": "Opened Turn Id",
      "type": "string"
    },
    "closed_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed Turn Id"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "gap_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Gap Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "episode_id",
    "session_id",
    "target",
    "opened_turn_id",
    "created_at",
    "updated_at"
  ],
  "title": "Caliburn interview vNext episode state v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/episode-state.v1.schema.json"
}
