{
  "$defs": {
    "ContextualAnswerSupport": {
      "additionalProperties": false,
      "properties": {
        "support_kind": {
          "const": "contextual_answer",
          "default": "contextual_answer",
          "title": "Support Kind",
          "type": "string"
        },
        "employee_turn_id": {
          "format": "uuid",
          "title": "Employee Turn Id",
          "type": "string"
        },
        "answer_quote": {
          "minLength": 1,
          "title": "Answer Quote",
          "type": "string"
        },
        "answer_span": {
          "$ref": "#/$defs/QuoteSpan"
        },
        "question_frame_id": {
          "format": "uuid",
          "title": "Question Frame Id",
          "type": "string"
        },
        "question_frame_definition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Question Frame Definition Hash",
          "type": "string"
        },
        "target_ordinal": {
          "minimum": 1,
          "title": "Target Ordinal",
          "type": "integer"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Hash",
          "type": "string"
        },
        "binding_kind": {
          "$ref": "#/$defs/ContextualBindingKind"
        },
        "resolution": {
          "$ref": "#/$defs/ContextualResolution"
        },
        "value_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Text"
        },
        "choice_option_ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice Option Ordinal"
        }
      },
      "required": [
        "employee_turn_id",
        "answer_quote",
        "answer_span",
        "question_frame_id",
        "question_frame_definition_hash",
        "target_ordinal",
        "target_hash",
        "binding_kind",
        "resolution"
      ],
      "title": "ContextualAnswerSupport",
      "type": "object"
    },
    "ContextualBindingKind": {
      "enum": [
        "affirmation",
        "denial",
        "slot_value",
        "choice_selection"
      ],
      "title": "ContextualBindingKind",
      "type": "string"
    },
    "ContextualResolution": {
      "enum": [
        "affirmed",
        "denied",
        "supplied",
        "selected"
      ],
      "title": "ContextualResolution",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiers": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope",
          "default": "unknown"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality",
          "default": "unknown"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity",
          "default": "uncertain"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifier"
        },
        "importance": {
          "$ref": "#/$defs/Importance",
          "default": "not_stated"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership",
          "default": "unknown"
        }
      },
      "title": "EvidenceQualifiers",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit",
          "default": "unknown"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verbatim"
        }
      },
      "title": "FrequencyQualifier",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "LiteralEmployeeSpanSupport": {
      "additionalProperties": false,
      "properties": {
        "support_kind": {
          "const": "literal_employee_span",
          "default": "literal_employee_span",
          "title": "Support Kind",
          "type": "string"
        },
        "employee_turn_id": {
          "format": "uuid",
          "title": "Employee Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/QuoteSpan"
        },
        "quote_match": {
          "$ref": "#/$defs/QuoteMatch",
          "default": "exact"
        },
        "normalization_version": {
          "anyOf": [
            {
              "const": "quote_nfkc_ws.v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Version"
        }
      },
      "required": [
        "employee_turn_id",
        "quote",
        "span"
      ],
      "title": "LiteralEmployeeSpanSupport",
      "type": "object"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "QuoteMatch": {
      "enum": [
        "exact",
        "normalized"
      ],
      "title": "QuoteMatch",
      "type": "string"
    },
    "QuoteSpan": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "QuoteSpan",
      "type": "object"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evidence.v3",
      "default": "evidence.v3",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "episode_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Id"
    },
    "subject": {
      "$ref": "#/$defs/EvidenceSubject"
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "claim": {
      "minLength": 1,
      "title": "Claim",
      "type": "string"
    },
    "support": {
      "discriminator": {
        "mapping": {
          "contextual_answer": "#/$defs/ContextualAnswerSupport",
          "literal_employee_span": "#/$defs/LiteralEmployeeSpanSupport"
        },
        "propertyName": "support_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LiteralEmployeeSpanSupport"
        },
        {
          "$ref": "#/$defs/ContextualAnswerSupport"
        }
      ],
      "title": "Support"
    },
    "qualifiers": {
      "$ref": "#/$defs/EvidenceQualifiers"
    },
    "status": {
      "$ref": "#/$defs/EvidenceStatus",
      "default": "active"
    },
    "supersedes": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "superseded_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "withdrawn_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Withdrawn Reason"
    },
    "withdrawn_by_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Withdrawn By Turn Id"
    },
    "correction_target_unknown": {
      "default": false,
      "title": "Correction Target Unknown",
      "type": "boolean"
    },
    "extractor_operation_id": {
      "format": "uuid",
      "title": "Extractor Operation Id",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "session_id",
    "subject",
    "kind",
    "claim",
    "support",
    "extractor_operation_id"
  ],
  "title": "Caliburn interview vNext evidence v3",
  "type": "object",
  "$id": "https://caliburn.local/schemas/evidence.v3.schema.json"
}
