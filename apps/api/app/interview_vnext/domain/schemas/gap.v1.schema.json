{
  "$defs": {
    "GapDimension": {
      "enum": [
        "trigger_input",
        "action_decision",
        "output_recipient",
        "purpose",
        "ownership_collaboration",
        "condition_tool",
        "standard_result",
        "frequency_importance",
        "exception_rework",
        "contradiction",
        "emergent"
      ],
      "title": "GapDimension",
      "type": "string"
    },
    "GapPriorityFeatures": {
      "additionalProperties": false,
      "properties": {
        "jd_value": {
          "$ref": "#/$defs/ValueLevel"
        },
        "contradiction": {
          "default": false,
          "title": "Contradiction",
          "type": "boolean"
        },
        "redundancy": {
          "default": false,
          "title": "Redundancy",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "default": "low"
        },
        "burden": {
          "$ref": "#/$defs/ValueLevel",
          "default": "low"
        }
      },
      "required": [
        "jd_value"
      ],
      "title": "GapPriorityFeatures",
      "type": "object"
    },
    "GapStatus": {
      "enum": [
        "open",
        "asked",
        "answered",
        "declined",
        "not_applicable",
        "deferred"
      ],
      "title": "GapStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "low",
        "medium",
        "high",
        "prohibited"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "ValueLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ValueLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gap.v1",
      "default": "gap.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "gap_id": {
      "format": "uuid",
      "title": "Gap Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "dimension": {
      "$ref": "#/$defs/GapDimension"
    },
    "question_goal": {
      "minLength": 1,
      "title": "Question Goal",
      "type": "string"
    },
    "supporting_evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/GapStatus",
      "default": "open"
    },
    "priority_features": {
      "$ref": "#/$defs/GapPriorityFeatures"
    },
    "asked_turn_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Asked Turn Ids",
      "type": "array"
    },
    "unresolved_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolved Reason"
    }
  },
  "required": [
    "gap_id",
    "session_id",
    "episode_id",
    "dimension",
    "question_goal",
    "priority_features"
  ],
  "title": "Caliburn interview vNext gap v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/gap.v1.schema.json"
}
