{
  "$defs": {
    "ChoiceOption": {
      "additionalProperties": false,
      "properties": {
        "option_ordinal": {
          "maximum": 16,
          "minimum": 1,
          "title": "Option Ordinal",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "proposition": {
          "$ref": "#/$defs/QuestionProposition"
        },
        "option_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Option Hash",
          "type": "string"
        }
      },
      "required": [
        "option_ordinal",
        "label",
        "proposition",
        "option_hash"
      ],
      "title": "ChoiceOption",
      "type": "object"
    },
    "ChoiceQuestionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "const": "choice",
          "default": "choice",
          "title": "Target Kind",
          "type": "string"
        },
        "target_ordinal": {
          "maximum": 16,
          "minimum": 1,
          "title": "Target Ordinal",
          "type": "integer"
        },
        "multi_select": {
          "title": "Multi Select",
          "type": "boolean"
        },
        "introduced_dimension": {
          "$ref": "#/$defs/QuestionDimension"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          },
          "title": "Options",
          "type": "array"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Hash",
          "type": "string"
        }
      },
      "required": [
        "target_ordinal",
        "multi_select",
        "introduced_dimension",
        "options",
        "target_hash"
      ],
      "title": "ChoiceQuestionTarget",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiers": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope",
          "default": "unknown"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality",
          "default": "unknown"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity",
          "default": "uncertain"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifier"
        },
        "importance": {
          "$ref": "#/$defs/Importance",
          "default": "not_stated"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership",
          "default": "unknown"
        }
      },
      "title": "EvidenceQualifiers",
      "type": "object"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit",
          "default": "unknown"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verbatim"
        }
      },
      "title": "FrequencyQualifier",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "PropositionQuestionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "const": "proposition",
          "default": "proposition",
          "title": "Target Kind",
          "type": "string"
        },
        "target_ordinal": {
          "maximum": 16,
          "minimum": 1,
          "title": "Target Ordinal",
          "type": "integer"
        },
        "proposition": {
          "$ref": "#/$defs/QuestionProposition"
        },
        "introduced_dimensions": {
          "items": {
            "$ref": "#/$defs/QuestionDimension"
          },
          "title": "Introduced Dimensions",
          "type": "array"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Hash",
          "type": "string"
        }
      },
      "required": [
        "target_ordinal",
        "proposition",
        "introduced_dimensions",
        "target_hash"
      ],
      "title": "PropositionQuestionTarget",
      "type": "object"
    },
    "QuestionDimension": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "time_scope",
        "typicality",
        "polarity"
      ],
      "title": "QuestionDimension",
      "type": "string"
    },
    "QuestionFrameDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "question_frame_definition.v1",
          "default": "question_frame_definition.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/QuestionMode"
        },
        "question_text_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Question Text Hash",
          "type": "string"
        },
        "targets": {
          "items": {
            "discriminator": {
              "mapping": {
                "choice": "#/$defs/ChoiceQuestionTarget",
                "proposition": "#/$defs/PropositionQuestionTarget",
                "slot": "#/$defs/SlotQuestionTarget"
              },
              "propertyName": "target_kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/PropositionQuestionTarget"
              },
              {
                "$ref": "#/$defs/SlotQuestionTarget"
              },
              {
                "$ref": "#/$defs/ChoiceQuestionTarget"
              }
            ]
          },
          "title": "Targets",
          "type": "array"
        },
        "definition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Hash",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "question_text_hash",
        "targets",
        "definition_hash"
      ],
      "title": "QuestionFrameDefinition",
      "type": "object"
    },
    "QuestionFrameStaleReason": {
      "enum": [
        "document_target_changed",
        "source_evidence_changed",
        "answer_not_immediate",
        "manual_invalidation"
      ],
      "title": "QuestionFrameStaleReason",
      "type": "string"
    },
    "QuestionFrameStatus": {
      "enum": [
        "active",
        "consumed",
        "superseded",
        "stale"
      ],
      "title": "QuestionFrameStatus",
      "type": "string"
    },
    "QuestionMode": {
      "enum": [
        "open_narrative",
        "atomic_confirmation",
        "slot_request",
        "choice",
        "correction_check"
      ],
      "title": "QuestionMode",
      "type": "string"
    },
    "QuestionProposition": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiers"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/QuestionSourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "supersedes_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supersedes Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "kind",
        "claim",
        "source_refs"
      ],
      "title": "QuestionProposition",
      "type": "object"
    },
    "QuestionSlotKind": {
      "enum": [
        "frequency",
        "recipient",
        "output",
        "standard",
        "tool",
        "condition",
        "purpose",
        "ownership",
        "importance",
        "time_scope",
        "typicality"
      ],
      "title": "QuestionSlotKind",
      "type": "string"
    },
    "QuestionSourceKind": {
      "enum": [
        "employee_evidence",
        "employee_document",
        "public_reference",
        "consultant_hypothesis"
      ],
      "title": "QuestionSourceKind",
      "type": "string"
    },
    "QuestionSourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "$ref": "#/$defs/QuestionSourceKind"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_ref",
        "source_hash"
      ],
      "title": "QuestionSourceRef",
      "type": "object"
    },
    "SlotQuestionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_kind": {
          "const": "slot",
          "default": "slot",
          "title": "Target Kind",
          "type": "string"
        },
        "target_ordinal": {
          "maximum": 16,
          "minimum": 1,
          "title": "Target Ordinal",
          "type": "integer"
        },
        "slot_kind": {
          "$ref": "#/$defs/QuestionSlotKind"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "evidence_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "base_claim": {
          "minLength": 1,
          "title": "Base Claim",
          "type": "string"
        },
        "claim_template": {
          "minLength": 1,
          "title": "Claim Template",
          "type": "string"
        },
        "base_qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiers"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/QuestionSourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "supersedes_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supersedes Evidence Ids",
          "type": "array"
        },
        "introduced_dimension": {
          "$ref": "#/$defs/QuestionDimension"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Hash",
          "type": "string"
        }
      },
      "required": [
        "target_ordinal",
        "slot_kind",
        "subject",
        "evidence_kind",
        "base_claim",
        "claim_template",
        "source_refs",
        "introduced_dimension",
        "target_hash"
      ],
      "title": "SlotQuestionTarget",
      "type": "object"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "question_frame.v1",
      "default": "question_frame.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "question_frame_id": {
      "format": "uuid",
      "title": "Question Frame Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "consultant_turn_id": {
      "format": "uuid",
      "title": "Consultant Turn Id",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/QuestionFrameDefinition"
    },
    "status": {
      "$ref": "#/$defs/QuestionFrameStatus"
    },
    "opened_state_version": {
      "minimum": 1,
      "title": "Opened State Version",
      "type": "integer"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "answer_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Turn Id"
    },
    "consumed_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumed Operation Id"
    },
    "superseded_by_frame_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By Frame Id"
    },
    "stale_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/QuestionFrameStaleReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    }
  },
  "required": [
    "question_frame_id",
    "session_id",
    "consultant_turn_id",
    "definition",
    "status",
    "opened_state_version",
    "opened_at"
  ],
  "title": "Caliburn interview vNext question frame v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/question-frame.v1.schema.json"
}
