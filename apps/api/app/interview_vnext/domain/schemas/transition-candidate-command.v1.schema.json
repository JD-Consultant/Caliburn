{
  "$defs": {
    "CandidateStatus": {
      "enum": [
        "draft",
        "verified",
        "insufficient",
        "conflicted",
        "projected",
        "rejected",
        "accepted"
      ],
      "title": "CandidateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "transition_candidate_command.v1",
      "default": "transition_candidate_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "target_status": {
      "$ref": "#/$defs/CandidateStatus"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "candidate_id",
    "target_status"
  ],
  "title": "Caliburn interview vNext transition candidate command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/transition-candidate-command.v1.schema.json"
}
