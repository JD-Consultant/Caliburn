{
  "$defs": {
    "EpisodeStatus": {
      "enum": [
        "open",
        "closing",
        "closed"
      ],
      "title": "EpisodeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "transition_episode_command.v1",
      "default": "transition_episode_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "format": "uuid",
      "title": "Episode Id",
      "type": "string"
    },
    "target_status": {
      "$ref": "#/$defs/EpisodeStatus"
    },
    "closed_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed Turn Id"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "episode_id",
    "target_status"
  ],
  "title": "Caliburn interview vNext transition episode command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/transition-episode-command.v1.schema.json"
}
