{
  "$defs": {
    "GapStatus": {
      "enum": [
        "open",
        "asked",
        "answered",
        "declined",
        "not_applicable",
        "deferred"
      ],
      "title": "GapStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "transition_gap_command.v1",
      "default": "transition_gap_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "gap_id": {
      "format": "uuid",
      "title": "Gap Id",
      "type": "string"
    },
    "target_status": {
      "$ref": "#/$defs/GapStatus"
    },
    "source_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Turn Id"
    },
    "resolution_evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Resolution Evidence Ids",
      "type": "array"
    },
    "unresolved_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolved Reason"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "gap_id",
    "target_status"
  ],
  "title": "Caliburn interview vNext transition gap command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/transition-gap-command.v1.schema.json"
}
