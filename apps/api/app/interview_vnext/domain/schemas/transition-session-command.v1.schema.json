{
  "$defs": {
    "SessionStatus": {
      "enum": [
        "planned",
        "active",
        "paused",
        "finishing",
        "completed",
        "failed"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "expected_state_version": {
      "minimum": 0,
      "title": "Expected State Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "transition_session_command.v1",
      "default": "transition_session_command.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_status": {
      "$ref": "#/$defs/SessionStatus"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    }
  },
  "required": [
    "command_id",
    "expected_state_version",
    "occurred_at",
    "target_status"
  ],
  "title": "Caliburn interview vNext transition session command v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/transition-session-command.v1.schema.json"
}
