{
  "$defs": {
    "ContextSectionBudget": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Section",
          "type": "string"
        },
        "selected_items": {
          "minimum": 0,
          "title": "Selected Items",
          "type": "integer"
        },
        "item_cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Cap"
        },
        "within_item_cap": {
          "title": "Within Item Cap",
          "type": "boolean"
        },
        "utf8_bytes": {
          "minimum": 0,
          "title": "Utf8 Bytes",
          "type": "integer"
        },
        "unicode_code_points": {
          "minimum": 0,
          "title": "Unicode Code Points",
          "type": "integer"
        }
      },
      "required": [
        "section",
        "selected_items",
        "within_item_cap",
        "utf8_bytes",
        "unicode_code_points"
      ],
      "title": "ContextSectionBudget",
      "type": "object"
    },
    "TokenEstimatorIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "TokenEstimatorIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Operation Name",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "context_policy_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Context Policy Name",
      "type": "string"
    },
    "context_policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Context Policy Version",
      "type": "string"
    },
    "context_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Policy Hash",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    },
    "reference_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Snapshot Hash"
    },
    "section_order": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Section Order",
      "type": "array"
    },
    "schema_version": {
      "const": "context_budget_report.v1",
      "default": "context_budget_report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "max_utf8_bytes": {
      "minimum": 1,
      "title": "Max Utf8 Bytes",
      "type": "integer"
    },
    "actual_utf8_bytes": {
      "minimum": 0,
      "title": "Actual Utf8 Bytes",
      "type": "integer"
    },
    "unicode_code_points": {
      "minimum": 0,
      "title": "Unicode Code Points",
      "type": "integer"
    },
    "reserved_output_tokens": {
      "minimum": 1,
      "title": "Reserved Output Tokens",
      "type": "integer"
    },
    "token_estimator": {
      "$ref": "#/$defs/TokenEstimatorIdentity"
    },
    "estimated_input_tokens": {
      "minimum": 0,
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ContextSectionBudget"
      },
      "title": "Sections",
      "type": "array"
    },
    "within_budget": {
      "title": "Within Budget",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "operation_name",
    "operation_definition_hash",
    "context_policy_name",
    "context_policy_version",
    "context_policy_hash",
    "session_id",
    "turn_id",
    "operation_id",
    "state_hash",
    "section_order",
    "max_utf8_bytes",
    "actual_utf8_bytes",
    "unicode_code_points",
    "reserved_output_tokens",
    "token_estimator",
    "estimated_input_tokens",
    "sections",
    "within_budget",
    "limitations"
  ],
  "title": "Caliburn interview vNext context budget report v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/context-budget-report.v1.schema.json"
}
