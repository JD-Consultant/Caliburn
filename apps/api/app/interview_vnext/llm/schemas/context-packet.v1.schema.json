        "current_employee_turn": {
          "$ref": "#/$defs/TranscriptTurn"
        },
        "active_episode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextEpisodeIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "contradictions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextContradiction"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "correction_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextEvidenceItem"
          },
          "title": "Correction Candidates",
          "type": "array"
        },
        "recent_active_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextEvidenceItem"
          },
          "title": "Recent Active Evidence",
          "type": "array"
        }
      },
      "required": [
        "operation_name",
        "operation_definition_hash",
        "context_policy_name",
        "context_policy_version",
        "context_policy_hash",
        "session_id",
        "turn_id",
        "operation_id",
        "state_hash",
        "section_order",
        "preceding_consultant_turn",
        "current_employee_turn",
        "active_episode"
