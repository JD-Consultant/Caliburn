          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "state_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
