        },
        "context_policy_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Context Policy Version",
          "type": "string"
        },
        "context_policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
