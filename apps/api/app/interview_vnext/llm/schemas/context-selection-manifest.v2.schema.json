{
  "$defs": {
    "ContextItemDecision": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/ContextSourceRef"
        },
        "section": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Section",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "selected_ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Ordinal"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "utf8_bytes": {
          "minimum": 0,
          "title": "Utf8 Bytes",
          "type": "integer"
        },
        "unicode_code_points": {
          "minimum": 0,
          "title": "Unicode Code Points",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "section",
        "selected",
        "reason_codes",
        "content_hash",
        "utf8_bytes",
        "unicode_code_points"
      ],
      "title": "ContextItemDecision",
      "type": "object"
    },
    "ContextSourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/ContextSourceType"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "state_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Hash"
        },
        "reference_snapshot_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Snapshot Hash"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        }
      },
      "required": [
        "source_type",
        "source_id"
      ],
      "title": "ContextSourceRef",
      "type": "object"
    },
    "ContextSourceType": {
      "enum": [
        "policy",
        "turn",
        "episode",
        "evidence",
        "gap",
        "inference",
        "candidate",
        "review",
        "reference",
        "question_frame"
      ],
      "title": "ContextSourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Operation Name",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "context_policy_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Context Policy Name",
      "type": "string"
    },
    "context_policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Context Policy Version",
      "type": "string"
    },
    "context_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Policy Hash",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "reference_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Snapshot Hash"
    },
    "section_order": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Section Order",
      "type": "array"
    },
    "schema_version": {
      "const": "context_selection_manifest.v2",
      "default": "context_selection_manifest.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ContextItemDecision"
      },
      "title": "Decisions",
      "type": "array"
    }
  },
  "required": [
    "operation_name",
    "operation_definition_hash",
    "context_policy_name",
    "context_policy_version",
    "context_policy_hash",
    "session_id",
    "turn_id",
    "operation_id",
    "state_hash",
    "state_version",
    "section_order",
    "decisions"
  ],
  "title": "Caliburn interview vNext context selection manifest v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/context-selection-manifest.v2.schema.json"
}
