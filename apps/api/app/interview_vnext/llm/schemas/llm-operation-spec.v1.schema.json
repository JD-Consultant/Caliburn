{
  "$defs": {
    "ContractIdentity": {
      "additionalProperties": false,
      "description": "Stable identity for a schema, prompt, or context policy artifact.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "content_hash"
      ],
      "title": "ContractIdentity",
      "type": "object"
    },
    "RepairPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_repair_attempts": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Schema Repair Attempts",
          "type": "integer"
        },
        "semantic_repair_attempts": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic Repair Attempts",
          "type": "integer"
        }
      },
      "title": "RepairPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash-addressed operation definition used by inference and Capture.",
  "properties": {
    "schema_version": {
      "const": "llm_operation_definition.v1",
      "default": "llm_operation_definition.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "input_contract": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "output_contract": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "prompt_template": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "context_policy": {
      "$ref": "#/$defs/ContractIdentity"
    },
    "quality_profile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Quality Profile",
      "type": "string"
    },
    "timeout_ms": {
      "maximum": 900000,
      "minimum": 1,
      "title": "Timeout Ms",
      "type": "integer"
    },
    "max_attempts": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_output_tokens": {
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "allowed_tools": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "repair_policy": {
      "$ref": "#/$defs/RepairPolicy",
      "default": {
        "schema_repair_attempts": 0,
        "semantic_repair_attempts": 0
      }
    },
    "safety_policy_flags": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Safety Policy Flags",
      "type": "array"
    },
    "definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Definition Hash",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "input_contract",
    "output_contract",
    "prompt_template",
    "context_policy",
    "quality_profile",
    "timeout_ms",
    "max_output_tokens",
    "definition_hash"
  ],
  "title": "Caliburn interview vNext LLM operation specification v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/llm-operation-spec.v1.schema.json"
}
