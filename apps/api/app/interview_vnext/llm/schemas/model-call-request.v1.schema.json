{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Portable pointer that always carries the content integrity fields.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "content_hash",
        "byte_size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MessageRole": {
      "enum": [
        "user",
        "assistant"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "ModelMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ModelMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "model_call_request.v1",
      "default": "model_call_request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Operation Name",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Provider",
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "title": "Requested Model",
      "type": "string"
    },
    "quality_profile": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Quality Profile",
      "type": "string"
    },
    "instructions": {
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ModelMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "prompt_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "output_schema_id": {
      "minLength": 1,
      "title": "Output Schema Id",
      "type": "string"
    },
    "output_schema_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "context_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "selection_manifest_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "max_output_tokens": {
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "session_id",
    "operation_id",
    "attempt_id",
    "attempt",
    "operation_name",
    "operation_definition_hash",
    "idempotency_key",
    "provider",
    "requested_model",
    "quality_profile",
    "instructions",
    "messages",
    "prompt_artifact",
    "output_schema_id",
    "output_schema_artifact",
    "context_artifact",
    "selection_manifest_artifact",
    "deadline_at",
    "created_at",
    "max_output_tokens"
  ],
  "title": "Caliburn interview vNext provider-neutral model request v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/model-call-request.v1.schema.json"
}
