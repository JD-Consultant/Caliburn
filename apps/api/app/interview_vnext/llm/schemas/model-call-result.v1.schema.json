{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Portable pointer that always carries the content integrity fields.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "content_hash",
        "byte_size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "transport_timeout",
        "transport_error",
        "rate_limited",
        "authentication_failed",
        "invalid_request",
        "provider_unavailable",
        "cancelled",
        "output_schema_invalid",
        "output_parse_failed",
        "resolved_model_mismatch",
        "unknown_provider_failure"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "FinishReason": {
      "enum": [
        "completed",
        "max_output_tokens",
        "context_window_exceeded",
        "stop_sequence",
        "tool_use",
        "paused",
        "safety_refusal",
        "cancelled",
        "provider_error",
        "unknown"
      ],
      "title": "FinishReason",
      "type": "string"
    },
    "ModelFailure": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/FailureKind"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Reason Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "minLength": 1,
          "title": "Safe Message",
          "type": "string"
        },
        "provider_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Error Code"
        },
        "error_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "reason_code",
        "retryable",
        "safe_message"
      ],
      "title": "ModelFailure",
      "type": "object"
    },
    "ModelOutcome": {
      "enum": [
        "succeeded",
        "refused",
        "incomplete",
        "failed"
      ],
      "title": "ModelOutcome",
      "type": "string"
    },
    "ModelRefusal": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Reason Code",
          "type": "string"
        },
        "safe_message": {
          "minLength": 1,
          "title": "Safe Message",
          "type": "string"
        },
        "provider_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Category"
        }
      },
      "required": [
        "reason_code",
        "safe_message"
      ],
      "title": "ModelRefusal",
      "type": "object"
    },
    "StructuredPayload": {
      "additionalProperties": false,
      "description": "Immutable canonical JSON returned after provider-level schema validation.",
      "properties": {
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "canonical_json": {
          "minLength": 1,
          "title": "Canonical Json",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "canonical_json",
        "content_hash"
      ],
      "title": "StructuredPayload",
      "type": "object"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "model_call_result.v1",
      "default": "model_call_result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Operation Name",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Provider",
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "title": "Requested Model",
      "type": "string"
    },
    "resolved_model": {
      "minLength": 1,
      "title": "Resolved Model",
      "type": "string"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "provider_conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Conversation Id"
    },
    "outcome": {
      "$ref": "#/$defs/ModelOutcome"
    },
    "finish_reason": {
      "$ref": "#/$defs/FinishReason"
    },
    "provider_finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Finish Reason"
    },
    "parsed_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "visible_response_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRefusal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "output_schema_id": {
      "minLength": 1,
      "title": "Output Schema Id",
      "type": "string"
    },
    "output_schema_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Schema Hash",
      "type": "string"
    },
    "context_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Hash",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "session_id",
    "operation_id",
    "attempt_id",
    "attempt",
    "operation_name",
    "operation_definition_hash",
    "provider",
    "requested_model",
    "resolved_model",
    "outcome",
    "finish_reason",
    "usage",
    "latency_ms",
    "started_at",
    "completed_at",
    "prompt_hash",
    "output_schema_id",
    "output_schema_hash",
    "context_hash"
  ],
  "title": "Caliburn interview vNext provider-neutral model result v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/model-call-result.v1.schema.json"
}
