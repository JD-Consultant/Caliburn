{
  "$defs": {
    "AnswerBindingKind": {
      "enum": [
        "proposition",
        "slot",
        "choice"
      ],
      "title": "AnswerBindingKind",
      "type": "string"
    },
    "AnswerBindingProposal": {
      "additionalProperties": false,
      "description": "A short answer bound to one QuestionFrame target.\n\nDeliberately flat rather than a discriminated union: a provider-portable\nschema projection must not have to reproduce union branches (§9.3).",
      "properties": {
        "target_ordinal": {
          "title": "Target Ordinal",
          "type": "integer"
        },
        "binding_kind": {
          "$ref": "#/$defs/AnswerBindingKind"
        },
        "resolution": {
          "$ref": "#/$defs/AnswerBindingResolution"
        },
        "answer_quote": {
          "title": "Answer Quote",
          "type": "string"
        },
        "answer_quote_occurrence": {
          "title": "Answer Quote Occurrence",
          "type": "integer"
        },
        "value_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Text"
        },
        "selected_choice_ordinals": {
          "items": {
            "type": "integer"
          },
          "title": "Selected Choice Ordinals",
          "type": "array"
        },
        "insufficiency_codes": {
          "items": {
            "$ref": "#/$defs/TurnInsufficiencyCode"
          },
          "title": "Insufficiency Codes",
          "type": "array"
        }
      },
      "required": [
        "target_ordinal",
        "binding_kind",
        "resolution",
        "answer_quote",
        "answer_quote_occurrence",
        "value_text",
        "selected_choice_ordinals",
        "insufficiency_codes"
      ],
      "title": "AnswerBindingProposal",
      "type": "object"
    },
    "AnswerBindingResolution": {
      "enum": [
        "affirmed",
        "denied",
        "supplied",
        "selected",
        "ambiguous",
        "unknown"
      ],
      "title": "AnswerBindingResolution",
      "type": "string"
    },
    "CorrectionProposal": {
      "additionalProperties": false,
      "properties": {
        "target_candidate_ordinals": {
          "items": {
            "type": "integer"
          },
          "title": "Target Candidate Ordinals",
          "type": "array"
        },
        "target_unknown": {
          "title": "Target Unknown",
          "type": "boolean"
        }
      },
      "title": "CorrectionProposal",
      "type": "object",
      "required": [
        "target_candidate_ordinals",
        "target_unknown"
      ]
    },
    "DialogueAct": {
      "enum": [
        "standalone_answer",
        "affirm",
        "deny",
        "slot_value",
        "choose",
        "correction",
        "dont_know",
        "decline",
        "stop",
        "off_topic",
        "mixed"
      ],
      "title": "DialogueAct",
      "type": "string"
    },
    "EmergentTopicProposal": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_occurrence": {
          "title": "Quote Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "topic",
        "quote",
        "quote_occurrence"
      ],
      "title": "EmergentTopicProposal",
      "type": "object"
    },
    "EpisodeSignal": {
      "enum": [
        "continue",
        "possible_shift",
        "explicit_shift",
        "possible_close"
      ],
      "title": "EpisodeSignal",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiersProposal": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope"
        },
        "time_scope_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Scope Support"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality"
        },
        "typicality_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Typicality Support"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity"
        },
        "polarity_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Polarity Support"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifierProposal"
        },
        "importance": {
          "$ref": "#/$defs/Importance"
        },
        "importance_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Importance Support"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "ownership_support": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ownership Support"
        }
      },
      "required": [
        "time_scope",
        "time_scope_support",
        "typicality",
        "typicality_support",
        "polarity",
        "polarity_support",
        "frequency",
        "importance",
        "importance_support",
        "ownership",
        "ownership_support"
      ],
      "title": "EvidenceQualifiersProposal",
      "type": "object"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifierProposal": {
      "additionalProperties": false,
      "description": "Provider-facing frequency with decimal text preserved losslessly.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verbatim"
        }
      },
      "required": [
        "value",
        "unit",
        "verbatim"
      ],
      "title": "FrequencyQualifierProposal",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "ObservationProposal": {
      "additionalProperties": false,
      "description": "A claim the employee stated literally in this turn.\n\nIdentity is the proposal's original position in the output tuple — the model\nnever names an Evidence ID or a proposal key (amendment plan §9.2).",
      "properties": {
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_occurrence": {
          "title": "Quote Occurrence",
          "type": "integer"
        },
        "qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiersProposal"
        },
        "correction": {
          "$ref": "#/$defs/CorrectionProposal"
        },
        "insufficiency_codes": {
          "items": {
            "$ref": "#/$defs/TurnInsufficiencyCode"
          },
          "title": "Insufficiency Codes",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "kind",
        "claim",
        "quote",
        "quote_occurrence",
        "qualifiers",
        "correction",
        "insufficiency_codes"
      ],
      "title": "ObservationProposal",
      "type": "object"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "TurnInsufficiencyCode": {
      "enum": [
        "ambiguous_frequency",
        "ambiguous_ownership",
        "ambiguous_subject",
        "ambiguous_time_scope",
        "contradiction_unresolved",
        "correction_target_unknown",
        "insufficient_detail",
        "no_work_fact",
        "answer_binding_ambiguous",
        "question_frame_missing",
        "question_frame_stale",
        "question_frame_not_immediate",
        "choice_selection_ambiguous"
      ],
      "title": "TurnInsufficiencyCode",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "turn_interpret_output.v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "dialogue_act": {
      "$ref": "#/$defs/DialogueAct"
    },
    "episode_signal": {
      "$ref": "#/$defs/EpisodeSignal"
    },
    "literal_observations": {
      "items": {
        "$ref": "#/$defs/ObservationProposal"
      },
      "title": "Literal Observations",
      "type": "array"
    },
    "answer_bindings": {
      "items": {
        "$ref": "#/$defs/AnswerBindingProposal"
      },
      "title": "Answer Bindings",
      "type": "array"
    },
    "emergent_topics": {
      "items": {
        "$ref": "#/$defs/EmergentTopicProposal"
      },
      "title": "Emergent Topics",
      "type": "array"
    },
    "turn_insufficiency_codes": {
      "items": {
        "$ref": "#/$defs/TurnInsufficiencyCode"
      },
      "title": "Turn Insufficiency Codes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dialogue_act",
    "episode_signal",
    "literal_observations",
    "answer_bindings",
    "emergent_topics",
    "turn_insufficiency_codes"
  ],
  "title": "Caliburn interview vNext portable turn interpretation output v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-interpret-output.v2.schema.json"
}
