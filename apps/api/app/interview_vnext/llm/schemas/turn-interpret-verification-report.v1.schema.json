{
  "$defs": {
    "EmergentTopicProposal": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_occurrence": {
          "title": "Quote Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "topic",
        "quote",
        "quote_occurrence"
      ],
      "title": "EmergentTopicProposal",
      "type": "object"
    },
    "EmergentTopicVerification": {
      "additionalProperties": false,
      "properties": {
        "topic_index": {
          "title": "Topic Index",
          "type": "integer"
        },
        "proposal": {
          "$ref": "#/$defs/EmergentTopicProposal"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/TurnInterpretRejectCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "computed_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "topic_index",
        "proposal",
        "accepted",
        "reason_codes",
        "computed_span"
      ],
      "title": "EmergentTopicVerification",
      "type": "object"
    },
    "EpisodeSignal": {
      "enum": [
        "continue",
        "possible_shift",
        "explicit_shift",
        "possible_close"
      ],
      "title": "EpisodeSignal",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "evidence.v2",
          "default": "evidence.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/QuoteSpan"
        },
        "quote_match": {
          "$ref": "#/$defs/QuoteMatch",
          "default": "exact"
        },
        "normalization_version": {
          "anyOf": [
            {
              "const": "quote_nfkc_ws.v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Version"
        },
        "qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiers"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "active"
        },
        "supersedes": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "superseded_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "withdrawn_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Withdrawn Reason"
        },
        "withdrawn_by_turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Withdrawn By Turn Id"
        },
        "correction_target_unknown": {
          "default": false,
          "title": "Correction Target Unknown",
          "type": "boolean"
        },
        "extractor_operation_id": {
          "format": "uuid",
          "title": "Extractor Operation Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "session_id",
        "turn_id",
        "subject",
        "kind",
        "claim",
        "quote",
        "span",
        "extractor_operation_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiers": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope",
          "default": "unknown"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality",
          "default": "unknown"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity",
          "default": "uncertain"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifier"
        },
        "importance": {
          "$ref": "#/$defs/Importance",
          "default": "not_stated"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership",
          "default": "unknown"
        }
      },
      "title": "EvidenceQualifiers",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit",
          "default": "unknown"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verbatim"
        }
      },
      "title": "FrequencyQualifier",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "InsufficiencyProposal": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "$ref": "#/$defs/InsufficiencyReason"
        },
        "observation_proposal_keys": {
          "items": {
            "type": "string"
          },
          "title": "Observation Proposal Keys",
          "type": "array"
        }
      },
      "required": [
        "reason_code",
        "observation_proposal_keys"
      ],
      "title": "InsufficiencyProposal",
      "type": "object"
    },
    "InsufficiencyReason": {
      "enum": [
        "ambiguous_frequency",
        "ambiguous_ownership",
        "ambiguous_subject",
        "ambiguous_time_scope",
        "contradiction_unresolved",
        "correction_target_unknown",
        "insufficient_detail",
        "no_work_fact"
      ],
      "title": "InsufficiencyReason",
      "type": "string"
    },
    "ObservationVerification": {
      "additionalProperties": false,
      "properties": {
        "proposal_index": {
          "title": "Proposal Index",
          "type": "integer"
        },
        "proposal_key": {
          "title": "Proposal Key",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/TurnInterpretRejectCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "computed_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposal_index",
        "proposal_key",
        "accepted",
        "reason_codes",
        "computed_span",
        "evidence"
      ],
      "title": "ObservationVerification",
      "type": "object"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "QuoteMatch": {
      "enum": [
        "exact",
        "normalized"
      ],
      "title": "QuoteMatch",
      "type": "string"
    },
    "QuoteSpan": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "QuoteSpan",
      "type": "object"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "TurnInterpretRejectCode": {
      "enum": [
        "duplicate_proposal_key",
        "quote_not_found",
        "quote_occurrence_out_of_range",
        "invalid_qualifier",
        "foreign_correction_target",
        "inactive_correction_target",
        "incoherent_correction",
        "unsupported_quantification",
        "reference_leakage",
        "non_atomic_claim",
        "domain_invariant_failed"
      ],
      "title": "TurnInterpretRejectCode",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    },
    "UserSignal": {
      "enum": [
        "answer",
        "clarification",
        "correction",
        "dont_know",
        "decline",
        "stop",
        "off_topic",
        "mixed"
      ],
      "title": "UserSignal",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "turn_interpret_verification_report.v1",
      "default": "turn_interpret_verification_report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "verifier_policy_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Verifier Policy Name",
      "type": "string"
    },
    "verifier_policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Verifier Policy Version",
      "type": "string"
    },
    "verifier_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Verifier Policy Hash",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "context_packet_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Packet Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "user_signal": {
      "$ref": "#/$defs/UserSignal"
    },
    "episode_signal": {
      "$ref": "#/$defs/EpisodeSignal"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ObservationVerification"
      },
      "title": "Decisions",
      "type": "array"
    },
    "accepted_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Accepted Evidence Ids",
      "type": "array"
    },
    "emergent_topic_decisions": {
      "items": {
        "$ref": "#/$defs/EmergentTopicVerification"
      },
      "title": "Emergent Topic Decisions",
      "type": "array"
    },
    "insufficiencies": {
      "items": {
        "$ref": "#/$defs/InsufficiencyProposal"
      },
      "title": "Insufficiencies",
      "type": "array"
    },
    "accepted_count": {
      "title": "Accepted Count",
      "type": "integer"
    },
    "dropped_count": {
      "title": "Dropped Count",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "operation_definition_hash",
    "verifier_policy_name",
    "verifier_policy_version",
    "verifier_policy_hash",
    "session_id",
    "turn_id",
    "context_packet_hash",
    "output_hash",
    "user_signal",
    "episode_signal",
    "decisions",
    "accepted_evidence_ids",
    "emergent_topic_decisions",
    "insufficiencies",
    "accepted_count",
    "dropped_count"
  ],
  "title": "Caliburn interview vNext turn interpretation verification report v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-interpret-verification-report.v1.schema.json"
}
