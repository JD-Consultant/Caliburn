{
  "$defs": {
    "AnswerBindingVerification": {
      "additionalProperties": false,
      "description": "One binding's decision plus every Evidence it materialized.\n\nA choice binding can materialize several Evidence (one per selected option),\nand an ambiguous binding legitimately materializes none while still being a\nsemantic success (plan §11.3).",
      "properties": {
        "binding_index": {
          "minimum": 1,
          "title": "Binding Index",
          "type": "integer"
        },
        "binding_ref": {
          "title": "Binding Ref",
          "type": "string"
        },
        "candidate_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Candidate Evidence Ids",
          "type": "array"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/TurnInterpretRejectCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "computed_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "materialized_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Materialized Evidence",
          "type": "array"
        }
      },
      "required": [
        "binding_index",
        "binding_ref",
        "accepted",
        "reason_codes",
        "computed_span"
      ],
      "title": "AnswerBindingVerification",
      "type": "object"
    },
    "ContextualAnswerSupport": {
      "additionalProperties": false,
      "properties": {
        "support_kind": {
          "const": "contextual_answer",
          "default": "contextual_answer",
          "title": "Support Kind",
          "type": "string"
        },
        "employee_turn_id": {
          "format": "uuid",
          "title": "Employee Turn Id",
          "type": "string"
        },
        "answer_quote": {
          "minLength": 1,
          "title": "Answer Quote",
          "type": "string"
        },
        "answer_span": {
          "$ref": "#/$defs/QuoteSpan"
        },
        "question_frame_id": {
          "format": "uuid",
          "title": "Question Frame Id",
          "type": "string"
        },
        "question_frame_definition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Question Frame Definition Hash",
          "type": "string"
        },
        "target_ordinal": {
          "minimum": 1,
          "title": "Target Ordinal",
          "type": "integer"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Hash",
          "type": "string"
        },
        "binding_kind": {
          "$ref": "#/$defs/ContextualBindingKind"
        },
        "resolution": {
          "$ref": "#/$defs/ContextualResolution"
        },
        "value_text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Text"
        },
        "choice_option_ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choice Option Ordinal"
        }
      },
      "required": [
        "employee_turn_id",
        "answer_quote",
        "answer_span",
        "question_frame_id",
        "question_frame_definition_hash",
        "target_ordinal",
        "target_hash",
        "binding_kind",
        "resolution"
      ],
      "title": "ContextualAnswerSupport",
      "type": "object"
    },
    "ContextualBindingKind": {
      "enum": [
        "affirmation",
        "denial",
        "slot_value",
        "choice_selection"
      ],
      "title": "ContextualBindingKind",
      "type": "string"
    },
    "ContextualResolution": {
      "enum": [
        "affirmed",
        "denied",
        "supplied",
        "selected"
      ],
      "title": "ContextualResolution",
      "type": "string"
    },
    "DialogueAct": {
      "enum": [
        "standalone_answer",
        "affirm",
        "deny",
        "slot_value",
        "choose",
        "correction",
        "dont_know",
        "decline",
        "stop",
        "off_topic",
        "mixed"
      ],
      "title": "DialogueAct",
      "type": "string"
    },
    "EmergentTopicProposal": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_occurrence": {
          "minimum": 1,
          "title": "Quote Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "topic",
        "quote",
        "quote_occurrence"
      ],
      "title": "EmergentTopicProposal",
      "type": "object"
    },
    "EmergentTopicVerification": {
      "additionalProperties": false,
      "properties": {
        "topic_index": {
          "minimum": 1,
          "title": "Topic Index",
          "type": "integer"
        },
        "proposal": {
          "$ref": "#/$defs/EmergentTopicProposal"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/TurnInterpretRejectCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "computed_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "topic_index",
        "proposal",
        "accepted",
        "reason_codes",
        "computed_span"
      ],
      "title": "EmergentTopicVerification",
      "type": "object"
    },
    "EpisodeSignal": {
      "enum": [
        "continue",
        "possible_shift",
        "explicit_shift",
        "possible_close"
      ],
      "title": "EpisodeSignal",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "evidence.v3",
          "default": "evidence.v3",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "episode_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "support": {
          "discriminator": {
            "mapping": {
              "contextual_answer": "#/$defs/ContextualAnswerSupport",
              "literal_employee_span": "#/$defs/LiteralEmployeeSpanSupport"
            },
            "propertyName": "support_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LiteralEmployeeSpanSupport"
            },
            {
              "$ref": "#/$defs/ContextualAnswerSupport"
            }
          ],
          "title": "Support"
        },
        "qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiers"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus",
          "default": "active"
        },
        "supersedes": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "superseded_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "withdrawn_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Withdrawn Reason"
        },
        "withdrawn_by_turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Withdrawn By Turn Id"
        },
        "correction_target_unknown": {
          "default": false,
          "title": "Correction Target Unknown",
          "type": "boolean"
        },
        "extractor_operation_id": {
          "format": "uuid",
          "title": "Extractor Operation Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "session_id",
        "subject",
        "kind",
        "claim",
        "support",
        "extractor_operation_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiers": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope",
          "default": "unknown"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality",
          "default": "unknown"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity",
          "default": "uncertain"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifier"
        },
        "importance": {
          "$ref": "#/$defs/Importance",
          "default": "not_stated"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership",
          "default": "unknown"
        }
      },
      "title": "EvidenceQualifiers",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit",
          "default": "unknown"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verbatim"
        }
      },
      "title": "FrequencyQualifier",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "LiteralEmployeeSpanSupport": {
      "additionalProperties": false,
      "properties": {
        "support_kind": {
          "const": "literal_employee_span",
          "default": "literal_employee_span",
          "title": "Support Kind",
          "type": "string"
        },
        "employee_turn_id": {
          "format": "uuid",
          "title": "Employee Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/QuoteSpan"
        },
        "quote_match": {
          "$ref": "#/$defs/QuoteMatch",
          "default": "exact"
        },
        "normalization_version": {
          "anyOf": [
            {
              "const": "quote_nfkc_ws.v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Version"
        }
      },
      "required": [
        "employee_turn_id",
        "quote",
        "span"
      ],
      "title": "LiteralEmployeeSpanSupport",
      "type": "object"
    },
    "ObservationVerification": {
      "additionalProperties": false,
      "description": "One literal observation's decision plus its pre-derived identity.\n\n``candidate_evidence_id`` is derived from the proposal's original position and\nkept whether or not the proposal is accepted, so a rejected neighbour never\nrenumbers the survivors (amendment §10.1). When accepted it is exactly the\nmaterialized Evidence's id.",
      "properties": {
        "proposal_index": {
          "minimum": 1,
          "title": "Proposal Index",
          "type": "integer"
        },
        "proposal_ref": {
          "title": "Proposal Ref",
          "type": "string"
        },
        "candidate_evidence_id": {
          "format": "uuid",
          "title": "Candidate Evidence Id",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/TurnInterpretRejectCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "computed_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proposal_index",
        "proposal_ref",
        "candidate_evidence_id",
        "accepted",
        "reason_codes",
        "computed_span",
        "evidence"
      ],
      "title": "ObservationVerification",
      "type": "object"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "QuoteMatch": {
      "enum": [
        "exact",
        "normalized"
      ],
      "title": "QuoteMatch",
      "type": "string"
    },
    "QuoteSpan": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "QuoteSpan",
      "type": "object"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "TurnInsufficiencyCode": {
      "enum": [
        "ambiguous_frequency",
        "ambiguous_ownership",
        "ambiguous_subject",
        "ambiguous_time_scope",
        "contradiction_unresolved",
        "correction_target_unknown",
        "insufficient_detail",
        "no_work_fact",
        "answer_binding_ambiguous",
        "question_frame_missing",
        "question_frame_stale",
        "question_frame_not_immediate",
        "choice_selection_ambiguous"
      ],
      "title": "TurnInsufficiencyCode",
      "type": "string"
    },
    "TurnInterpretRejectCode": {
      "description": "Canonical reject vocabulary — two namespaces, one enum (amendment §10.3).\n\nDeclaration order *is* the verifier ``reject_order``: literal-observation\ncodes first (roughly the amendment §10.2 gate order), then answer-binding\ncodes. A literal decision may only carry observation codes and a binding\ndecision only binding codes; the split is enforced per decision below. No WIP\naliases survive this atomic hard cut.",
      "enum": [
        "quote_not_found",
        "quote_occurrence_out_of_range",
        "invalid_qualifier",
        "qualifier_support_not_in_quote",
        "false_specific_qualifier",
        "foreign_correction_target",
        "inactive_correction_target",
        "incoherent_correction",
        "unsupported_quantification",
        "reference_leakage",
        "non_atomic_claim",
        "duplicate_observation",
        "insufficiency_incoherent",
        "domain_invariant_failed",
        "binding_without_question_frame",
        "binding_target_out_of_range",
        "binding_kind_mismatch",
        "binding_resolution_incoherent",
        "binding_quote_not_found",
        "binding_quote_occurrence_out_of_range",
        "binding_value_not_supported",
        "choice_selection_invalid",
        "duplicate_binding_target",
        "question_frame_not_eligible",
        "question_frame_hash_mismatch",
        "contextual_materialization_failed"
      ],
      "title": "TurnInterpretRejectCode",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "turn_interpret_verification_report.v2",
      "default": "turn_interpret_verification_report.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "verifier_policy_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Verifier Policy Name",
      "type": "string"
    },
    "verifier_policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Verifier Policy Version",
      "type": "string"
    },
    "verifier_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Verifier Policy Hash",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "question_frame_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Frame Id"
    },
    "context_packet_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Packet Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "dialogue_act": {
      "$ref": "#/$defs/DialogueAct"
    },
    "episode_signal": {
      "$ref": "#/$defs/EpisodeSignal"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObservationVerification"
      },
      "title": "Decisions",
      "type": "array"
    },
    "binding_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AnswerBindingVerification"
      },
      "title": "Binding Decisions",
      "type": "array"
    },
    "accepted_evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Accepted Evidence Ids",
      "type": "array"
    },
    "emergent_topic_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EmergentTopicVerification"
      },
      "title": "Emergent Topic Decisions",
      "type": "array"
    },
    "model_insufficiency_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TurnInsufficiencyCode"
      },
      "title": "Model Insufficiency Codes",
      "type": "array"
    },
    "system_insufficiency_codes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TurnInsufficiencyCode"
      },
      "title": "System Insufficiency Codes",
      "type": "array"
    },
    "accepted_count": {
      "minimum": 0,
      "title": "Accepted Count",
      "type": "integer"
    },
    "dropped_count": {
      "minimum": 0,
      "title": "Dropped Count",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "operation_definition_hash",
    "verifier_policy_name",
    "verifier_policy_version",
    "verifier_policy_hash",
    "session_id",
    "turn_id",
    "context_packet_hash",
    "output_hash",
    "dialogue_act",
    "episode_signal",
    "accepted_count",
    "dropped_count"
  ],
  "title": "Caliburn interview vNext turn interpretation verification report v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-interpret-verification-report.v2.schema.json"
}
