{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Portable pointer that always carries the content integrity fields.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Id"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type",
        "content_hash",
        "byte_size"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactStorage": {
      "enum": [
        "inline",
        "external"
      ],
      "title": "ArtifactStorage",
      "type": "string"
    },
    "RedactionStatus": {
      "enum": [
        "not_required",
        "applied",
        "unknown"
      ],
      "title": "RedactionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable artifact metadata plus exactly one storage location.",
  "properties": {
    "schema_version": {
      "const": "execution_artifact.v1",
      "default": "execution_artifact.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "attempt_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "storage": {
      "$ref": "#/$defs/ArtifactStorage"
    },
    "inline_content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inline Content"
    },
    "external_uri": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Uri"
    },
    "retention_class": {
      "default": "standard",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Retention Class",
      "type": "string"
    },
    "redaction_status": {
      "$ref": "#/$defs/RedactionStatus",
      "default": "unknown"
    },
    "contains_test_data": {
      "default": false,
      "title": "Contains Test Data",
      "type": "boolean"
    }
  },
  "required": [
    "ref",
    "run_id",
    "created_at",
    "storage"
  ],
  "title": "Caliburn interview vNext immutable execution artifact v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/execution-artifact.v1.schema.json"
}
