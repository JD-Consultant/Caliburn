{
  "$defs": {
    "Enabler": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EnablerKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Enabler",
      "type": "object"
    },
    "EnablerKind": {
      "enum": [
        "tool_system",
        "method",
        "knowledge",
        "skill",
        "other"
      ],
      "title": "EnablerKind",
      "type": "string"
    },
    "ExcludePayload": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/ExclusionReason"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "summary"
      ],
      "title": "ExcludePayload",
      "type": "object"
    },
    "ExclusionReason": {
      "enum": [
        "他人工作",
        "過去工作",
        "一次性支援",
        "工具或步驟",
        "員工否認"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "IdentityAssessment": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "$ref": "#/$defs/IdentityRelation"
        },
        "target_task_ordinals": {
          "items": {
            "type": "integer"
          },
          "title": "Target Task Ordinals",
          "type": "array"
        }
      },
      "required": [
        "relation",
        "target_task_ordinals"
      ],
      "title": "IdentityAssessment",
      "type": "object"
    },
    "IdentityRelation": {
      "enum": [
        "no_match",
        "duplicate",
        "overlap",
        "uncertain"
      ],
      "title": "IdentityRelation",
      "type": "string"
    },
    "NextQuestion": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextQuestionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text",
        "purpose",
        "target"
      ],
      "title": "NextQuestion",
      "type": "object"
    },
    "NextQuestionTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/NextQuestionTargetKind"
        },
        "ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ordinal"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index"
        }
      },
      "required": [
        "kind",
        "ordinal",
        "index"
      ],
      "title": "NextQuestionTarget",
      "type": "object"
    },
    "NextQuestionTargetKind": {
      "enum": [
        "existing_open_issue",
        "new_signal"
      ],
      "title": "NextQuestionTargetKind",
      "type": "string"
    },
    "OpenIssueKind": {
      "enum": [
        "責任邊界不明",
        "證據不足",
        "矛盾未解",
        "task_boundary_uncertain"
      ],
      "title": "OpenIssueKind",
      "type": "string"
    },
    "OpenIssuePayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/OpenIssueKind"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "OpenIssuePayload",
      "type": "object"
    },
    "SignalAnchor": {
      "additionalProperties": false,
      "description": "指向 packet 中某個回合的逐字引用;application 再把 ordinal 解成 SourceRef。",
      "properties": {
        "turn_ordinal": {
          "title": "Turn Ordinal",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "turn_ordinal",
        "quote"
      ],
      "title": "SignalAnchor",
      "type": "object"
    },
    "SignalDisposition": {
      "enum": [
        "task_change",
        "support_only",
        "exclude",
        "open_issue"
      ],
      "title": "SignalDisposition",
      "type": "string"
    },
    "SupportOrdinalRef": {
      "additionalProperties": false,
      "description": "指認被本次更正取代的既有依據(§12.3 末段:這是 `TI-R1-08` 的唯一支撐)。",
      "properties": {
        "task_ordinal": {
          "title": "Task Ordinal",
          "type": "integer"
        },
        "support_ordinal": {
          "title": "Support Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "task_ordinal",
        "support_ordinal"
      ],
      "title": "SupportOrdinalRef",
      "type": "object"
    },
    "TaskChangeKind": {
      "enum": [
        "add",
        "revise",
        "withdraw",
        "merge",
        "split"
      ],
      "title": "TaskChangeKind",
      "type": "string"
    },
    "TaskChangePayload": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/TaskChangeKind"
        },
        "target_task_ordinals": {
          "items": {
            "type": "integer"
          },
          "title": "Target Task Ordinals",
          "type": "array"
        },
        "task_fields": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskFields"
            },
            {
              "type": "null"
            }
          ]
        },
        "split_children": {
          "items": {
            "$ref": "#/$defs/TaskFields"
          },
          "title": "Split Children",
          "type": "array"
        }
      },
      "required": [
        "change",
        "target_task_ordinals",
        "task_fields",
        "split_children"
      ],
      "title": "TaskChangePayload",
      "type": "object"
    },
    "TaskFields": {
      "additionalProperties": false,
      "description": "Task 的語意欄位子集。\n\n這一組就是 §12.1 的 ``task_fields``(模型可提出的欄位)與 §10.4 staged 新 Task 的\n語意欄位;`Task` 繼承它,讓三處共用同一份欄位權威,而不是各抄一份。",
      "properties": {
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "object": {
          "title": "Object",
          "type": "string"
        },
        "purpose_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Purpose Result"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context"
        },
        "deliverable_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deliverable Hint"
        },
        "success_criterion_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Success Criterion Hint"
        },
        "enablers": {
          "items": {
            "$ref": "#/$defs/Enabler"
          },
          "title": "Enablers",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "action",
        "object",
        "purpose_result",
        "context",
        "deliverable_hint",
        "success_criterion_hint",
        "enablers"
      ],
      "title": "TaskFields",
      "type": "object"
    },
    "WorkSignal": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/SignalAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/IdentityAssessment"
        },
        "supersedes_support_ordinals": {
          "items": {
            "$ref": "#/$defs/SupportOrdinalRef"
          },
          "title": "Supersedes Support Ordinals",
          "type": "array"
        },
        "disposition": {
          "$ref": "#/$defs/SignalDisposition"
        },
        "task_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskChangePayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExcludePayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "open_issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenIssuePayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "anchors",
        "identity",
        "supersedes_support_ordinals",
        "disposition",
        "task_change",
        "exclude",
        "open_issue"
      ],
      "title": "WorkSignal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "work_signals": {
      "items": {
        "$ref": "#/$defs/WorkSignal"
      },
      "title": "Work Signals",
      "type": "array"
    },
    "next_question": {
      "$ref": "#/$defs/NextQuestion"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "work_signals",
    "next_question",
    "limitations"
  ],
  "title": "TaskAnalysisResult",
  "type": "object"
}
