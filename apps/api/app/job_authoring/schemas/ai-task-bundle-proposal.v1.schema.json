{
  "$defs": {
    "EvidenceBasisRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_hash"
      ],
      "title": "EvidenceBasisRef",
      "type": "object"
    },
    "ProposedJobOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "format": "uuid",
          "title": "Output Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_basis": {
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "minItems": 1,
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "output_id",
        "statement",
        "evidence_basis"
      ],
      "title": "ProposedJobOutput",
      "type": "object"
    },
    "ProposedJobTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/ProposedJobOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "evidence_basis": {
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "minItems": 1,
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "statement",
        "outputs",
        "evidence_basis"
      ],
      "title": "ProposedJobTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ai_task_bundle_proposal.v1",
      "default": "ai_task_bundle_proposal.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "base_revision_id": {
      "format": "uuid",
      "title": "Base Revision Id",
      "type": "string"
    },
    "base_revision_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Revision Hash",
      "type": "string"
    },
    "evidence_state_version": {
      "minimum": 0,
      "title": "Evidence State Version",
      "type": "integer"
    },
    "evidence_state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence State Hash",
      "type": "string"
    },
    "operation": {
      "const": "add_task",
      "title": "Operation",
      "type": "string"
    },
    "proposed_task": {
      "$ref": "#/$defs/ProposedJobTask"
    },
    "plain_language_reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Plain Language Reason",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "source_kind": {
      "enum": [
        "scripted",
        "llm_operation"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "session_id",
    "document_id",
    "base_revision_id",
    "base_revision_hash",
    "evidence_state_version",
    "evidence_state_hash",
    "operation",
    "proposed_task",
    "plain_language_reason",
    "limitations",
    "source_kind",
    "source_id",
    "created_at"
  ],
  "title": "Caliburn job authoring AI task bundle proposal v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/ai-task-bundle-proposal.v1.schema.json"
}
