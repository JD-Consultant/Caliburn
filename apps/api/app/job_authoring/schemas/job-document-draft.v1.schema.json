{
  "$defs": {
    "EvidenceBasisRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_hash"
      ],
      "title": "EvidenceBasisRef",
      "type": "object"
    },
    "JobFieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "employee_document_edit",
            "accepted_ai_proposal",
            "employee_proposal_edit"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "evidence_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "source_kind",
        "source_id"
      ],
      "title": "JobFieldProvenance",
      "type": "object"
    },
    "JobOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "format": "uuid",
          "title": "Output Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "output_id",
        "statement",
        "provenance"
      ],
      "title": "JobOutput",
      "type": "object"
    },
    "JobTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "entity_version": {
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JobOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "task_id",
        "entity_version",
        "statement",
        "provenance"
      ],
      "title": "JobTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "job_document_draft.v1",
      "default": "job_document_draft.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "job_title": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Job Title",
      "type": "string"
    },
    "tasks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/JobTask"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "session_id",
    "job_title"
  ],
  "title": "Caliburn job authoring document draft v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/job-document-draft.v1.schema.json"
}
