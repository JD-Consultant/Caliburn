{
  "$defs": {
    "EvidenceBasisRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_hash"
      ],
      "title": "EvidenceBasisRef",
      "type": "object"
    },
    "JobDocumentDraft": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "job_document_draft.v1",
          "default": "job_document_draft.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "job_title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Job Title",
          "type": "string"
        },
        "tasks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JobTask"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "session_id",
        "job_title"
      ],
      "title": "JobDocumentDraft",
      "type": "object"
    },
    "JobFieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "employee_document_edit",
            "accepted_ai_proposal",
            "employee_proposal_edit"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "evidence_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "source_kind",
        "source_id"
      ],
      "title": "JobFieldProvenance",
      "type": "object"
    },
    "JobOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "format": "uuid",
          "title": "Output Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "output_id",
        "statement",
        "provenance"
      ],
      "title": "JobOutput",
      "type": "object"
    },
    "JobTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "entity_version": {
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JobOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "task_id",
        "entity_version",
        "statement",
        "provenance"
      ],
      "title": "JobTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "job_document_revision.v1",
      "default": "job_document_revision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "revision_number": {
      "minimum": 0,
      "title": "Revision Number",
      "type": "integer"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Revision Id"
    },
    "snapshot": {
      "$ref": "#/$defs/JobDocumentDraft"
    },
    "snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "initial",
        "employee_direct_edit",
        "ai_proposal_accept",
        "employee_proposal_edit"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "document_id",
    "revision_number",
    "parent_revision_id",
    "snapshot",
    "snapshot_hash",
    "source_kind",
    "command_id",
    "occurred_at"
  ],
  "title": "Caliburn job authoring document revision v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/job-document-revision.v1.schema.json"
}
