{
  "$defs": {
    "AiTaskBundleProposal": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ai_task_bundle_proposal.v1",
          "default": "ai_task_bundle_proposal.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "base_revision_id": {
          "format": "uuid",
          "title": "Base Revision Id",
          "type": "string"
        },
        "base_revision_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Revision Hash",
          "type": "string"
        },
        "evidence_state_version": {
          "minimum": 0,
          "title": "Evidence State Version",
          "type": "integer"
        },
        "evidence_state_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence State Hash",
          "type": "string"
        },
        "operation": {
          "const": "add_task",
          "title": "Operation",
          "type": "string"
        },
        "proposed_task": {
          "$ref": "#/$defs/ProposedJobTask"
        },
        "plain_language_reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Plain Language Reason",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "source_kind": {
          "enum": [
            "scripted",
            "llm_operation"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "session_id",
        "document_id",
        "base_revision_id",
        "base_revision_hash",
        "evidence_state_version",
        "evidence_state_hash",
        "operation",
        "proposed_task",
        "plain_language_reason",
        "limitations",
        "source_kind",
        "source_id",
        "created_at"
      ],
      "title": "AiTaskBundleProposal",
      "type": "object"
    },
    "EmployeeProposalDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "employee_proposal_decision.v1",
          "default": "employee_proposal_decision.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "accept",
            "edit",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "base_revision_id": {
          "format": "uuid",
          "title": "Base Revision Id",
          "type": "string"
        },
        "base_revision_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Revision Hash",
          "type": "string"
        },
        "final_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobTask"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Revision Id"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "proposal_id",
        "action",
        "base_revision_id",
        "base_revision_hash",
        "final_task",
        "result_revision_id",
        "decided_at"
      ],
      "title": "EmployeeProposalDecision",
      "type": "object"
    },
    "EvidenceBasisRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_hash"
      ],
      "title": "EvidenceBasisRef",
      "type": "object"
    },
    "JobFieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "employee_document_edit",
            "accepted_ai_proposal",
            "employee_proposal_edit"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "evidence_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "source_kind",
        "source_id"
      ],
      "title": "JobFieldProvenance",
      "type": "object"
    },
    "JobOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "format": "uuid",
          "title": "Output Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "output_id",
        "statement",
        "provenance"
      ],
      "title": "JobOutput",
      "type": "object"
    },
    "JobTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "entity_version": {
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JobOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/JobFieldProvenance"
        }
      },
      "required": [
        "task_id",
        "entity_version",
        "statement",
        "provenance"
      ],
      "title": "JobTask",
      "type": "object"
    },
    "ProposalStaleReason": {
      "enum": [
        "document_revision_advanced",
        "base_revision_changed",
        "evidence_basis_changed"
      ],
      "title": "ProposalStaleReason",
      "type": "string"
    },
    "ProposedJobOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "format": "uuid",
          "title": "Output Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_basis": {
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "minItems": 1,
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "output_id",
        "statement",
        "evidence_basis"
      ],
      "title": "ProposedJobOutput",
      "type": "object"
    },
    "ProposedJobTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/ProposedJobOutput"
          },
          "title": "Outputs",
          "type": "array"
        },
        "evidence_basis": {
          "items": {
            "$ref": "#/$defs/EvidenceBasisRef"
          },
          "minItems": 1,
          "title": "Evidence Basis",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "statement",
        "outputs",
        "evidence_basis"
      ],
      "title": "ProposedJobTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "task_proposal_view.v1",
      "default": "task_proposal_view.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "proposal": {
      "$ref": "#/$defs/AiTaskBundleProposal"
    },
    "status": {
      "enum": [
        "pending",
        "accepted",
        "edited",
        "rejected",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmployeeProposalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Revision Id"
    },
    "stale_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalStaleReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    }
  },
  "required": [
    "proposal",
    "status"
  ],
  "title": "Caliburn job authoring task proposal view v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/task-proposal-view.v1.schema.json"
}
