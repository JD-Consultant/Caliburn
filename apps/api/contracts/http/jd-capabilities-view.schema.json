{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JdCapabilitiesView",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision_id", "capabilities", "task_links"],
  "properties": {
    "revision_id": { "type": "string", "format": "uuid" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/Capability" }
    },
    "task_links": { "type": "array", "items": { "$ref": "#/$defs/TaskLink" } }
  },
  "$defs": {
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "kind", "name", "description"],
      "properties": {
        "capability_id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["knowledge", "skill"] },
        "name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "TaskLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "capability_id"],
      "properties": {
        "task_id": { "type": "string", "format": "uuid" },
        "capability_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
