{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JdSourcesView",
  "description": "Direct evidence belonging to one currently formal JD revision. Reading never confirms alignment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision_id", "references"],
  "properties": {
    "revision_id": {"type": "string", "format": "uuid"},
    "references": {"type": "array", "items": {"$ref": "#/$defs/Reference"}}
  },
  "$defs": {
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "target_label", "source_kind", "source_label", "needs_recheck", "jd_changed", "source_changed"],
      "properties": {
        "citation_id": {"type": "string", "format": "uuid"},
        "target_label": {"type": "string"},
        "target": {"$ref": "#/$defs/Target"},
        "source_kind": {"enum": ["interview", "work_situation", "work_understanding"]},
        "source_label": {"type": "string"},
        "needs_recheck": {"type": "boolean"},
        "jd_changed": {
          "type": "boolean",
          "description": "The JD target has been edited since review, including edits reverted to the reviewed text. Reading does not clear this flag."
        },
        "source_changed": {
          "type": "boolean",
          "description": "The fixed source revision or relevant source chain differs from latest published Memory, including removal. False for immutable interview evidence."
        }
      }
    },
    "Target": {
      "description": "The JD item this reference supports, by identity. target_label is only its human label; never resolve a target by label. Absent when the server predates this field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field", "item_id", "task_id"],
      "properties": {
        "kind": {
          "enum": [
            "profile_field",
            "area",
            "task",
            "detail",
            "capability",
            "collaborator",
            "condition",
            "task_capability"
          ]
        },
        "field": {
          "description": "Set only for profile_field.",
          "anyOf": [
            {"enum": ["job_title", "organization_unit", "reports_to", "purpose"]},
            {"type": "null"}
          ]
        },
        "item_id": {"type": ["string", "null"], "format": "uuid"},
        "task_id": {
          "description": "The owning task, set only for detail and task_capability.",
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    }
  }
}
