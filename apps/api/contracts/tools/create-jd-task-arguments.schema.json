{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateJdTaskArguments",
  "type": "object", "additionalProperties": false,
  "properties": {
    "parent_read_ref": {"type": ["string", "null"], "description": "既有職責的 read_ref；null 表示未歸屬。"},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/TaskDetail"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/TaskDetail"}},
    "required_knowledge": {"type": "array", "items": {"$ref": "#/$defs/TaskCapability"}},
    "required_skills": {"type": "array", "items": {"$ref": "#/$defs/TaskCapability"}},
    "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}}
  },
  "required": ["parent_read_ref", "title", "description", "outcomes", "requirements", "required_knowledge", "required_skills", "supporting_sources"],
  "$defs": {
    "TaskDetail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}}
      }, "required": ["text", "supporting_sources"]
    },
    "TaskCapability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "capability_read_ref": {"type": "string", "minLength": 1},
        "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}}
      }, "required": ["capability_read_ref", "supporting_sources"]
    },
    "Source": {"anyOf": [
      {"$ref": "#/$defs/CurrentInputSource"},
      {"$ref": "#/$defs/InterviewSource"},
      {"$ref": "#/$defs/MemorySource"}
    ]},
    "CurrentInputSource": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"const": "current_input", "type": "string"}},
      "required": ["kind"]
    },
    "InterviewSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"const": "interview", "type": "string"},
        "interview_sequence": {"type": "integer", "minimum": 1}
      }, "required": ["kind", "interview_sequence"]
    },
    "MemorySource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["work_situation", "work_understanding"]},
        "target_title": {"type": "string", "minLength": 1}
      }, "required": ["kind", "target_title"]
    }
  }
}
