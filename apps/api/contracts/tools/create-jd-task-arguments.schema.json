{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateJdTaskArguments",
  "type": "object", "additionalProperties": false,
  "properties": {
    "parent_read_ref": {"type": ["string", "null"], "description": "既有職責的 read_ref；null 表示未歸屬。"},
    "title": {"type": ["string", "null"], "description": "可辨認本人工作動作與對象的短標題；不是每個案例各建一項任務。"},
    "description": {"type": ["string", "null"], "description": "本人做什麼及必要的適用條件、頻率與責任界線；已有事實才寫，不以通用職業知識補齊。"},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/TaskDetail"}, "description": "形成或維持的結果、交付物與用途，不是操作步驟。沒有已知內容時用 []。"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/TaskDetail"}, "description": "已知的完成判準、執行條件或責任界線；與成果並列，不逐項配對，不捏造 KPI。沒有已知內容時用 []。"},
    "required_knowledge": {"type": "array", "items": {"$ref": "#/$defs/TaskCapability"}},
    "required_skills": {"type": "array", "items": {"$ref": "#/$defs/TaskCapability"}},
    "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}, "description": "直接支持任務標題與說明的依據；多項事實可用多筆來源。成果、要求與 K/S 關係各自提供依據，不繼承本清單。"}
  },
  "required": ["parent_read_ref", "title", "description", "outcomes", "requirements", "required_knowledge", "required_skills", "supporting_sources"],
  "$defs": {
    "TaskDetail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}, "description": "直接支持這一項成果或要求的來源；不能一律複製整個任務的來源。"}
      }, "required": ["text", "supporting_sources"]
    },
    "TaskCapability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "capability_read_ref": {"type": "string", "minLength": 1, "description": "read_jd 返回的既有知識或技能定位；尚不存在時先 create_jd_item，不猜 ID。"},
        "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}, "description": "支持這項任務確實需要該能力的依據，不只是能力定義本身的來源。"}
      }, "required": ["capability_read_ref", "supporting_sources"]
    },
    "Source": {"anyOf": [
      {"$ref": "#/$defs/CurrentInputSource"},
      {"$ref": "#/$defs/InterviewSource"},
      {"$ref": "#/$defs/MemorySource"}
    ]},
    "CurrentInputSource": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"const": "current_input", "type": "string"}},
      "required": ["kind"]
    },
    "InterviewSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"const": "interview", "type": "string"},
        "interview_sequence": {"type": "integer", "maximum": 9007199254740991, "minimum": 1}
      }, "required": ["kind", "interview_sequence"]
    },
    "MemorySource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["work_situation", "work_understanding"]},
        "target_title": {"type": "string", "minLength": 1}
      }, "required": ["kind", "target_title"]
    }
  }
}
