{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OccupationReferenceSearchResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "references": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/OccupationReference"
      }
    }
  },
  "required": [
    "references"
  ],
  "$defs": {
    "ReferenceTaskName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "name"
      ]
    },
    "ReferenceTaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceTaskName"
          }
        },
        "competency_block_count": {
          "type": "integer", "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "required": [
        "task_id",
        "names",
        "competency_block_count"
      ]
    },
    "ReferenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceTaskSummary"
          }
        }
      },
      "required": [
        "unit_id",
        "code",
        "name",
        "tasks"
      ]
    },
    "OccupationReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "ocs_code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "catalog_scope": {
          "type": "string",
          "const": "all_parsed_task_groups"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceUnit"
          }
        }
      },
      "required": [
        "reference_id",
        "source_sha256",
        "source_file",
        "ocs_code",
        "title",
        "overview",
        "catalog_scope",
        "units"
      ]
    }
  }
}
