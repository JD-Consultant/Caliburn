{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviseJdProfileArguments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "description": "只列本次要執行的變更；未列的欄位與來源保留。文字修改與來源增刪是不同動作，不必為更新文字重建整組來源。",
      "items": {"anyOf": [
        {"$ref": "#/$defs/SetProfileText"},
        {"$ref": "#/$defs/ClearProfileText"},
        {"$ref": "#/$defs/AddProfileSource"},
        {"$ref": "#/$defs/RemoveProfileSource"},
        {"$ref": "#/$defs/AlignProfileSource"}
      ]}
    }
  },
  "required": ["changes"],
  "$defs": {
    "ProfileField": {"type": "string", "enum": ["job_title", "organization_unit", "reports_to", "purpose"], "description": "職務名稱／所屬單位／直接匯報對象／職務目的。匯報對象不等於所有成果的接收人；目的概括工作的持續價值，不是案例或任務清單。"},
    "SetProfileText": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"const": "set_field", "type": "string"},
        "field": {"$ref": "#/$defs/ProfileField"},
        "value": {"type": "string", "minLength": 1, "description": "此欄完整的新文字；只更改文字，既有來源保留，來源變動另列。"}
      }, "required": ["action", "field", "value"]
    },
    "ClearProfileText": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"const": "clear_field", "type": "string"},
        "field": {"$ref": "#/$defs/ProfileField"}
      }, "required": ["action", "field"]
    },
    "AddProfileSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"const": "add_source", "type": "string", "description": "增加支持此欄內容的直接依據，不替換既有來源。綜合目的可由多則原話共同支持。"},
        "field": {"$ref": "#/$defs/ProfileField"},
        "source": {"anyOf": [
          {"$ref": "#/$defs/CurrentInputSource"},
          {"$ref": "#/$defs/InterviewSource"},
          {"$ref": "#/$defs/MemorySource"}
        ]}
      }, "required": ["action", "field", "source"]
    },
    "RemoveProfileSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"const": "remove_source", "type": "string", "description": "移除此欄的整筆引用，不是只排除原文中被更正的一句。局部更正後，仍須留下共同支持本欄保留事實的依據；失效、重複或已有充分替代的引用可移除。"},
        "field": {"$ref": "#/$defs/ProfileField"},
        "citation_ref": {"type": "string", "minLength": 1, "description": "read_jd 返回、屬於此欄的既有引用定位；不是訪談序號或 Memory 標題。"}
      }, "required": ["action", "field", "citation_ref"]
    },
    "AlignProfileSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"const": "confirm_reference_alignment", "type": "string", "description": "明確宣告已重評此筆引用仍支持所選欄位的目前內容，並完成必要修訂。不是確認其他引用或整欄完成；僅讀過 diff、或此筆支持關係仍有未解衝突時不確認。"},
        "field": {"$ref": "#/$defs/ProfileField"},
        "citation_ref": {"type": "string", "minLength": 1, "description": "read_jd 返回、這次確實完成核對的既有引用定位。"}
      }, "required": ["action", "field", "citation_ref"]
    },
    "CurrentInputSource": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"const": "current_input", "type": "string"}},
      "required": ["kind"]
    },
    "InterviewSource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"const": "interview", "type": "string"},
        "interview_sequence": {"type": "integer", "minimum": 1}
      }, "required": ["kind", "interview_sequence"]
    },
    "MemorySource": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["work_situation", "work_understanding"]},
        "target_title": {"type": "string", "minLength": 1}
      }, "required": ["kind", "target_title"]
    }
  }
}
