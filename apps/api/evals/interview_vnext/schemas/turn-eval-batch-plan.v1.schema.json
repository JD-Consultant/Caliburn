{
  "$defs": {
    "BatchPlanCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 64,
          "pattern": "^TI-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/CaseSplit"
        },
        "runtime_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Runtime Input Hash",
          "type": "string"
        },
        "evaluation_contract_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Contract Hash",
          "type": "string"
        },
        "case_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Case Content Hash",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "split",
        "runtime_input_hash",
        "evaluation_contract_hash",
        "case_content_hash"
      ],
      "title": "BatchPlanCase",
      "type": "object"
    },
    "CaseSplit": {
      "enum": [
        "development",
        "challenge"
      ],
      "title": "CaseSplit",
      "type": "string"
    },
    "ExecutionMode": {
      "description": "Provider path of a batch: scripted reference, mocked transport, or live.",
      "enum": [
        "reference",
        "mocked",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "turn_eval_batch_plan.v1",
      "default": "turn_eval_batch_plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "suite_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Suite Version",
      "type": "string"
    },
    "suite_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Hash",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BatchPlanCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "quality_slots_per_case": {
      "maximum": 3,
      "minimum": 1,
      "title": "Quality Slots Per Case",
      "type": "integer"
    },
    "max_trial_attempts_per_slot": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Trial Attempts Per Slot",
      "type": "integer"
    },
    "max_concurrency": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "ordering_seed": {
      "minLength": 1,
      "title": "Ordering Seed",
      "type": "string"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Sha",
      "type": "string"
    },
    "dirty_worktree": {
      "title": "Dirty Worktree",
      "type": "boolean"
    },
    "operation_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Operation Name",
      "type": "string"
    },
    "operation_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Definition Hash",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "output_schema_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Schema Hash",
      "type": "string"
    },
    "context_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Policy Hash",
      "type": "string"
    },
    "verifier_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Verifier Policy Hash",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Provider",
      "type": "string"
    },
    "provider_config_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Provider Config Hash",
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "title": "Requested Model",
      "type": "string"
    },
    "catalog_canonical_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Canonical Model"
    },
    "upstream_endpoint_slug": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Endpoint Slug"
    },
    "expected_upstream_provider_name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Upstream Provider Name"
    },
    "model_catalog_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Catalog Hash"
    },
    "endpoint_catalog_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Catalog Hash"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Effort"
    },
    "reasoning_exclude": {
      "default": true,
      "title": "Reasoning Exclude",
      "type": "boolean"
    },
    "data_collection": {
      "anyOf": [
        {
          "enum": [
            "deny",
            "allow"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Collection"
    },
    "zdr_required": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zdr Required"
    },
    "account_checklist_confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Checklist Confirmed At"
    },
    "account_checklist_confirmed_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Checklist Confirmed By"
    },
    "max_inference_calls": {
      "minimum": 1,
      "title": "Max Inference Calls",
      "type": "integer"
    },
    "max_observed_cost_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Max Observed Cost Usd"
    },
    "max_wall_clock_minutes": {
      "minimum": 1,
      "title": "Max Wall Clock Minutes",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "execution_mode",
    "suite_version",
    "suite_hash",
    "cases",
    "quality_slots_per_case",
    "max_trial_attempts_per_slot",
    "max_concurrency",
    "ordering_seed",
    "git_sha",
    "dirty_worktree",
    "operation_name",
    "operation_definition_hash",
    "prompt_hash",
    "output_schema_hash",
    "context_policy_hash",
    "verifier_policy_hash",
    "provider",
    "provider_config_hash",
    "requested_model",
    "max_inference_calls",
    "max_observed_cost_usd",
    "max_wall_clock_minutes",
    "created_at",
    "plan_hash"
  ],
  "title": "Caliburn interview vNext turn eval batch plan v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-eval-batch-plan.v1.schema.json"
}
