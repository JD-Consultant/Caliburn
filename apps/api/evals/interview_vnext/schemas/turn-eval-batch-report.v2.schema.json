{
  "$defs": {
    "BatchDecision": {
      "enum": [
        "HARNESS_INVALID",
        "BATCH_INCOMPLETE",
        "REVIEW_INCOMPLETE",
        "TURN_GATE_FAIL",
        "TURN_GATE_PASS_ENGINEERING",
        "TURN_GATE_PASS_DOMAIN_REVIEWED"
      ],
      "title": "BatchDecision",
      "type": "string"
    },
    "BatchTotals": {
      "additionalProperties": false,
      "properties": {
        "total_trials": {
          "minimum": 0,
          "title": "Total Trials",
          "type": "integer"
        },
        "quality_trials": {
          "minimum": 0,
          "title": "Quality Trials",
          "type": "integer"
        },
        "infrastructure_invalid_trials": {
          "minimum": 0,
          "title": "Infrastructure Invalid Trials",
          "type": "integer"
        },
        "harness_invalid_trials": {
          "minimum": 0,
          "title": "Harness Invalid Trials",
          "type": "integer"
        },
        "cancelled_trials": {
          "minimum": 0,
          "title": "Cancelled Trials",
          "type": "integer"
        },
        "inference_calls": {
          "minimum": 0,
          "title": "Inference Calls",
          "type": "integer"
        },
        "usage_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Input Tokens"
        },
        "usage_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Output Tokens"
        },
        "usage_cache_read_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Cache Read Tokens"
        },
        "usage_cache_write_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Cache Write Tokens"
        },
        "usage_reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Reasoning Tokens"
        },
        "observed_cost_total_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Cost Total Usd"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Seconds"
        }
      },
      "required": [
        "total_trials",
        "quality_trials",
        "infrastructure_invalid_trials",
        "harness_invalid_trials",
        "cancelled_trials",
        "inference_calls"
      ],
      "title": "BatchTotals",
      "type": "object"
    },
    "CaseDecision": {
      "enum": [
        "pass",
        "fail",
        "review_incomplete"
      ],
      "title": "CaseDecision",
      "type": "string"
    },
    "CasePassEntry": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 64,
          "pattern": "^TI-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/CaseSplit"
        },
        "pass_pow_3": {
          "title": "Pass Pow 3",
          "type": "boolean"
        },
        "case_decision": {
          "$ref": "#/$defs/CaseDecision"
        }
      },
      "required": [
        "case_id",
        "split",
        "pass_pow_3",
        "case_decision"
      ],
      "title": "CasePassEntry",
      "type": "object"
    },
    "CaseSplit": {
      "enum": [
        "development",
        "challenge"
      ],
      "title": "CaseSplit",
      "type": "string"
    },
    "ExecutionMode": {
      "description": "Provider path of a batch: scripted reference, mocked transport, or live.",
      "enum": [
        "reference",
        "mocked",
        "live"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FailureAttribution": {
      "enum": [
        "context",
        "prompt",
        "schema",
        "model",
        "provider",
        "verifier",
        "reducer",
        "gold",
        "runner",
        "infrastructure",
        "review"
      ],
      "title": "FailureAttribution",
      "type": "string"
    },
    "FailureRecord": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trial Id"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^TI-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "attribution": {
          "$ref": "#/$defs/FailureAttribution"
        },
        "severity": {
          "$ref": "#/$defs/FailureSeverity"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Reason Code",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "prevented_by_verifier": {
          "default": false,
          "title": "Prevented By Verifier",
          "type": "boolean"
        }
      },
      "required": [
        "attribution",
        "severity",
        "reason_code",
        "description"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "FailureSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "diagnostic"
      ],
      "title": "FailureSeverity",
      "type": "string"
    },
    "HardGateResult": {
      "additionalProperties": false,
      "properties": {
        "gate_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Gate Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "details_json": {
          "default": "{}",
          "title": "Details Json",
          "type": "string"
        }
      },
      "required": [
        "gate_name",
        "passed"
      ],
      "title": "HardGateResult",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "ReviewCompleteness": {
      "additionalProperties": false,
      "properties": {
        "required_review_items": {
          "minimum": 0,
          "title": "Required Review Items",
          "type": "integer"
        },
        "completed_review_items": {
          "minimum": 0,
          "title": "Completed Review Items",
          "type": "integer"
        },
        "needs_sme_count": {
          "minimum": 0,
          "title": "Needs Sme Count",
          "type": "integer"
        },
        "failure_traces_read": {
          "minimum": 0,
          "title": "Failure Traces Read",
          "type": "integer"
        },
        "passing_trace_sample_required": {
          "minimum": 0,
          "title": "Passing Trace Sample Required",
          "type": "integer"
        },
        "passing_trace_sample_read": {
          "minimum": 0,
          "title": "Passing Trace Sample Read",
          "type": "integer"
        }
      },
      "required": [
        "required_review_items",
        "completed_review_items",
        "needs_sme_count",
        "failure_traces_read",
        "passing_trace_sample_required",
        "passing_trace_sample_read"
      ],
      "title": "ReviewCompleteness",
      "type": "object"
    },
    "SplitMetrics": {
      "additionalProperties": false,
      "properties": {
        "precision": {
          "$ref": "#/$defs/MetricResult"
        },
        "recall": {
          "$ref": "#/$defs/MetricResult"
        },
        "qualifier_exactness": {
          "$ref": "#/$defs/MetricResult"
        }
      },
      "required": [
        "precision",
        "recall",
        "qualifier_exactness"
      ],
      "title": "SplitMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "turn_eval_batch_report.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "suite_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Suite Version",
      "type": "string"
    },
    "suite_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Hash",
      "type": "string"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Sha",
      "type": "string"
    },
    "dirty_worktree": {
      "title": "Dirty Worktree",
      "type": "boolean"
    },
    "promotion_eligible": {
      "title": "Promotion Eligible",
      "type": "boolean"
    },
    "decision": {
      "$ref": "#/$defs/BatchDecision"
    },
    "hard_gates": {
      "items": {
        "$ref": "#/$defs/HardGateResult"
      },
      "minItems": 1,
      "title": "Hard Gates",
      "type": "array"
    },
    "raw_precision_micro": {
      "$ref": "#/$defs/MetricResult"
    },
    "committed_precision_micro": {
      "$ref": "#/$defs/MetricResult"
    },
    "recall_micro": {
      "$ref": "#/$defs/MetricResult"
    },
    "qualifier_exactness_micro": {
      "$ref": "#/$defs/MetricResult"
    },
    "development_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/SplitMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "challenge_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/SplitMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "split_gap_within_limit": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Gap Within Limit"
    },
    "case_matrix": {
      "items": {
        "$ref": "#/$defs/CasePassEntry"
      },
      "minItems": 1,
      "title": "Case Matrix",
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/BatchTotals"
    },
    "review": {
      "$ref": "#/$defs/ReviewCompleteness"
    },
    "failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FailureRecord"
      },
      "title": "Failures",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "plan_hash",
    "suite_version",
    "suite_hash",
    "execution_mode",
    "git_sha",
    "dirty_worktree",
    "promotion_eligible",
    "decision",
    "hard_gates",
    "raw_precision_micro",
    "committed_precision_micro",
    "recall_micro",
    "qualifier_exactness_micro",
    "case_matrix",
    "totals",
    "review",
    "created_at"
  ],
  "title": "Caliburn interview vNext turn eval batch report v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-eval-batch-report.v2.schema.json"
}
