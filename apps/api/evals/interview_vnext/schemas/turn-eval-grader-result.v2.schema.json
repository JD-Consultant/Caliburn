{
  "$defs": {
    "FailureSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "diagnostic"
      ],
      "title": "FailureSeverity",
      "type": "string"
    },
    "GraderStatus": {
      "enum": [
        "pass",
        "fail",
        "needs_review",
        "not_applicable",
        "invalid"
      ],
      "title": "GraderStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "turn_eval_grader_result.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "grader_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Grader Name",
      "type": "string"
    },
    "grader_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Grader Version",
      "type": "string"
    },
    "grader_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Grader Definition Hash",
      "type": "string"
    },
    "case_id": {
      "maxLength": 64,
      "pattern": "^TI-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "trial_id": {
      "format": "uuid",
      "title": "Trial Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GraderStatus"
    },
    "severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureSeverity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Reason Code",
      "type": "string"
    },
    "subject_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Subject Ids",
      "type": "array"
    },
    "details_json": {
      "default": "{}",
      "title": "Details Json",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "grader_name",
    "grader_version",
    "grader_definition_hash",
    "case_id",
    "trial_id",
    "status",
    "reason_code"
  ],
  "title": "Caliburn interview vNext turn eval grader result v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-eval-grader-result.v2.schema.json"
}
