{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "action",
        "input",
        "output",
        "purpose",
        "condition",
        "standard",
        "frequency",
        "importance",
        "ownership",
        "tool",
        "recipient",
        "dependency",
        "exception",
        "negation",
        "correction",
        "preference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceQualifiersProposal": {
      "additionalProperties": false,
      "properties": {
        "time_scope": {
          "$ref": "#/$defs/TimeScope"
        },
        "time_scope_support": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Scope Support"
        },
        "typicality": {
          "$ref": "#/$defs/Typicality"
        },
        "typicality_support": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typicality Support"
        },
        "polarity": {
          "$ref": "#/$defs/Polarity"
        },
        "polarity_support": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polarity Support"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyQualifierProposal"
        },
        "importance": {
          "$ref": "#/$defs/Importance"
        },
        "importance_support": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importance Support"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "ownership_support": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownership Support"
        }
      },
      "required": [
        "time_scope",
        "typicality",
        "polarity",
        "frequency",
        "importance",
        "ownership"
      ],
      "title": "EvidenceQualifiersProposal",
      "type": "object"
    },
    "EvidenceSubject": {
      "enum": [
        "employee",
        "employee_team",
        "other_role",
        "organization",
        "unknown"
      ],
      "title": "EvidenceSubject",
      "type": "string"
    },
    "FrequencyQualifierProposal": {
      "additionalProperties": false,
      "description": "Provider-facing frequency with decimal text preserved losslessly.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/FrequencyUnit"
        },
        "verbatim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verbatim"
        }
      },
      "required": [
        "value",
        "unit",
        "verbatim"
      ],
      "title": "FrequencyQualifierProposal",
      "type": "object"
    },
    "FrequencyUnit": {
      "enum": [
        "per_day",
        "per_week",
        "per_month",
        "per_quarter",
        "per_year",
        "irregular",
        "unknown"
      ],
      "title": "FrequencyUnit",
      "type": "string"
    },
    "Importance": {
      "enum": [
        "explicit_core",
        "explicit_supporting",
        "not_stated"
      ],
      "title": "Importance",
      "type": "string"
    },
    "Ownership": {
      "enum": [
        "owner",
        "shared",
        "assists",
        "receives",
        "not_responsible",
        "unknown"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "Polarity": {
      "enum": [
        "affirmed",
        "denied",
        "uncertain"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "TimeScope": {
      "enum": [
        "current",
        "past",
        "future",
        "hypothetical",
        "unknown"
      ],
      "title": "TimeScope",
      "type": "string"
    },
    "TurnEvalPriorEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "turn_eval_prior_evidence_binding.v1",
          "default": "turn_eval_prior_evidence_binding.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_key": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Evidence Key",
          "type": "string"
        },
        "observation_index": {
          "minimum": 1,
          "title": "Observation Index",
          "type": "integer"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_key",
        "observation_index",
        "evidence_id"
      ],
      "title": "TurnEvalPriorEvidenceBinding",
      "type": "object"
    },
    "TurnEvalPriorEvidenceFixture": {
      "additionalProperties": false,
      "description": "Declarative prior evidence rebuilt through ApplyEvidenceCommand (§6.3).",
      "properties": {
        "evidence_key": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Evidence Key",
          "type": "string"
        },
        "source_turn_key": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Source Turn Key",
          "type": "string"
        },
        "episode_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Key"
        },
        "subject": {
          "$ref": "#/$defs/EvidenceSubject"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_occurrence": {
          "minimum": 1,
          "title": "Quote Occurrence",
          "type": "integer"
        },
        "qualifiers": {
          "$ref": "#/$defs/EvidenceQualifiersProposal"
        }
      },
      "required": [
        "evidence_key",
        "source_turn_key",
        "subject",
        "kind",
        "claim",
        "quote",
        "quote_occurrence",
        "qualifiers"
      ],
      "title": "TurnEvalPriorEvidenceFixture",
      "type": "object"
    },
    "TurnEvalPriorInterpretationSeedOutput": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "turn_eval_prior_interpretation_seed_output.v1",
          "default": "turn_eval_prior_interpretation_seed_output.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "initial_fixture_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Initial Fixture Hash",
          "type": "string"
        },
        "employee_turn_key": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Employee Turn Key",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnEvalPriorEvidenceFixture"
          },
          "title": "Observations",
          "type": "array"
        },
        "dialogue_act": {
          "const": "standalone_answer",
          "default": "standalone_answer",
          "title": "Dialogue Act",
          "type": "string"
        },
        "episode_signal": {
          "const": "continue",
          "default": "continue",
          "title": "Episode Signal",
          "type": "string"
        },
        "insufficiency_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnInsufficiencyCode"
          },
          "title": "Insufficiency Codes",
          "type": "array"
        }
      },
      "required": [
        "initial_fixture_hash",
        "employee_turn_key"
      ],
      "title": "TurnEvalPriorInterpretationSeedOutput",
      "type": "object"
    },
    "TurnEvalPriorInterpretationSeedReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "turn_eval_prior_interpretation_seed_report.v1",
          "default": "turn_eval_prior_interpretation_seed_report.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "evidence_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TurnEvalPriorEvidenceBinding"
          },
          "title": "Evidence Bindings",
          "type": "array"
        },
        "accepted_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Accepted Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "output_hash"
      ],
      "title": "TurnEvalPriorInterpretationSeedReport",
      "type": "object"
    },
    "TurnInsufficiencyCode": {
      "enum": [
        "ambiguous_frequency",
        "ambiguous_ownership",
        "ambiguous_subject",
        "ambiguous_time_scope",
        "contradiction_unresolved",
        "correction_target_unknown",
        "insufficient_detail",
        "no_work_fact",
        "answer_binding_ambiguous",
        "question_frame_missing",
        "question_frame_stale",
        "question_frame_not_immediate",
        "choice_selection_ambiguous"
      ],
      "title": "TurnInsufficiencyCode",
      "type": "string"
    },
    "Typicality": {
      "enum": [
        "typical",
        "occasional",
        "exception",
        "unknown"
      ],
      "title": "Typicality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Provenance for an adjudicated prior turn's receipt.\n\nTI-09/TI-10 declare evidence that already existed before the target turn. The\ndomain now requires every employee turn to carry a receipt, so the fixture\ncommits a real interpretation for those turns — and this artifact records the\ncontext, output and key mapping it was built from, so no receipt hash is ever\na placeholder or a faked provider output (plan §15.3.6).\n\nEval-only: production ``app/`` must never import this contract, and a seeded\nreceipt never counts toward model quality or promotion.",
  "properties": {
    "schema_version": {
      "const": "turn_eval_prior_interpretation_seed.v1",
      "default": "turn_eval_prior_interpretation_seed.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Suite Version",
      "type": "string"
    },
    "case_id": {
      "maxLength": 64,
      "pattern": "^TI-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "trial_id": {
      "format": "uuid",
      "title": "Trial Id",
      "type": "string"
    },
    "employee_turn_id": {
      "format": "uuid",
      "title": "Employee Turn Id",
      "type": "string"
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "question_frame_id": {
      "format": "uuid",
      "title": "Question Frame Id",
      "type": "string"
    },
    "question_frame_definition_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Question Frame Definition Hash",
      "type": "string"
    },
    "context_packet_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Packet Hash",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/TurnEvalPriorInterpretationSeedOutput"
    },
    "report": {
      "$ref": "#/$defs/TurnEvalPriorInterpretationSeedReport"
    }
  },
  "required": [
    "suite_version",
    "case_id",
    "trial_id",
    "employee_turn_id",
    "operation_id",
    "question_frame_id",
    "question_frame_definition_hash",
    "context_packet_hash",
    "output",
    "report"
  ],
  "title": "Caliburn interview vNext adjudicated prior interpretation seed v1",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-eval-prior-interpretation-seed.v1.schema.json"
}
