{
  "$defs": {
    "TranscriptRole": {
      "enum": [
        "consultant",
        "employee"
      ],
      "title": "TranscriptRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One transcript line; raw text preserved, no trim/NFKC/whitespace merge.",
  "properties": {
    "schema_version": {
      "const": "turn_eval_transcript_turn.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "turn_key": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "title": "Turn Key",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/TranscriptRole"
    },
    "locale": {
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "title": "Locale",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "occurred_offset_seconds": {
      "minimum": 0,
      "title": "Occurred Offset Seconds",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "turn_key",
    "sequence",
    "role",
    "locale",
    "text",
    "occurred_offset_seconds"
  ],
  "title": "Caliburn interview vNext turn eval transcript turn v2",
  "type": "object",
  "$id": "https://caliburn.local/schemas/turn-eval-transcript.v2.schema.json"
}
