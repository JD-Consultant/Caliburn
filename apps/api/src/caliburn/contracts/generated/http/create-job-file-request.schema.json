{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateJobFileRequest",
  "description": "One explicit creation command. Transport resends reuse command_id; a new file uses a new command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "display_name", "employee_name"],
  "properties": {
    "command_id": {"type": "string", "format": "uuid"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000]*[^\\u0000\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][^\\u0000]*$"},
    "employee_name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000]*[^\\u0000\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000][^\\u0000]*$"}
  }
}
