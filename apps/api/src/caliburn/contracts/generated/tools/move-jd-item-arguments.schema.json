{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoveJdItemArguments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "read_ref": {"type": "string", "minLength": 1, "description": "read_jd 提供的既有 JD 項目定位；保留身分與來源，不以刪除重建模擬移動。"},
    "destination": {"anyOf": [{"$ref": "#/$defs/CurrentContainer"}, {"$ref": "#/$defs/TaskParent"}]},
    "position": {"anyOf": [{"$ref": "#/$defs/EdgePosition"}, {"$ref": "#/$defs/RelativePosition"}]},
    "content_changes": {"type": "array", "description": "通常為空。只有任務換職責／未歸屬時，可同次修正該任務文字、明細及來源／目的職責 scope_text，或新增成果／要求；全部原子套用。不變更來源引用。", "items": {"anyOf": [{"$ref": "#/$defs/SetMovementText"}, {"$ref": "#/$defs/ClearMovementText"}, {"$ref": "#/$defs/AddMovementDetail"}]}}
  },
  "required": ["read_ref", "destination", "position", "content_changes"],
  "$defs": {
    "CurrentContainer": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"type": "string", "const": "current_container", "description": "在目前容器同類項目中排序；成果／要求限同一任務、同一類。"}},
      "required": ["kind"]
    },
    "TaskParent": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "const": "task_parent"},
        "parent_read_ref": {"type": ["string", "null"], "minLength": 1, "description": "目的職責的 read_ref；null 表示未歸屬。只有任務可換容器。"}
      }, "required": ["kind", "parent_read_ref"]
    },
    "EdgePosition": {
      "type": "object", "additionalProperties": false,
      "properties": {"kind": {"type": "string", "enum": ["first", "last"]}},
      "required": ["kind"]
    },
    "RelativePosition": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["before", "after"]},
        "neighbor_read_ref": {"type": "string", "minLength": 1, "description": "目的容器中同類鄰項的 read_ref。不是數字 position，也不是任意其他區域。"}
      }, "required": ["kind", "neighbor_read_ref"]
    },
    "SetMovementText": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "const": "set_field"},
        "read_ref": {"type": "string", "minLength": 1},
        "field": {"type": "string", "enum": ["title", "description", "scope_text", "text"], "description": "移動任務 title/description；該任務明細 text；來源與目的職責 scope_text。"},
        "value": {"type": "string", "minLength": 1}
      }, "required": ["action", "read_ref", "field", "value"]
    },
    "ClearMovementText": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "const": "clear_field"},
        "read_ref": {"type": "string", "minLength": 1},
        "field": {"type": "string", "enum": ["title", "description", "scope_text"], "description": "僅清空可空欄；任務／職責仍須有有意義內容。"}
      }, "required": ["action", "read_ref", "field"]
    },
    "AddMovementDetail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "const": "add_detail"},
        "kind": {"type": "string", "enum": ["outcome", "requirement"]},
        "text": {"type": "string", "minLength": 1, "description": "為本次移動任務新增的完整成果或要求；不改其他任務。"}
      }, "required": ["action", "kind", "text"]
    }
  }
}
