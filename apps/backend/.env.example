# 本機複製成 .env，填入自己的設定；由 uv run --env-file .env 載入。
CALIBURN_REBUILD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/caliburn

# 公版配置必填；先從 reference.example.json 複製，再指定索引與本機模型。
# 模組常設，搜尋模型延遲載入；Agent 的 job_reference Plugin 仍可選。
CALIBURN_REBUILD_REFERENCE_CONFIG=.local/reference.json

# 正式同源 Host 指定前端 build 目錄，API 掛在 /api；省略時只提供開發用 API。
# CALIBURN_REBUILD_WEB_DIST=../frontend/dist

# PDF 獨立於 Agent；未配置字型時下載入口回 503。
# 字型須是明示可讀且授權使用的繁中文字型檔；不自動下載或搜尋系統字型。
# CALIBURN_REBUILD_PDF_FONT_PATH=C:/path/to/licensed/NotoSansTC-VF.ttf
# 可選：指定與鎖定 Playwright 相容的 Chromium 執行檔；省略則用已安裝版本。
# CALIBURN_REBUILD_PDF_CHROMIUM_PATH=C:/path/to/chromium/chrome.exe

# 啟用模型執行時指定 Agent 設定與憑證。
# CALIBURN_REBUILD_AGENT_CONFIG=.local/agent.json
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Checkpoint 使用另一個資料庫或專用 schema；啟用 Agent 時必填。
# 曾啟用 Agent 的部署，停用模型後仍保留此連線，供 Workspace 刪除清理保存點。
# CALIBURN_REBUILD_AGENT_CHECKPOINT_CONNINFO=postgresql://USER:PASSWORD@127.0.0.1:5432/caliburn_checkpoints
