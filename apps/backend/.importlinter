[importlinter:contract:shared]
name = Shared code does not depend on business modules
type = forbidden
source_modules =
    caliburn.shared
forbidden_modules =
    caliburn.modules

[importlinter:contract:plan_workspace_queries]
name = Plan uses public Workspace persistence queries
type = forbidden
source_modules =
    caliburn.modules.plan
forbidden_modules =
    caliburn.modules.workspace.infrastructure.persistence.orm_models
allow_indirect_imports = true

