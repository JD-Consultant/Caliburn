[importlinter]
root_package = caliburn
include_external_packages = true

[importlinter:contract:domain]
name = Domain does not depend on application or technical adapters
type = forbidden
source_modules =
    caliburn.shared.domain
    caliburn.modules.workspace.domain
    caliburn.modules.job_description.domain
    caliburn.modules.plan.domain
    caliburn.modules.interview.domain
    caliburn.modules.memory.domain
    caliburn.modules.occupation_reference.domain
forbidden_modules =
    caliburn.shared.application
    caliburn.modules.workspace.application
    caliburn.modules.job_description.application
    caliburn.modules.plan.application
    caliburn.modules.interview.application
    caliburn.modules.memory.application
    caliburn.shared.infrastructure
    caliburn.modules.workspace.infrastructure
    caliburn.modules.job_description.infrastructure
    caliburn.modules.plan.infrastructure
    caliburn.modules.interview.infrastructure
    caliburn.modules.memory.infrastructure
    caliburn.modules.agent.infrastructure
    caliburn.shared.presentation
    caliburn.modules.workspace.presentation
    caliburn.modules.job_description.presentation
    caliburn.modules.plan.presentation
    caliburn.modules.interview.presentation
    caliburn.modules.memory.presentation
    caliburn.host
    fastapi
    sqlalchemy
    psycopg
    langgraph
    langchain_core
    openai
    caliburn.modules.occupation_reference.application
    caliburn.modules.occupation_reference.infrastructure
    caliburn.modules.occupation_reference.presentation
    caliburn.modules.occupation_reference.bootstrap
    qdrant_client
    pdfplumber
    torch
    transformers

