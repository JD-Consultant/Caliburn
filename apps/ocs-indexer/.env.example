# Caliburn ocs-indexer — copy to .env. .env is gitignored.

# Qdrant — local docker (docker compose up -d qdrant). Keyless on localhost.
# Hosted: set the full host URL + QDRANT_API_KEY (factory infers 443/6333 by scheme).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=300

# Source data
# Drop OCS JSON copies under <OCS_SOURCE_ROOT>/<subdir>/*.json before `index`.
# source_file payload is computed relative to OCS_SOURCE_ROOT.
OCS_SOURCE_ROOT=./data

# Collection
QDRANT_COLLECTION=ocs_v4

# Embedding — GPU: cuda + fp16; CPU-only machines: BGE_M3_DEVICE=cpu, BGE_M3_USE_FP16=false
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cuda
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=8

# Pipeline
INDEX_BATCH_SIZE=32

# Query API (optional extra: `uv sync --extra api`)
# Run: jd-ocs-indexer serve --host 127.0.0.1 --port 8000  (api INDEXER_BASE_URL points here)
