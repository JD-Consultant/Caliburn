            "task_codes": [
              {
                "code": "T1.1",
                "name": "安裝設備、線路連接及軟體設定"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據客戶需求,評估3D列印設備類型。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "進行安裝前環境評估,確認場地空間、電力供應、通風條件及安全要求是否符合設備安裝標準。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "規劃設備擺放位置與配線路徑,確保操作空間充足且符合安全距離要求。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "辨識不同類型3D列印技術機器所需的關鍵組件。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "依據設備原廠安裝手冊,正確安裝與更換各項組件、安裝及設定軟體,並完成電源、訊號線路的連接。"
                  }
                ],
