  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職以上畢業，具備電腦基礎操作能力。"
    ],
    "supplements": [
      "【註1】標註：包含做標記、標重點、打標籤、框物件、做註釋等方式。",
      "【註2】標註模式：如人工模式、人機協作模式（同時使用Auto labelling及人工優化）。",
      "【註3】資料標註類型：包含拼音標註、韻律標註、詞性標註、音素時間點標註、語音轉寫、分類標註、打點標註、標框標註、區域標註等。"
    ]
  }
