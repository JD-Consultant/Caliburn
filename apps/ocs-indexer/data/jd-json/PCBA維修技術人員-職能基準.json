  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "自信心：在表達意見、做決定、面對挑戰或挫折時，相信自己有足夠的能力去應付；面對他人反對意見時，能獨自站穩自己的立場。"
      },
      {
        "code": "A05",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A07",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上電子、電機相關科系畢業者。",
      "高中職電子、電機相關群科畢業且具相關工作經驗2年以上者。"
    ],
    "supplements": [
      "維修資料庫：內容包括行業標準作業程序（如：IPC610、IPC7711-7721、JSTD001等）、正常產品與異常產品對比庫檔案、研發項目經驗及生產經驗文件",
      "庫等。",
      "文件資訊：包括提供給客戶的文件、提供生產組裝部門作業文件、作業指導書、BOM表等。",
      "儀器設備：如PCB上件板故障診斷測試器、放大鏡、拆焊台、熱風槍、影像辨識、光學儀器、AOI等。",
      "問題解決的相關技法：如FMEA失效模式效應分析、QC七大手法、QC Story、PSP等。"
    ]
  }
}