            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "運用放大鏡或相關光學檢驗儀器,進行線路變形、缺口、過細等線路檢查問題點之確認。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "運用放大鏡或相關光學檢驗儀器,進行防焊顏色是否正確;並確認是否有脫落、刮傷、露銅、氣泡、偏移...等外觀不良現象。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "運用放大鏡或相關光學檢驗儀器,檢測表面處理是否正確且符合規格。"
                  },
                  {
                    "code": "P1.2.4",
                    "text": "運用放大鏡或相關光學檢驗儀器,進行文字外觀檢查,包括顏色是否正確;標記是否正確完整;字體是否清晰可辨識且不偏移。"
                  },
