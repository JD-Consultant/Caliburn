        "ocu_name": "PCB成品外觀檢查",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "孔徑、孔位、成型尺寸及板彎翹檢查"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "使用PIN規或驗孔設備確認孔徑、孔位是否符合規格。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "使用量具或二次元設備確認外型尺寸是否符合規格。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "使用花崗岩平台及厚度規,確認板彎、板翹情形是否符合規格要求。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "填寫相關紀錄表單。"
