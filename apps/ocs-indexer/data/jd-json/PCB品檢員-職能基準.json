                "name": "異常反應與協助處理"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "依允收規範要求,確認異常品是否允收。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "依規範進行電路板異常品分類置放,並填寫紀錄。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "將電路板異常問題向上反應,並依主管指示協助處理。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "依主管指示,進行電路板異常品之維修或"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "電路板異常品於維修後,均需重新確認其各項品質要求是否合格。"
