              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1.1",
                    "text": "能夠計算單相及兩相流体之壓降,並選用適合之管路尺寸,提出系統壓力平衡計算書。"
                  },
                  {
                    "code": "P3.1.1.2",
                    "text": "能夠計算與指定適當的控制閥壓降。"
                  },
                  {
                    "code": "P3.1.1.3",
                    "text": "設計時,能夠避免流速超過設計限制,而造成之噪音、靜電累積、沖蝕、污泥沈積等問題。"
                  },
                  {
                    "code": "P3.1.2.1",
                    "text": "能夠計算泵NPSHa,揚程"
                  },
                  {
                    "code": "P3.1.2.2",
                    "text": "能夠選用適合製程需求的軸封泵及無軸封泵。"
                  },
                  {
                    "code": "P3.1.2.3",
                    "text": "能夠正確估算真空系統洩漏量。"
