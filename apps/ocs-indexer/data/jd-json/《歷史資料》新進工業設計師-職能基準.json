    "job_description": "協助設計部門設計專案執行，能夠以各種造型的表現技法，將設計概念以具體的樣式展現出來，進而傳達設計理念，並可透過大量生產達到銷\n售目的。因應客戶的需求，提供客製化設計服務；不斷的發想、溝通、討論，以設計出符合功能及美感都兼具的商品。",
    "ocs_level": 3
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "A01敏銳的觀察A02熱情、自主A03獨立思考能",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "協助資深設計師設計工作執行。"
              },
              {
                "code": "T1.2",
                "name": "市場資料蒐集及分析。"
              },
              {
                "code": "T1.3",
                "name": "進行公司所新開發產品的外觀設計。"
              },
              {
                "code": "T1.4",
                "name": "提案討論產品使用方式改變之建議,改善產品功能及外觀設計。"
              },
              {
                "code": "T1.5",
                "name": "材質選用與配置。"
              },
              {
                "code": "T1.6",
                "name": "與機構工程師、專案經理、業務討論產品的可行性及方向性,溝通、規劃、修正設計,以使產品是符合市場性可銷售性的產品。"
              },
              {
                "code": "T1.7",
                "name": "與客戶業務溝通,以了解客戶開發方向。"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1",
                    "text": "有能力執行令客戶滿意的設計專案。"
                  },
                  {
                    "code": "P1.2",
                    "text": "透過各種調查手法,能夠發掘消費者或使用者真正需求。"
                  },
                  {
                    "code": "P1.3",
                    "text": "將創新並有競爭力的產品概念,轉化成明確的產品企劃。"
                  },
                  {
                    "code": "P1.4",
                    "text": "富有專業的表現技法,依產品企劃的設計需求將產品具體呈現。"
                  },
                  {
                    "code": "P1.5",
                    "text": "完整考量各項生產製造運送流程,包括開模、加工製造、材質使用的適切性、材積運費等細節。"
                  },
                  {
                    "code": "P1.5",
                    "text": "設計的圖面符合限制條件,並具備創新與美感,且能夠進行大量生產。"
                  }
