  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A02",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢，完成任務。"
      },
      {
        "code": "A05",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A06",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上人力資源、企業管理、勞工關係、法律、心理等系所畢業，且具1年以上相關領域工作經驗。",
      "年以上人力資源相關領域工作經驗。"
    ],
    "supplements": [
      "勞動相關法規：如勞動基準法、勞工退休金條例、中高齡者及高齡者就業促進法、身心障礙者權益保障法、性別平等工作法、性騷擾防治法、個人資料保",
      "護法、勞資爭議處理法等。",
      "佈達管道：如勞資會議、教育訓練、組織內部公告文宣及溝通會議等。",
      "認證規範：如企業社會責任CSR、ISO、責任商業聯盟RBA等。"
    ]
  }
