  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A05",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A06",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職以上美術相關科系畢業，並具平面或視覺作品。",
      "參訓資格依各訓練單位規定。"
    ],
    "supplements": [
      "介面視覺設計相關資訊：如視覺風格、設計發展趨勢、競爭者產品及使用者經驗回饋等資訊。",
      "分析內外部環境：裝置設備操作環境空間與使用者體驗之互動方式。",
      "產品分析報告：如組織產品定位、優劣勢等。",
      "組織相關人員：如專案經理、專案企劃人員、研發工程師及使用者經驗設計人員等。",
      "設計能力：如色彩搭配能力、素描能力等。",
      "功能規格書：如Flow chart（流程圖：如使用者操作情境或功能）、UI Floｗ（使用者介面流程：介面間的操作流程）與functional map等。",
      "線框稿（wireframe）：指低保真度的設計原型，在沒有任何視覺設計細節下進行頁面結構、功能與內容規劃。",
      "視覺稿（mockup）：如視覺設計的配色、動畫特效創意說明與版面調整等。",
      "各元素資訊：如尺寸、位置、色碼、透明度、字型、字級與檔名等。"
    ]
  }
}