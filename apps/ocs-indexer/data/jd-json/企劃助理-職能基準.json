  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A05",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "無。"
    ],
    "supplements": [
      "各類企劃活動：如組織年度活動、公關活動、節慶活動、行銷通路活動、產品推廣活動、組織形象活動或組織品牌活動等。",
      "企劃提案簡報：包含企劃目標、執行範圍、方式、期程、所需資源、預算編列與效益評估等。"
    ]
  }
