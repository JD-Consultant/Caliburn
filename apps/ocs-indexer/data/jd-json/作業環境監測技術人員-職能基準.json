        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "準備前置作業(通則性類別)"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "依相關法規及監測計畫,確認監測前現場調查方法。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "依相關法規及監測計畫,判別作業環境因子,選用正確的監測方法及監測儀器設備。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "依採樣現場環境決定採樣人員個人防護具"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "依委託業者要求,進行現場危害告知、了解保密措施,視需要,採樣人員須簽署保密協定。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "依相關法規、監測計畫與監測項目,校準儀器設備。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "確認需委託外部校驗採樣儀器設備在校驗期限內(建議離校驗到期日1個月以上,避免採樣前過期)。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "確認採樣儀器設備電力需求及採樣前充電。"
                  },
                  {
                    "code": "P2.1.8",
                    "text": "確認採樣之吸附管、濾紙等保存期限及樣品外觀完整性。"
                  },
                  {
                    "code": "P2.1.9",
                    "text": "備用採樣儀器設備。"
                  }
                ],
