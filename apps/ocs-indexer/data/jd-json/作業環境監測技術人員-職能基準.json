            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "蒐集並彙整國內外最新勞工作業環境監測法規及勞工作業環境監測技術。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "蒐集內外部現有作業環境監測相關資訊。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "判別資訊可用性及有效性,並分類歸納及"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "蒐集受測單位的環境、製程和生產資料,包括檢測歷史紀錄、職業病的統計資料、員工職安衛相關申訴案件等。"
                  }
