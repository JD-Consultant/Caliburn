        "ocu_name": "規劃與執行使用者行為研究",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "目標使用者屬性分析"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "從客戶、網路、研究文件及透過訪談、觀察或參與等方式,探索及蒐集使用者經驗或感受等資訊。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "針對不同目標客群進行分析及設定策略。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "針對每一類型的代表使用者,描述其相關屬性與背景。"
                  }
