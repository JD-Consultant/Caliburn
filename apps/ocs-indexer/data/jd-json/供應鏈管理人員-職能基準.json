    "job_description": "開發並管理從供應商到最終客戶的所有流程，包括協調生產計畫、物流運輸、庫存控制和品質管理，以確保達到產品準時交付、成本最適化和客\n戶滿意度最大化。",
    "ocs_level": 4
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "管理供應商",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "供應商的開發與評估"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "了解產業趨勢掌握組織供應鏈體系,據以評估需供應商提供之物料、成品數量、時間。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "評估各供應商的技術能力、生產能力、質量控制能力、交貨能力、成本效益和財務穩定性。"
                  }
                ],
                "outputs": [],
