                "code": "T1.1",
                "name": "執行停車場服務管理"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 2,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依組織建置的停車場服務管理作業程序,現場巡查責任轄區內之停車場,確保停車場的服務正常。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "如實記錄現場巡查之發現、停車場之問題、排除作法及結果。"
                  }
                ],
                "outputs": [
