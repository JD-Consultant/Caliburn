  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A02",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "持續學習：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上相關科系畢業，或具1年以上公關相關工作經驗。"
    ],
    "supplements": [
      "【註1】公關活動：如記者會、新聞發布會、產品上市會、主題餐會、展示會與開幕剪綵活動等以維繫公共關係及組織品牌形象相關活動。",
      "【註2】相關法令規範：如公平交易、廣電相關法規、個人資料保護法、身心障礙者權益保障法、智慧財產權、性別工作平等法、勞動法令…等",
      "【註3】內外部公共關係：如政府關係、業界或協會關係、媒體、消費者關係、投資者與股東關係、員工關係、推廣商等。",
      "【註4】公關事務性工作：如撰寫新聞稿、致詞稿、聲明書、整合組織內外公關資訊…等。",
      "【註5】代理商：廣告公司、公關公司、整合行銷公司、媒體採購公司…等。"
    ]
  }
}