        "ocu_name": "維修冷凍空調與熱泵系統",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T3.1",
                "name": "維修附屬設備"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "遵循法規及程序,指定由冷凍空調專業技術人/員進行現場測試、測量或控管,進行必要之隔離,檢查設備。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "與主管商議,記錄故障或停機引起之安全危害,修訂風險控管程序,改善與執行。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "運用冷凍空調動力及控制系統知識,藉由測量電路/馬達參數,計算所得數值,發現故障,重複檢查疑似故障之馬達、構件或電路,確認其故障情況。"
                  },
                  {
                    "code": "P3.1.4",
                    "text": "視必要拆除舊設備,將其零件整理後妥善存放,以防遺失或損壞,並備妥維修故障所需之替換零件。"
                  },
                  {
                    "code": "P3.1.5",
                    "text": "重新組裝器械,測試修復成效,進行最後測試,並確保機組正常運轉。"
                  },
                  {
                    "code": "P3.1.6",
                    "text": "運用永續能源原則與不損壞其他組件、設備、器械、電路與週遭環境,進行修復故障作業並做紀錄。"
                  }
