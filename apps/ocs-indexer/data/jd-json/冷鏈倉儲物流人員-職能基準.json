    "job_description": "依訂單需求進行理貨、包裝，及協助倉庫貨物進出與管理，並確保所有作業過程中貨品皆能保存於適當的溫度環境。",
    "ocs_level": 3
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "貨物進倉管理",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "進倉準備工作"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "使用倉儲管理系統,確認當日進倉之客戶、貨品、數量、時間與溫層。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "將當日進倉資料進行彙整,依照棧板/車次/碼頭/貨櫃/貨運公司等資訊整理成對應的入庫(驗收)單。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "將入庫(驗收)單依照對應的棧板/車次/碼頭/貨櫃/貨運公司,分發至各集貨區域。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "準備接收貨物所需的相關工具和設備,如溫度計、標記器、防凍衣、冷藏/冷凍車、倉庫內部系統登記用之電子設備等。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "入庫(驗收)單"
                  }
                ],
