            "task_codes": [
              {
                "code": "T3.2",
                "name": "調整印刷前整備作業"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.2.1",
                    "text": "進行調整規位程序:仔細校準印版,檢查給被印材、輸、收、推拉規位之情況,並作適當調整,校正壓力,調整好油墨供給量,確實做好調整刮墨刀等各項程序。"
                  },
                  {
                    "code": "P3.2.2",
                    "text": "將油墨置入墨槽並使用幫浦循環讓油墨充分循環。"
                  },
                  {
                    "code": "P3.2.3",
                    "text": "調整合適之刮刀角度及刮刀壓力。"
                  },
                  {
                    "code": "P3.2.4",
                    "text": "量測油墨黏度並設定油墨黏度。"
                  },
                  {
                    "code": "P3.2.5",
                    "text": "設定各色印刷乾燥溫度及風量、放料張力、收料張力、印刷速度及壓筒(輥)壓力。"
                  }
