    "job_description": "執行報紙、雜誌、圖書、繪本等出版品之企劃及素材之選用、校對、審核、編排、修潤、版型、下標、校樣、排印、網路上架、點閱率追蹤等工\n作。",
    "ocs_level": 4
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "執行實體出版品與數位出版品之編輯流程",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "執行出版品採訪及邀稿工作"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確立刊物或著作採訪主題,洽談受採訪者,就採訪內容進行說明與溝通。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "於約訪日期進行採訪與拍攝工作,並完成採訪稿或採訪記錄。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "針對新聞或社會事件、著作擬訂採訪內容並對相關人士進行跟拍,同時錄影紀錄。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "就採訪稿或紀錄進行編輯、整稿與校對等編輯流程。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "執行文案規劃、文字編撰、增修圖片等工作。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "就完成的出版品稿件呈送主管,經核可後,確定出版、刊登或數位出版品網路上架等日期。"
                  }
                ],
                "outputs": [
