  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A02",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "自信心：在表達意見、做決定、面對挑戰或挫折時，相信自己有足夠的能力去應付；面對他人反對意見時，能獨自站穩自己的立場。"
      },
      {
        "code": "A05",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢，完成任務。"
      },
      {
        "code": "A06",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上人力資源、企業管理、勞工關係、法律、心理等系所畢業。",
      "依勞資爭議仲裁辦法第18條規定，主管機關遴聘之仲裁人，應具備下列資格之一：",
      "一、曾任或現任國內、外仲裁機構仲裁事件之仲裁人。",
      "二、曾任或現任法官、檢察官五年以上。",
      "三、律師及其他依法具有專門執業及技術執業資格人員五年以上。",
      "四、曾任或現任教育部認可之大專校院助理教授以上之教師五年以上。",
      "五、曾任政府機關九職等以上之行政職務五年以上。"
    ],
    "supplements": [
      "仲裁程序法規：如勞資爭議處理法、勞資爭議仲裁辦法等。"
    ]
  }
