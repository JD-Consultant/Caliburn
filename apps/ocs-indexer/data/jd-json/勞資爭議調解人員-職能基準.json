        "ocu_code": "T1",
        "ocu_name": "執行勞資爭議調解",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "蒐集案件與研究"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確認勞資爭議原因及雙方主張與陳述。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "針對案件爭議事項,進行勞動法令分析與合法性評估。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "收集相關判例、論點及其他資料,徵詢勞動主管機關意見。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "調解人應調查事實,並於指派規定期限內"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "進行調查時,得通知雙方當事人、關係人員到會說明,或提出書面說明。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "為調查之必要時,向爭議事件有關之事業單位進行調查;若必須進入相關事業單位訪查,得經主管機關同意。"
                  }
                ],
