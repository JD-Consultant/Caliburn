  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "工作熱忱：因為喜歡從事某件事情而主動去做，並且會積極主動地去面對克服所碰到的挑戰。"
      },
      {
        "code": "A02",
        "name": "創意思考：對於既有的思考模式能適時地創造不同的切入角度，並激發出新的構思。"
      },
      {
        "code": "A03",
        "name": "溝通協調：於工作中，引導各參與單位之積極性，並妥善處理各單位之溝通協調，使其減少摩擦。"
      },
      {
        "code": "A04",
        "name": "團隊協作：為了實現某一目標而由相互協作的個體所組成的正式群體，彼此皆有共同的理念與信念完成交辦任務。"
      },
      {
        "code": "A05",
        "name": "應變能力：面對意外事件等壓力，能迅速地做出反應，並尋求合適的方法，使事件得以妥善解決的能力。"
      },
      {
        "code": "A06",
        "name": "解決問題能力：能在必要時採取行動，以有效釐清模糊不清的態勢，完成任務。"
      },
      {
        "code": "A07",
        "name": "自我管理（學習力/抗壓/職業道德）：對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A08",
        "name": "文化思維：對跨國文化思維要有所涉略或研究，及不同層次的文化或新興文化議題要有所關注、融會貫通。"
      },
      {
        "code": "A09",
        "name": "趨勢關注：對國際包材法規趨勢、新的材料應用發展要有所關注，不斷吸收新知。"
      },
      {
        "code": "A11",
        "name": "美感素養：對設計有濃厚興趣、具美學的鑑賞或品味之能力。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "熟悉包裝材料、結構、製程、印製程序，並具備2年以上相關領域或實務經驗者。",
      "具備Photoshop、Illustrator、Coreldraw、InDesign等繪圖軟體運用技巧（手繪、電腦繪圖）。",
      "注重美感、創意思維、有良好的溝通協調能力。",
      "具分析與解決包裝相關問題能力。",
      "具備平面設計，含圖稿、文案的排版設計。"
    ],
    "supplements": []
  }
