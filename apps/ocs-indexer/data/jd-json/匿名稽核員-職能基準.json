  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A03",
        "name": "親和力：對他人表示理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A04",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A05",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      }
    ]
  },
