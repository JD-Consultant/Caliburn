      {
        "ocu_code": "T1",
        "ocu_name": "類比IC設計",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "依功能需求設定類比IC功能、工作頻率、操作速度、介面規格、消耗功率等基本規格。"
              },
              {
                "code": "T1.2",
