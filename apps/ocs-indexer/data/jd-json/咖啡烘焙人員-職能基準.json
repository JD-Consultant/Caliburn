      {
        "ocu_code": "T2",
        "ocu_name": "烘焙咖啡豆",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "烘焙咖啡豆"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "依相關規範,完成烘豆前置事項(如備料、分類等)。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "依相關規範與生豆屬性,選用正確工具秤取生豆並完成紀錄。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "依相關規範與烘豆流程,掌握適當速度,判別正確進豆時間並完成紀錄。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "依不同風味(烘焙度)成品豆需求,設定正確的烘焙控制參數/條件並完成紀錄。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "依相關規範,觀察烘焙過程咖啡豆之烘焙變化,配合所設定之烘焙控制參數條件,出豆/下豆冷卻/秤重並完成紀錄。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "運用感官評估方式與正確儀器,確認烘焙出之成品豆之品質符合目標要求。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "依相關規範,判別危險與應變處理突發狀況。"
                  }
                ],
