        "ocu_code": "T1",
        "ocu_name": "物料庫存管理",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "進行物料庫存管理"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "定時記錄物料庫存情形。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "掌握咖啡生熟豆等物料庫存量,低於安全庫存量時,即時通知主管。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依據食品安全衛生管理法規定,適當包裝咖啡生熟豆等物料,並依進貨日期先後排放,以利保存管理。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "定時進行庫房環境檢查,如溫度、濕度、蟲害等。"
                  }
                ],
