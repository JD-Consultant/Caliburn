        "ocu_name": "規劃各產品銷售",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "銷售各項產品"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確認產品或服務在銷售區域內的特色與市場定位,並監測主要競爭對手的動向進行回報。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "從通路和銷售產品的過程行動中,依據客戶需求以制訂區域銷售計畫。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依組織規範之預算規劃舉辦促銷方案或活動的機會,為銷售創造增加附加價值。"
