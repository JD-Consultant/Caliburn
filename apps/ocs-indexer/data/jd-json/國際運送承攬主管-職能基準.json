          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "管理與督導國際貨運運輸處理作業"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "領導業務團隊依據國際貨運運輸、法規及工作政策相關規範進行客戶開發。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "督導團隊依客戶需求進行規劃。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依團隊或客戶需求,解釋工作內含及任務陳述,以定義國際貨運運輸的處理需求。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "評估、修正與協調適當的工作程序系統"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "督導國際貨運運輸所需的人力資源最適安排,以進行人員的指派、雇用及或訓練。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "管理並達成所提案的國際貨運運輸流程的品質標準及程序。"
                  }
                ],
