            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "多方收集市場上對保險商品需求的資訊,衡量市場發展及判斷市場趨勢,透過一連串的精算假設與壓力測試,設計符合主管機關法令、顧客需求、公司商品利潤及具市場競爭力之保險商品。"
                  }
                ],
                "outputs": [
