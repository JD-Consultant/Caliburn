  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "監控太陽光電發電系統",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "確認監控環境"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確認監控系統硬體設備以及相關軟體已完整安裝,並能順利運行。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "確認工程設置的遠端連線能正常運行。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依照文件或工作記錄,確認所設置的太陽光電系統各監控點數值或代碼是否正確。"
                  }
                ],
                "outputs": [],
                "knowledge": [
                  {
                    "code": "K01",
                    "name": "太陽光電監控系統"
                  },
                  {
                    "code": "K02",
                    "name": "網路連線原理"
                  },
                  {
                    "code": "K03",
                    "name": "太陽光電發電系統基礎知識"
                  }
                ],
                "skills": [
                  {
                    "code": "S01",
                    "name": "監控軟體或系統操作"
                  }
                ]
              }
            ]
          },
          {
            "task_codes": [
              {
                "code": "T1.2",
                "name": "監控系統運行狀態"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "監測太陽光電電池板的發電量和發電效率,以確保電池板正常運轉並且產生足夠的電力。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "監控變流器的運行狀態,以確保變流器正常工作並且產生穩定的交流電。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "監測整個太陽光電發電系統的運行狀態,以檢查是否存在任何故障或問題。"
                  },
                  {
                    "code": "P1.2.4",
                    "text": "確保監控系統的警報作業正常運行、能夠及時發出警報信息,以便維修人員能夠及時處理問題。"
                  }
                ],
                "outputs": [],
                "knowledge": [
                  {
                    "code": "K01",
                    "name": "太陽光電監控系統"
                  },
                  {
                    "code": "K02",
