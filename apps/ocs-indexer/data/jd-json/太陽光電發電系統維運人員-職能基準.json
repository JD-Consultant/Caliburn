      {
        "ocu_code": "T2",
        "ocu_name": "發電系統的故障排除",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "疑難排解及故障排除工作"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "執行工作遵守職業衛生與安全風險管控措施及程序,並依職業衛生與安全要求執行各項檢測作業。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "確認發電系統故障原因非變流器,進行電路查修。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "視需求執行帶電測試或測量,或檢查電路/機器/設備是否妥善隔離。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "確認案場環境是否具維修風險回報主管,依組織作業規範或風險管控措施並予以實施。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "按照步驟利用電路/儀器參數測量值及計算值執行疑難排解工作。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "視需求拆解電路/儀器元件,保存元件,防止損失或損壞,並記錄故障狀態內容。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "依程序採購與領取修理故障所需的材料/更換元件,測試故障排除作業的有效性。"
                  },
                  {
                    "code": "P2.1.8",
                    "text": "重新組裝儀器/設備,做最後測試,並準備恢復使用狀態。"
                  },
                  {
                    "code": "P2.1.9",
                    "text": "取得授權人員同意,安全處理意外情況。"
                  }
                ],
