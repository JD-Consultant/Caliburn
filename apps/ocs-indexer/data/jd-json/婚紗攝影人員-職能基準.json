        "ocu_code": "T1",
        "ocu_name": "執行婚紗攝影前置工作",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "了解新人攝影需求內容與日期"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "透過組織行銷,展示過去拍攝的作品讓新人挑選,與新人溝通形象與呈現方式。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "了解新人攝影架構,以確認相關需求,如婚紗或婚禮攝影、為棚內攝影或需搭配外景拍攝,並確認照片組數與預算。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "了解新人拍攝婚紗日期與婚禮日期,以便確認相關行程及作業安排。"
                  }
                ],
