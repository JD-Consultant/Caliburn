        "ocu_name": "協助婚紗攝影前預備工作",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "協助選擇場景及相關器材準備工作"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "協助婚紗攝影人員,建議適合場景地點(棚內及外拍),提供新人場景樣本選擇進行拍攝作業。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "協助攝影人員準備攝影器材及道具,包含帶位、布置場景、架設燈光、打光並先行測試、調整與檢視,確認器材均可正常運作,道具清潔無損。"
                  }
