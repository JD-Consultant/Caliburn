  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A03",
        "name": "自我提升：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與能力，並能有效應用在特定任務。"
      },
      {
        "code": "A04",
        "name": "自信心：在表達意見、做決定、面對挑戰或挫折時，相信自己有足夠的能力去應付；面對他人反對意見時，能獨自站穩自己的立場。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
