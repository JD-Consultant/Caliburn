  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "追求卓越：會為自己設定具挑戰性的工作目標並全力以赴，願意主動投注心力達成或超越既定目標，不斷尋求突破。"
      },
      {
        "code": "A04",
        "name": "彈性：能夠敞開心胸，調整行為或工作方法以適應新資訊、變化的外在環境或突如其來的阻礙。"
      },
      {
        "code": "A05",
        "name": "主動積極:不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A06",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上畢業，且具相關工作經驗2年以上。"
    ],
    "supplements": [
      "影響業務營運相關法規：如反歧視法規、道德原則、個資法、合約、職業安全衛生相關規範、產業相關法規及消費者法等。",
      "利益關係人：包含客戶、股東、董監事、上下游合作廠商等。"
    ]
  }
