  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "與客戶互動",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "提供服務給客戶"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據組織政策,以專業周到服務與客戶進行溝通,即時發現客戶其他需求。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依據相關法規及組織政策需求,滿足客戶的需求,並於必要時向主管報告。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "當客戶有立即需求時,能理解並依據組織政策,提供適切服務。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "正確記錄客戶服務內容與特殊需求。"
                  }
                ],
