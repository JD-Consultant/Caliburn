  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A02",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中（職）以上畢業。",
      "具2年以上室內裝修現場工作經驗。"
    ],
    "supplements": [
      "建築相關規範：如建築法、建築物室內裝修管理辦法、建築物使用類組及變更使用辦法、建築技術規則、建築物無障礙設施設計規範、公寓大廈管理條例",
      "等。",
      "水電消防相關規範：如用戶用電設備裝置規則、消防法、消防法施行細則、各類場所消防安全設備設置標準等。",
      "各工種：如木作、泥作、水電、油漆、空調、鐵件、壁紙、地毯及鋁門窗等。",
      "埋入式設備：如空調設備之風管與用水、用電、弱電、瓦斯管線等。",
      "文件：如材料出廠證明、產品使用證明書、商品驗證登錄證書、綠建材標章證書、「建築新技術、新工法、新設備及新材料認可通知書」等。"
    ]
  }
}