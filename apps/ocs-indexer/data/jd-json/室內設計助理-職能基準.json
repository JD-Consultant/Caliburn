  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A02",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高職以上室內設計、建築及景觀等相關科系畢業。",
      "完成相關職業訓練課程。"
    ],
    "supplements": [
      "建築相關規範：如建築法、建築物室內裝修管理辦法、建築物使用類組及變更使用辦法、建築技術規則、建築物無障礙設施設計規範等。",
      "水電消防相關規範：如用戶用電設備裝置規則、消防法、消防法施行細則、各類場所消防安全設備設置標準等。",
      "規範文件：如公寓大廈住戶規約、建築管理相關文件等。",
      "全套設計圖：如平面配置圖、天花板圖、剖立面圖、施工大樣詳圖、水電空調配置圖、燈具配置圖、色彩計畫表及3D圖等。",
      "建材表：如磁磚、布、油漆、地毯、燈具、板材、鐵件、五金配件及石材等。"
    ]
  }
}