        "ocu_name": "居家清潔",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "清潔室內"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "能分辨清潔劑功能,瞭解清潔劑使用方法及注意事項,並依家具、牆面、地板材"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "判別清潔室內標的物之材質與屬性,選用適當的清潔用品進行清潔與保養。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "選用適當清潔工具進行地板清潔(掃地/吸塵/拖地),並視客戶需求進行地板維護作業。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "選用適當的清潔用品及工具進行清潔門框、窗框、門把及家具相關金屬類製品,並視需求進行除鏽與保養。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "選用適當輔助工具及清潔用品進行高處清潔作業。"
                  }
                ],
