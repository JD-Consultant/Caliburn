  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A02",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A03",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A04",
        "name": "彈性：能夠敞開心胸，調整行為或工作方法以適應新資訊、變化的外在環境或突如其來的阻礙。"
      },
      {
        "code": "A05",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A06",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A07",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職以上相關科系畢業，且具3年以上相關工作經驗。"
    ],
    "supplements": [
      "家具使用型態：如置物櫃（書櫃／衣櫃／櫥櫃）、椅子（餐椅／扶手椅／沙發）、桌子（書桌／餐桌／工作桌）、床、戶外家具與辦公設備等。",
      "設計元素：如地方文化、使用慣性、流行趨勢、色彩、材質運用與尺度關係等。",
      "家具設計資訊：如外觀（顏色／尺寸／規格／圖案造型等）、功能（輔助性／多功能設計）、結構（安全性／強度）、使用材質（木製／金屬／石材）等。"
    ]
  }
}