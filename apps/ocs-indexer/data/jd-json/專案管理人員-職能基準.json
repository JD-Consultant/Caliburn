    "job_description": "執行及管控專案計畫，並確保專案能於規定時間完成設定目標，並管理專案成效。",
    "ocs_level": 3
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "專案管理企劃",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "發展專案章程"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "偕同專案主管與利益關係人(如客戶、供應商、贊助商等)溝通,並記錄專案需求。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依指示檢視專案合約及專案執行相關文件,判別並確認組織/利益關係人之專案"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "確認專案交付標的及可衡量之成果指標。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "釐清並協助擬定專案綱要,並向組織相關專案主管報告及取得同意。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "專案綱要"
                  }
                ],
