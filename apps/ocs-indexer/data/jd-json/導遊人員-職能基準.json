  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人維持良好關係。"
      },
      {
        "code": "A02",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔責任。"
      },
      {
        "code": "A03",
        "name": "責任心：設立定義明確且實際可行的個人目標；對於即時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "情緒管理：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式"
      },
      {
        "code": "A05",
        "name": "細心周到：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢，完成任務。"
      },
      {
        "code": "A07",
        "name": "上進心：隨時更新各景點、博物館等最新資訊，積極參與相關社團組織，強化自身專業能力。"
      },
      {
        "code": "A08",
        "name": "同理心：以對方的立場設想，嘗試理解對方提出的需求或行為背後的可能原因。"
      },
      {
        "code": "A09",
        "name": "職業倫理：維護職業形象，敬業守法，誠信為本。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中（職）以上畢業或同等學歷，或取得觀光署核發之導遊人員執業證。"
    ],
    "supplements": [
      "【註1】行程資料：包含行程表、航班資料、餐廳、住宿等資料。",
      "【註2】交接清單資料：包含合約、交通、食宿、責任保險、出團支出表等。。",
      "【註3】景點相關注意事項：如營業時間、天氣、路況相關資訊、特殊規範等。",
      "【註4】旅客個人特殊需求：如飲食、住宿、座位安排、無障礙設施需求等。",
      "【註5】相關單位：包含餐廳、旅館、交通工具、景點、博物館等。",
      "【註6】團員性質或屬性：如獎勵旅遊團、一般旅遊團、客製化旅遊團…等。"
    ]
  }
}