            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.3.1",
                    "text": "瞭解及執行帶團風險管理及緊急事故處理程序。"
                  },
                  {
                    "code": "P2.3.2",
                    "text": "旅程途中遇旅客身體狀況異常或受傷時,應適時安排就醫。若遇旅客拒絕就醫,應簽寫旅客拒絕就醫切結書。"
                  },
                  {
                    "code": "P2.3.3",
                    "text": "遇天候不佳、交通問題等不可抗力因素,需採取應變措施,調整行程時,應與每位旅客簽訂符合相關法規之行程變更同意書。"
                  },
                  {
                    "code": "P2.3.4",
                    "text": "依客訴作業流程,處理並記錄客訴問題。"
                  },
                  {
                    "code": "P2.3.5",
                    "text": "協助取得法定證明文件。"
                  },
                  {
                    "code": "P2.3.6",
                    "text": "依主管機關之規定向相關單位進行回報。"
                  },
                  {
                    "code": "P2.3.7",
                    "text": "遇旅客因個人因素選擇於行程期間自願放棄原團體行程,須請其簽訂放棄行程切結書。"
                  }
                ],
