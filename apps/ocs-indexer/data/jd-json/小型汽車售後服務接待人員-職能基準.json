              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "確認及整理邀約回廠名單,避免重複聯繫,並透過簡訊、外撥、電子郵件等,完成邀約或其他數位通訊。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "完成各種預約來源車輛統計,確認客戶回廠目的與預估相關時間、費用。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "聯絡客戶,核對檢修項目、時間、費用"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "各時段預約數量確認,提交廠內主管預排維修技師派工、零件備料作業。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "更新預約紀錄表(備料問題、日期),提交相關作業人員,確保預約車回廠能快速上工降低等候時間。"
                  }
