            "task_codes": [
              {
                "code": "T3.1",
                "name": "接待客戶與車輛內外觀確認"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "接待迎賓、指引車輛停放,主動招呼客戶並放置車輛內裝護具,提醒貴重物品取回。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "依檢修確認表內容,填寫車輛資訊,里程、故障燈號、油位。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "於車輛接待區與車主討論服務需求及外觀檢查,紀錄檢修確認表。"
                  },
                  {
                    "code": "P3.1.4",
                    "text": "依服務流程要求,移動車輛置頂車設備,進行車輛頂起作業。"
                  },
                  {
                    "code": "P3.1.5",
