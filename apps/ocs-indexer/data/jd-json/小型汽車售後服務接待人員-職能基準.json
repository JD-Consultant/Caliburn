        "ocu_name": "小型汽車售後服務前置準備工作",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "應用服務流程及系統資料"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據職場訓練計畫,應用汽車修護知識,包括服務流程、技術資料、顧客應對、估時估價。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依網際網路或修理手冊,取得必要的零件、工時之維修工作內容建議。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "閱讀維修技術資料,應用於問診邏輯判斷,推估可能問題點。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "熟悉各項電腦系統操作,確保車籍、個"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "確認並遵守政府法令及個資法,完成工單開立與交修確認。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "確認在安全工作條件下,評估派工程序與維修進度管理。"
                  }
