        "ocu_code": "T1",
        "ocu_name": "品質技術規劃與推動",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "協助建立品質技術制度"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依組織需求,蒐集並彙整國內外最新品質管理系統資訊。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依組織指示,參與車廠之品質相關會議,掌握車型之維修品質要求要件。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依車廠標準制度及組織品質技術政策,協助主管規劃品質技術制度、標準、流程與相關表單。"
                  }
