            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "依據組織核定後品質技術制度,協助推動及指導現場相關人員依循品質技術制度及宣導文宣安全規定。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "管控現場維修工作流程,並進行風險控制,以避免或降低品質不合格率。"
                  },
                  {
                    "code": "P1.2.3",
