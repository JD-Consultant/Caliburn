                "code": "T1.1",
                "name": "執行基本保養"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 2,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依技術人員指示確認所需保養項目、準備零組件,並選用正確的工具及設備。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "進行五保前置作業。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依技術人員指示及原廠汽車修護手冊,檢查汽車狀況。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依組織工作安全手冊、原廠汽車修護手冊及保養紀錄表,執行定期保養,並完成保養紀錄。"
                  }
