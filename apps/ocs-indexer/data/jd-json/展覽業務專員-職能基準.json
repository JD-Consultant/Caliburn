            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.4.1",
                    "text": "從事各種有助於形象推廣、展覽業務推廣的行銷活動。"
                  },
                  {
                    "code": "P2.4.2",
                    "text": "與行銷部門共同討論徵展行銷作法,如徵展文宣品與形象廣告內容。"
                  },
                  {
                    "code": "P2.4.3",
                    "text": "洽談徵展代理。"
                  },
                  {
                    "code": "P2.4.4",
                    "text": "洽談攤位交換。"
                  },
                  {
                    "code": "P2.4.5",
                    "text": "刊登徵展廣告。"
                  },
                  {
                    "code": "P2.4.6",
                    "text": "辦理徵展說明會。"
                  },
                  {
                    "code": "P2.4.7",
                    "text": "辦理國外推廣及徵展。"
                  },
                  {
                    "code": "P2.4.8",
                    "text": "行銷廣宣過程,恪遵永續會展政策與措施。"
                  }
                ],
                "outputs": [
