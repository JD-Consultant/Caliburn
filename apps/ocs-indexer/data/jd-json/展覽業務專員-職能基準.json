            ]
          },
          {
            "task_codes": [
              {
                "code": "T2.3",
                "name": "開發潛在參展廠商"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.3.1",
                    "text": "建立並維護客戶資料庫。"
                  },
                  {
                    "code": "P2.3.2",
                    "text": "根據資料庫的廠商資訊,主動針對潛在廠商進行電話訪談及招商工作。"
                  },
                  {
                    "code": "P2.3.3",
                    "text": "至國際相關展覽中參展,並針對本次展覽,邀約廠商參展,或是買主(B2B)前來觀展。"
                  },
                  {
                    "code": "P2.3.4",
                    "text": "分析近幾屆參展廠商不來參展原因。"
                  },
                  {
                    "code": "P2.3.5",
                    "text": "應用數位科技開發潛在客戶。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O2.3.1",
                    "name": "參展廠商開發名單"
                  }
                ],
