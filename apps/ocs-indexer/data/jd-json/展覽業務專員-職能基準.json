        "ocu_code": "T1",
        "ocu_name": "進行市場調查",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "搜集市場相關資訊"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "針對產業進行市場調查,以瞭解市場發展趨勢。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "協助蒐集相關產業資訊,提供主管開拓新展參考。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "徵詢相關廠商,對未來可能舉辦的新展其參與意願與建議。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "於未來開發新展中納入永續會展作法。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "國內外其他展覽競合分析。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "去年展覽檢討建議。"
                  },
                  {
                    "code": "P1.1.7",
                    "text": "檢視既有之展覽,推動轉型為永續會展。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "市場調查報告"
                  },
