              {
                "code": "T2.2",
                "name": "針對廠商進行展覽招商業務"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.2.1",
                    "text": "根據公司提供名單,以電話或親自拜訪的程序,向客戶溝通展覽相關訊息,並進行招商。"
                  },
                  {
                    "code": "P2.2.2",
                    "text": "對過去曾經參展的重要廠商聯繫,說服廠商參加本次展覽活動。"
                  },
                  {
                    "code": "P2.2.3",
                    "text": "對廠商寄發電郵文宣品或其他相關資訊。"
                  },
                  {
                    "code": "P2.2.4",
                    "text": "協助廠商與公司簽訂參展合約。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O2.2.1",
                    "name": "徵展進度報告"
