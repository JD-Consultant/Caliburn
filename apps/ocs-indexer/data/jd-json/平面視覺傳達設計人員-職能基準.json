  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A02",
        "name": "自信心：在表達意見、做決定、面對挑戰或挫折時，相信自己有足夠的能力去應付；面對他人反對意見時，能獨自站穩自己的立場。"
      },
      {
        "code": "A03",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A04",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中（職）以上畢業，並具2年以上作品設計相關工作經歷或具國際性設計類獲獎紀錄。",
      "參訓資格依各訓練單位規定。"
    ],
    "supplements": [
      "詳細設計資訊：如輸出使用材質、色彩、尺寸、處理方法及必要之圖案設計等。",
      "科技工具應用能力：如AI、chatGPT等科技應用能力。"
    ]
  }
