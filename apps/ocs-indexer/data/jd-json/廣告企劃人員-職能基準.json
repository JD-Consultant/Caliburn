  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A05",
        "name": "彈性：能夠敞開心胸，調整行為或工作方法以適應新資訊、變化的外在環境或突如其來的阻礙。"
      },
      {
        "code": "A06",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A07",
        "name": "冒險挑戰：在成敗後果不能確定的情境下，對成功機會少但成功後報酬高的事情勇於嘗試的傾向。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上畢業，且具4年以上廣告行銷相關工作經驗。"
    ],
    "supplements": [
      "相關法令規範：如廣告物管理辦法、個人資料保護法、智慧財產權、公平交易法與消費者保護法等。"
    ]
  }
