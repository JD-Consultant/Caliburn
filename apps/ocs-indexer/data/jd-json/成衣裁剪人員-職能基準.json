        "ocu_name": "確認拉布層與布料品質",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "取得馬克排版圖"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依組織規模及專業分工情形,向馬克專責單位取得馬克排版圖,或由裁剪人員進行馬克排版。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "解讀裁剪計畫,據此驗算布料總碼數是否足夠。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "分析用於馬克需要的裁剪順序。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "使用手工排馬克,以取得最經濟有效之布層馬克圖。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "依組織規模及訂單需求,取得或準備開裁通知單所需之排布層資訊。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "確定符合排布長度的裁床。"
                  }
