      {
        "ocu_code": "T3",
        "ocu_name": "運用甄選工具決定錄取人選",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T3.1",
                "name": "使用合適甄選工具與執行甄選"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "依照職務類別選擇合適的甄選工具,以產出合適且具參考價值的甄選資訊。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "依據用人主管的行程,規劃/安排面談時間、場次與場地,與應徵人選進行面試。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "在應徵人選與用人主管面試前,說明甄選流程與公司簡介,讓應徵人選了解與配合程序。"
                  },
                  {
                    "code": "P3.1.4",
                    "text": "視職務性質與需求,安排合適之專業測驗/職業適性測驗/語文測驗等。"
                  },
                  {
                    "code": "P3.1.5",
                    "text": "彙整甄選測試結果並進行解讀,提供用人主管決定人選。"
                  },
                  {
                    "code": "P3.1.6",
                    "text": "依需要進行背景調查,收集或驗證應徵人選先前工作表現評價與相關資訊。"
                  },
                  {
                    "code": "P3.1.7",
                    "text": "協助定期檢視甄選工具效益分析,以提升甄選信度、效度,確保甄選資訊之參考價值。"
                  }
