      {
        "ocu_code": "T2",
        "ocu_name": "運用徵才管道與搜尋履歷",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "確認與使用徵才管道"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "依據職務需求與求才時間,選擇內部或外部合適的徵才管道,確保徵才目標之達成。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "運用內部管道如離職人才回任、內部員工推薦、轉調機制、搜尋既有求職人才庫或累積之履歷名單等,從內部相關資源進行徵才。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "運用外部管道如人力銀行、校園徵才、獵才公司、產學合作等,從外部相關資源進行徵才。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "針對所選擇運用的徵才管道,定期檢視徵才管道效益分析,以提升徵才管道使用效益。"
                  }
                ],
