              {
                "code": "T1.1",
                "name": "船舶船名、航次追蹤"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "向船公司及貨主確認排程資訊,擬定船期計畫。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "審查與核對航線符合承攬時程區間。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "如有更新船期,能即時通知所有相關部門。"
                  }
                ],
