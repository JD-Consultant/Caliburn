    "job_description": "依照媒體廣告需求分配預算、投放渠道，於媒體廣告上線後持續追蹤後台數據，並根據期望目標制定相應的優化策略，提升媒體廣告效益。",
    "ocs_level": 3
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "規劃數位媒體廣告投放計畫",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "確認媒體廣告需求"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依媒體廣告目的及目標受眾選擇合適投放渠道,並分配媒體廣告預算。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "根據媒體廣告目的及投放渠道決定媒體廣告形式。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "充分理解組織/客戶媒體廣告目的及需求,並根據媒體廣告期望成效設定目標受眾。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依組織/客戶需求安排媒體廣告上線時間。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "將所有媒體廣告細節彙整至媒體廣告排程表(cue表),提供組織/客戶確認。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "媒體廣告排程表"
                  }
                ],
