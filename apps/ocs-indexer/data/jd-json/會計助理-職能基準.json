  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中（職）以上會計相關科系畢業；或具有1年以上相關工作經驗。"
    ],
    "supplements": [
      "財會稅務相關法規：TIFRS（國際會計準則） 、IFRSs（國際財務報表準則）、商業會計法、商業會計處理準則、稅法、洗錢防制法、公司法、證券交易法",
      "（公開發行公司適用）。",
      "財務報表：資產負債表、綜合損益表、權益變動表與現金流量表、財務資訊、各類政府規定之申報表及特殊需求報表等。"
    ]
  }
