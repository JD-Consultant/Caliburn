            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "正確穿戴安全防護裝備及遵守工地安全防護規定。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "檢查模板表面是否有附著泥土、木屑、水泥砂漿或其他雜物。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依據模板材質,選用專用脫模劑並塗佈模板表面。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "施工前詳讀施工圖說,並備妥模板相關材料。"
                  }
                ],
