        "ocu_code": "T2",
        "ocu_name": "組立各種混凝土澆置用模板",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "組立柱模板"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "檢查地坪放樣墨線是否清晰正確無誤。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "檢查模板組立範圍內無任何廢棄物。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "訂製墊板,墊板內側與柱墨線切齊。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "組立過程以斜繫材拉固模板,並校正垂直度。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "柱模板各面之背撐角材,先以鐵釘固定,再以鐵扣器、螺桿等繫節器緊結繫固。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "若須設立斜支柱時,先於地板或板上釘一塊墊木,再將支柱固定。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "組立完成後核對高程是否無誤。"
                  },
                  {
                    "code": "P2.1.8",
                    "text": "核對垂直精度是否符合混凝土構造物許可誤差內。"
                  },
                  {
                    "code": "P2.1.9",
                    "text": "柱模板須留出清潔口,並於清潔完成後封閉。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O2.1.1",
                    "name": "模板自主檢查紀錄"
                  }
                ],
