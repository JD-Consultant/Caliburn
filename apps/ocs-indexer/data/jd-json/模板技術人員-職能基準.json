          {
            "task_codes": [
              {
                "code": "T2.2",
                "name": "組立牆模板"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.2.1",
                    "text": "先組立單面模,以斜撐固定之,同時調整垂直度,並核對高程是否無誤。"
                  },
                  {
                    "code": "P2.2.2",
                    "text": "檢查模板組立範圍內無任何廢棄物。"
                  },
                  {
                    "code": "P2.2.3",
                    "text": "組立開口預留尺寸,確認位置是否無誤。"
                  },
                  {
                    "code": "P2.2.4",
                    "text": "待鋼筋及配管完成後,確認牆厚度,放置模板間隔器。"
                  },
                  {
                    "code": "P2.2.5",
                    "text": "雙面模板站立完成後,以螺桿及相關緊結器固定,加固模板。"
                  },
                  {
                    "code": "P2.2.6",
                    "text": "設立斜撐先於地板或板上釘一塊墊木,再將支柱固定。"
                  },
                  {
                    "code": "P2.2.7",
                    "text": "核對垂直精度是否符合混凝土構造物許可誤差內。"
                  },
                  {
                    "code": "P2.2.8",
                    "text": "牆模板每一區內牆約6公尺須留一處15*45公分之清潔口,並於清潔完成後封閉。"
                  }
                ],
