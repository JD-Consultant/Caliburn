      {
        "ocu_code": "T2",
        "ocu_name": "協助組",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "協助組立柱模\n板"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "協助檢查模板組立範圍內無任何廢棄物。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "協助檢查地坪放樣墨線標示位置及尺寸。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "協助訂製墊板,墊板內側及柱墨線切齊。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "待鋼筋及配管完成後,確認柱尺寸,協助放置模板間隔器。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "組立過程協助以斜繫材拉固模板,並校正垂直度。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "協助柱模板背面之背撐角材,先以鐵釘固定,再以鐵扣器、螺桿等繫節器緊結繫固。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "若須設立斜支柱時,協助先於地板或板上釘一塊墊木,再將支柱固定。"
                  },
                  {
                    "code": "P2.1.8",
                    "text": "組立完成後協助核對高程是否無誤。"
                  },
                  {
                    "code": "P2.1.9",
                    "text": "協助核對垂直精度是否符合混凝土構造物許可誤差內。"
                  },
                  {
                    "code": "P2.1.10",
                    "text": "協助清潔口,於清潔完成後封閉。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.2.1",
                    "name": "自主檢查表"
                  }
                ],
                "knowledge": [
                  {
