            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.3.1",
                    "text": "協助檢查模板組立範圍內無任何廢棄物。"
                  },
                  {
                    "code": "P2.3.2",
                    "text": "協助樑底板設置前應確認其正確位置。"
                  },
                  {
                    "code": "P2.3.3",
                    "text": "協助製作樑底板,並吊起樑底板固定於兩端柱模承口上。"
                  },
                  {
                    "code": "P2.3.4",
                    "text": "協助組立支撐構件頂部加墊角材,並以鐵釘固定。"
                  },
                  {
                    "code": "P2.3.5",
                    "text": "協助樑兩端引水線校正貫通部分是否垂直,架設時是否凹陷不平。"
                  },
                  {
                    "code": "P2.3.6",
                    "text": "協助組立側板,在模板外加背撐材,並穿孔繫固。"
                  }
