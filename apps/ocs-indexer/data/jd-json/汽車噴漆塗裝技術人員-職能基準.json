            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "遵照職業安全衛生相關規範,選用及穿戴安全衛生防護器具。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "判別基材屬性及表面狀態,並確認所需基材處理項目及程序。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "依維修工作單、基材屬性與表面狀況,檢視並選用適切機具設備及物料、材料,計算消耗用量。"
                  },
                  {
                    "code": "P1.2.4",
                    "text": "依施工範圍及施作方法,選用適當遮蔽材料,進行車身防塗遮蔽作業。"
                  },
                  {
                    "code": "P1.2.5",
                    "text": "依職業安全衛生相關規範、工作場域規範與維修工作單,完成施工環境及保護措施的準備工作。"
                  },
                  {
                    "code": "P1.2.6",
                    "text": "判定並選用能減少廢棄物料的程序。"
                  },
                  {
                    "code": "P1.2.7",
                    "text": "在工作時,確認並使用最有效的能源程序。"
                  }
