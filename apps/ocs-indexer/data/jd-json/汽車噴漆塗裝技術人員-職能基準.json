              {
                "code": "T1.3",
                "name": "表面前處理(基材處理)"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.3.1",
                    "text": "依據相關技術資料要求、維修工作單,確認基材處理項目及程序,進行表面清潔除汙、除漆、除鏽、補土、打磨、整平或填孔等作業。"
                  },
                  {
                    "code": "P1.3.2",
                    "text": "確認基材屬性,依據相關技術資料材料特性要求,選擇合適機具設備及所需材料,並完成材料紀錄表。"
                  },
                  {
                    "code": "P1.3.3",
                    "text": "進行表面處理作業,透過研磨機打磨,確保表面汙損、殘漆或鏽蝕已清除。"
                  },
                  {
                    "code": "P1.3.4",
                    "text": "進行板件表面漆料塗層確認,選用合適研磨機具及號數砂紙,進行羽狀邊研磨。"
                  },
                  {
                    "code": "P1.3.5",
                    "text": "依據材料特性,選用正確工具、填補劑及劑量進行調合,完成補土整平作業。"
                  },
                  {
                    "code": "P1.3.6",
                    "text": "進行補土乾燥確認,選用合適研磨機具及號數砂紙,進行外觀整平作業。"
                  }
