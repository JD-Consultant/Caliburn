            ],
            "competency_blocks": [
              {
                "competency_level": 4,
                "indicators": [
                  {
                    "code": "P2.3.1",
                    "text": "依據維修技術資料的步驟及工具要求,視需求進行系統斷電處理。"
                  },
                  {
                    "code": "P2.3.2",
                    "text": "依據維修技術資料的拆除步驟及工具要求,拆卸車內、外飾板、配件、托架等。"
                  },
                  {
                    "code": "P2.3.3",
                    "text": "依據維修技術資料安裝配線,確保線束固定牢固,以避免線束與其他配件產生干涉。"
                  },
                  {
                    "code": "P2.3.4",
                    "text": "應用電路圖電路符號、配線代碼、圖示,進行配線或端子搭接,並完成絕緣防護。"
                  },
                  {
                    "code": "P2.3.5",
                    "text": "安裝多媒體影音系統,安裝過程須確認定位卡榫、螺絲、平整度、飾板安裝縫隙是否完整。"
                  },
                  {
                    "code": "P2.3.6",
                    "text": "安裝完畢,使用儀器測試影音系統,檢查各項影音功能是否正常。"
