              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據職場訓練計畫,應用汽車租賃產品知識,包括政府法令、稅務、規章、車輛設計。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "閱讀並了解汽車租賃法規及汽車租賃定型化契約。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "應用網際網路或顧客管理系統,取得車輛產品知識及客戶資料分析。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "閱讀產險相關知識,視需求取得保險代理"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "了解汽車相關性能及功能,並能操作相關配備及駕馭車輛。"
                  }
