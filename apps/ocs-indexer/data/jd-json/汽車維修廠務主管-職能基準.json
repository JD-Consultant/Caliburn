            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "向相關團體和個人諮詢欲分配的工作和可運用的資源。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "按營運計畫發展工作計畫,以具有效率、成本效果和目標成果的方式分配工作。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "與相關維修廠務團隊和個人確認績效標準、工作守則和工作產出。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "在開始工作之前列出個人績效結果面、行為面指標,與相關人員發展並同意績效指"
