  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A03",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A04",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "具1年以上相關工作經歷。"
    ],
    "supplements": [
      "【註1】防護遮蔽：如車體塑件、膠件、電鍍件與有機溶劑藥劑塗抹或拋光時易受損之零配件保護等。",
      "【註2】鍍膜種類：包含樹脂類、氟素類、石英類、類玻璃纖維素等。"
    ]
  }
