  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "持續學習：能夠展現持續學習的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A02",
        "name": "自信心：在表達意見、做決定、面對挑戰或挫折時，相信自己有足夠的能力去應付；面對他人反對意見時，能獨自站穩自己的立場。"
      },
      {
        "code": "A03",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A04",
        "name": "追求卓越：會為自己設定具挑戰性的工作目標並全力以赴，願意主動投注心力達成或超越既定目標，不斷尋求突破。"
      },
      {
        "code": "A05",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A07",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專院校以上畢業，且具5年以上相關工作經驗。"
    ],
    "supplements": [
      "【註1】法令規範：如公平交易、廣告物管理辦法、個人資料保護法、智慧財產權及勞動相關法規等。"
    ]
  }
