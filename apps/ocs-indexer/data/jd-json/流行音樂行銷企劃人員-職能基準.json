    "attitudes": [
      {
        "code": "A01",
        "name": "開放彈性喜愛挑戰：能夠敞開心胸，調整行為或工作方法以適應新資訊、變化的外在環境或突如其來的阻礙。"
      },
      {
        "code": "A02",
        "name": "領導統籌能力：有效組織、協調和管理資源以實現共同目標的能力。"
      },
      {
        "code": "A03",
        "name": "解決問題：能在必要時採取行動，以有效釐清模糊不清的態勢，完成任務。"
      },
      {
        "code": "A04",
        "name": "聆聽理解：對他人表現理解、友善、同理心、關心和禮貌。"
      },
      {
        "code": "A05",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A06",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A07",
        "name": "擅長溝通：能迅速了解溝通對象不同的需求，並且給出相對應的回答，營造和諧有效率的對話環境。"
      },
      {
        "code": "A08",
        "name": "對流行文化的喜好與熱忱：對於投入流行文化有著高度的興趣，並且會積極主動地去面對克服所碰到的挑戰。"
      },
      {
        "code": "A09",
        "name": "工作積極細心敏銳：對於事務細節積極掌握，並能快速精準地應對局勢變化。"
      },
      {
        "code": "A10",
        "name": "效率高：能以最短時間、最低成本的方式給予手上的工作最佳的安排。"
      },
      {
        "code": "A11",
        "name": "排解壓力的能力：能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A12",
        "name": "好奇開放：容易受到複雜新穎的事物吸引，且易於接受新觀念的傾向。"
      },
      {
        "code": "A13",
        "name": "團隊合作：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A14",
        "name": "創意思考：對於既有的思考模式能適時地創造不同的切入角度，並激發出新的構思。"
      },
      {
        "code": "A15",
        "name": "學習力：能迅速跟進學習新創相關知識或技術，並且快速恰當的融入業務執行內容。"
      }
    ]
