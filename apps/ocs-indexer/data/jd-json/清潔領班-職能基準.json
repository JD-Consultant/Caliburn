              {
                "code": "T1.1",
                "name": "協助招募清潔人員"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "盤點工作人力需求,依組織人員遴選規定,建議召募清潔人員之能力條件及人數。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依組織人員遴選規定,進行求職者遴選作業程序。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依遴選結果擇定符合召募條件人員,轉由組織人資單位依勞動基準法規定進行聘僱程序。"
                  }
                ],
                "outputs": [
