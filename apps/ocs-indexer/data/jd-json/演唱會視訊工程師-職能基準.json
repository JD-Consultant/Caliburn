  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "工作熱忱：因為喜歡從事某件事情而主動去做，並且會積極主動地去面對克服所碰到的挑戰。"
      },
      {
        "code": "A02",
        "name": "溝通協調：於工作中，引導各參與單位之積極性，並妥善處理各單位之溝通協調，使其減少摩擦。"
      },
      {
        "code": "A03",
        "name": "抗壓性高：遇到緊急事件時，願意全力以赴，以完成交付任務為第一優先。"
      },
      {
        "code": "A04",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A05",
        "name": "團隊意識：為了實現某一目標而由相互協作的個體所組成的正式群體，彼此皆有共同的理念與信念完成交辦任務。"
      },
      {
        "code": "A06",
        "name": "應變能力：面對意外事件等壓力，能迅速地做出反應，並尋求合適的方法，使事件得以妥善解決的能力。"
      },
      {
        "code": "A07",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A08",
        "name": "科技趨勢：對兩岸與國際的科技發展要有所關注，不斷吸收新知。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職 （同等學力） 以上之電子、電機及其他相關科系畢業者，並具備三年以上演唱會視訊工程相關領域實務經驗及熟悉電腦操作。"
    ],
    "supplements": [
      "建議應用端應用此職能基準，仍須依循主管機關對於所轄產業之相關法令規範要求。"
    ]
  }
}