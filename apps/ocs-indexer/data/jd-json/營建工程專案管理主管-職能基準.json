            "competency_blocks": [
              {
                "competency_level": 5,
                "indicators": [
                  {
                    "code": "P4.1.1",
                    "text": "依照營建工程需求確認材料。"
                  },
                  {
                    "code": "P4.1.2",
                    "text": "選擇材料時應考慮其安全性、防火等級、可用性與成本。"
                  },
                  {
                    "code": "P4.1.3",
                    "text": "選擇材料時應考慮其短期與長期衰變對營建工程生命週期的影響。"
                  },
                  {
                    "code": "P4.1.4",
                    "text": "準備替代材料,以防材料無法取得或不適合。"
                  },
                  {
                    "code": "P4.1.5",
                    "text": "確認現場查核材料的儲存、接收與安全處置,並查核材料的可適性及品質。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O4.1.1",
                    "name": "材料測試紀錄/報告"
                  }
                ],
