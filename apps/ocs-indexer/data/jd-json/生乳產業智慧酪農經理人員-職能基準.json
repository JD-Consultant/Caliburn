              }
            ],
            "competency_blocks": [
              {
                "competency_level": 5,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "掌控管理乳牛場各生產階段:彙整個體牛隻配種與繁殖資訊管理、乳牛場資訊紀錄、牛隻品種名稱與數量紀錄。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "掌握飼料進料、用料管理與飼料調配,瞭解智慧化餵飼設備完全混合日糧(TMR),對於個別牛隻進食狀況、健康與產乳量之影響。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "掌握生乳DHI報表紀錄與個別牛隻健康狀況之關聯性。"
