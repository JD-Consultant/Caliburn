  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，而臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A03",
        "name": "彈性：能夠敞開心胸，調整行為或工作方法以適應新資訊、變化的外在環境或突如其來的阻礙。"
      },
      {
        "code": "A04",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能慎考量及處理所有细節，精確地视每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A06",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "大專以上畢業或一年以上工作經驗，且具備電腦基礎操作能力。"
    ],
    "supplements": [
      "直播平台：常見的直播平台如Facebook Live、YouTube Live、Twitch、Google Meet、Teams、Webex等。",
      "直播軟體：常見的直播軟體如OBS Studio (Open Broadcaster Software)、XSplit Broadcaster、vMix等。",
      "直播設備：如導播機、視訊鏡頭、攝影機、視訊擷取器、電腦、手機、平板、收音設備、混音器、燈光、腳架、網路設備等。",
      "場地佈置：包括佈置背景、燈光、桌椅或道具等，確保場景符合直播主題和風格。"
    ]
  }
