  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A05",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "本項職能基準之產業職務名稱通稱「助理工程師」，為避免與「專門職業及技術人員考試法」第二條專門職業及技術人員定義造成混淆，故職能基準名稱採用「助",
      "理工程人員」。",
      "高中職工程群科畢業，或具1年以上工作經驗。"
    ],
    "supplements": [
      "長度量具：包含游標卡尺、分厘卡、缸徑規、量表、塊規、高度規、測長儀、三次元量床、雷射干涉儀、雷射掃描儀等。",
      "角度量具：包含量角器、角尺、直角規、角度量規、錐度量規、組合角尺、水平儀、角度塊規、三次元量床、光學投影機、工具顯微鏡、雷射干涉儀、自動",
      "視準儀、雷射準直儀等。",
      "比對量具：包含塞規、環規、卡規、錐度樣規、螺紋樣規、長度樣規、深度樣規、栓槽規、配對樣規、厚薄規、線規、鑽頭規、孔徑規、輪廓樣規、半徑",
      "規、節距規、齒形規等。",
      "表面形貌：包含光學平板、表面粗糙度量測儀、輪廓量測儀、真圓度量測儀、光學投影機、工具顯微鏡、三次元量床、齒型量測機、凸輪軸量測儀等。"
    ]
  }
}