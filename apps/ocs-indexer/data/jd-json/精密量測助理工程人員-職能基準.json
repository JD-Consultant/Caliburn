            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確認並使用處於校驗合格狀態的量具。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依工程人員及圖面指示,選用正確的量測儀器設備。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "使用長度量具、角度量具、比對量具、表面形貌等量測儀器,確認量測工件是否符合檢驗基準。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依量測需求,使用相關量測設備,確認量測物件是否符合檢驗基準。"
