                "name": "巡邏保全區域【註1】"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依業主需求於保全區域進行常態性巡邏,以確保區域安全。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "監視門禁、檢查設備、監控閉路電視、查驗進出人員和公共區域是否異常。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "巡檢中發現可疑人員或公共區域異常(如火災、設備損壞),立刻聯繫相關單位並依緊急事件處理流程處理當下情況。"
                  }
