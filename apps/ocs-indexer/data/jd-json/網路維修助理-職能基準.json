  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "診斷與維護網路系統及設備",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "診斷故障"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "了解網路架構及網路設備運作情形,以軟體測量網路狀況,找出網路故障原因。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "逐步隔離可能造成故障的變數,以測試網路障礙原因。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "告知客戶需修正故障的選項及維修需停機"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "與客戶說明於服務協議中,不收費及收費項目之費用。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "問題診斷報告"
                  }
                ],
                "knowledge": [
                  {
                    "code": "K01",
                    "name": "故障找尋技術與測試設備"
                  },
                  {
                    "code": "K02",
                    "name": "安全要求與標準"
                  },
                  {
                    "code": "K03",
                    "name": "客戶工作場域環境與實務"
                  },
                  {
                    "code": "K04",
                    "name": "網路架構與原廠設備規格"
                  }
                ],
