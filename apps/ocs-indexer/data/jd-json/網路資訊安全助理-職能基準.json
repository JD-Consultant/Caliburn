        "ocu_name": "協助建置與測試網路伺服器安全",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "準備網路伺服器安全執行"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依照場地特定安全要求以及職業安全衛生規範,準備各項工作事項。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "在網路資訊安全人員的指導下,找出安全危害並協助執行風險管制措施。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依據專案計畫與變更管理程序,相關技術團隊進行工作協調確保團隊間資訊透明化與工作同步化,將協調結果納入活動執行紀錄。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "執行建置變更前,進行網路伺服器備份,並填寫相關活動執行紀錄。"
                  }
                ],
                "outputs": [
                  {
