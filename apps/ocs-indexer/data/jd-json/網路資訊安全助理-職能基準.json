          {
            "task_codes": [
              {
                "code": "T1.2",
                "name": "建置網路伺服器安全機制"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "在網路資訊安全人員指導下,升級網路伺服器。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "建置登入所需的網路驗證授權與帳號服務,以進行授權使用者、群組或網路的存取限制。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "依照設計要求,執行相關加密作業。"
                  },
                  {
                    "code": "P1.2.4",
                    "text": "建置網路連線服務之安全選項以及遠端存取。"
                  },
                  {
                    "code": "P1.2.6",
                    "text": "建置作業系統或第三方防火牆,以便能依照安全要求過濾流量。"
                  },
                  {
                    "code": "P1.2.7",
                    "text": "確認伺服器記錄檔與登入伺服器的安全均能適當執行以求系統完整性,並於前述作業完成後,填寫網路伺服器建置紀錄。"
                  },
                  {
                    "code": "P1.2.8",
                    "text": "執行備份與復原程序,以啟動災害時的還原功能。"
                  }
                ],
