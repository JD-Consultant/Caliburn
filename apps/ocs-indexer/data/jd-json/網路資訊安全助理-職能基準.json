          {
            "task_codes": [
              {
                "code": "T1.3",
                "name": "監控與測試網路伺服器安全"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.3.1",
                    "text": "在網路資訊安全人員指導下,測試網路伺服器,以評量網路伺服器安全。"
                  },
                  {
                    "code": "P1.3.2",
                    "text": "檢視網路伺服器日誌檔、網路流量與開放通訊埠以偵測可能的入侵。"
                  },
                  {
                    "code": "P1.3.3",
                    "text": "監控重要檔案,以檢視未經授權的修改。"
                  },
                  {
                    "code": "P1.3.4",
                    "text": "調查並確認可疑的網路伺服器或資料安全違規。"
                  },
                  {
                    "code": "P1.3.5",
                    "text": "在網路資訊安全人員指導下,依照安全性原則與程序將安全性漏洞修復、通報並製作監控報告。"
                  },
                  {
                    "code": "P1.3.6",
                    "text": "依指示,協助檢視監控報告,以執行並測試維持網路服務安全性所需的改善作業。"
                  }
