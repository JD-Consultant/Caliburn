            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "依照作業規範開啟AOI主機與控制系統,並確認系統正常載入。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "根據定期點檢表,檢查設備,如平台移動、滑軌與氣壓系統是否穩定運作等事項。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "依作業規範及需求,視需要清潔鏡頭、相機、光源模組,移除灰塵與油污,以確保影像品質。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "依據週期性保養計畫,如更換濾光片、冷卻風扇、燈泡等耗材,並填寫保養紀錄。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "發現異常時,依設備異常通報流程報修,並標示設備狀態。"
                  }
                ],
                "outputs": [],
