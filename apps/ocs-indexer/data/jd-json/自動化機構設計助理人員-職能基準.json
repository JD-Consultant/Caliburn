  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A02",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "追求卓越：會為自己設定具挑戰性的工作目標並全力以赴，願意主動投注心力達成或超越既定目標，不斷尋求突破。"
      },
      {
        "code": "A05",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A06",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職機械或電機相關科系以上畢業。",
      "機械領域相關工作經驗1年以上，或曾接受機械工程職業訓練900小時以上者。"
    ],
    "supplements": [
      "工程圖種類：如組立圖、零組件圖、詳細圖等。",
      "製圖工具：如電腦、規尺等。",
      "產品設計實務輔助工具：如CAD/CAM/CAE軟體、模擬軟體、動畫軟體等工具的操作。",
      "相關技術文件：如作業標準程序書、操作說明書、機械工安規範等。"
    ]
  }
