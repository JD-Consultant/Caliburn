  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "檢查與保養自行車",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "執行檢查與保養"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "接待顧客,並協助顧客確認需求,檢查自行車各系統。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "確認顧客之車架材質與保養項目需求,並檢查自行車各系統與零組件耗損狀況。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "確認自行車各系統與零組件狀況後,向顧客說明並確認保養項目與費用,並填寫紀錄表及估價單。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依保養手冊/保養紀錄,執行自行車拆解/組裝,並選用適切保養方式,指導或執行保養作業。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "保養後,進行測試並完成紀錄表。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "檢查紀錄表"
