    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "製作及督導船舶貨櫃/貨物裝載規劃",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "規劃船舶排艙"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "決定貨櫃/貨物在船舶上的存放位置和裝卸港順序,達到排艙最佳化。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "考量特殊貨櫃/貨物裝卸過程以及船舶上放置的位置。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "掌握特殊貨櫃屬性,完善冷涷櫃、危險櫃、超規格貨櫃(OOG)等的配載規劃。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "艙位均衡及充份利用,使船體受力均衡。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "確認船期及船班符合委託人需求。"
                  }
                ],
