                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "確認蒐集市場資訊目的、需求與數據途徑。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依組織產品定位或客戶需求,蒐集市場資訊及行銷相關法令規範【註1】,並判別所獲得資訊的適用性及可用性。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "蒐集行銷活動歷史資訊(如銷售數據及行銷成果報告等)。"
                  }
