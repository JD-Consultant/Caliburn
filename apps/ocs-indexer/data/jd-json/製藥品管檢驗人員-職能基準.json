      {
        "ocu_code": "T2",
        "ocu_name": "管理實驗室偏差",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T2.1",
                "name": "分析與檢驗偏差"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "對經通報的偏差事件,能以適合的調查方法,找出造成偏差的可能或根本原因。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "依GMP法規、檢驗標準程序、設備規格、實驗室品質系統等,識別出與其不符合的事件,並加以記錄。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "依偏差事件的性質、偏差的範圍、影響品質的程度及造成的影響等狀況,將偏差依分類標準,加以分類。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "依偏差事件所造成的風險,判定風險等級,提出並進行立即處理措施、矯正或預防行動,且持續追蹤改善狀況。"
                  }
                ],
