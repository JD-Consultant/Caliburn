  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "建立風險評估作業與程序",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "辨識危害與潛在的可操作性問題"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "建置生產機構中有關機器、設備、作業、與動線規劃、產品與材料等日常操作程序描述。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "建置查核清單,包含與日常操作程序相關的製程參數(主要關鍵字)與引導字(次要關鍵字)。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "使用已建置的日常操作程序描述與查核清單,辨識危害、控制措施和潛在的可操作性問題,或控制措施可能發生的故障問題。"
                  }
                ],
                "outputs": [
