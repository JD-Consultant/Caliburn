        "ocu_name": "腳型丈量",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "釐清客戶需求"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據客戶提供圖片、鞋子或說明,蒐集客戶需求鞋款及材質等資訊。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "提供客戶相關鞋款照片或實體鞋,與客戶溝通並確認需求楦型、款式、材料、顏色、特殊紋飾、鞋底工藝配件或提供專屬刻字服務等資訊。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依客戶確認後需求,提供初步參考報價及工時。"
                  }
                ],
