      {
        "ocu_code": "T1",
        "ocu_name": "分析訓練需求",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "調查與分析訓練需求"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "能依據產業發展與組織現況,蒐集產業發展、人力需求與職能條件之資料並進行分析,找出人力/職能缺口及訓練需求。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "找出產業或組織之利益關係人,徵詢其對標的人力/職能之產業需求情況、以及職能規格之具體意見或建議。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "分析現今產業或組織所需關鍵人才類型、確認組織或產業現況之人力/職能缺口或落差,並具發展教育訓練之需求。"
                  }
                ],
                "outputs": [
