          {
            "task_codes": [
              {
                "code": "T1.3",
                "name": "客戶管理"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.3.1",
                    "text": "將客戶名冊分類建檔,並建立拜訪、聯絡紀錄。"
                  },
                  {
                    "code": "P1.3.2",
                    "text": "依據客戶屬性分層管理,並提供差異化服務。"
                  },
                  {
                    "code": "P1.3.3",
                    "text": "在適法合規前提下,回報客戶意見與狀況,作為市場分析依據。"
                  },
                  {
                    "code": "P1.3.4",
                    "text": "遭遇市場或客戶異常狀況時,迅速將問題回報,採取適法合規措施積極處理。"
                  },
                  {
                    "code": "P1.3.5",
                    "text": "善用多元工具,有效進行客戶資訊交換與管理,強化服務效率與品質。"
                  },
                  {
                    "code": "P1.3.6",
                    "text": "重視各項相關作業流程與操作品質,降低稽核事件發生率。"
                  }
                ],
