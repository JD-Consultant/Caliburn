            "task_codes": [
              {
                "code": "T2.1",
                "name": "裝卸貨物/貨櫃的文件準備"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.1.1",
                    "text": "確認貨運單資訊及貨櫃編號。"
                  },
                  {
                    "code": "P2.1.2",
                    "text": "依貨運單/系統,完成裝卸櫃作業。"
                  },
                  {
                    "code": "P2.1.3",
                    "text": "依貨運單/系統,完成進口(卸)、出口(裝)、翻艙等裝卸櫃量紀錄。"
                  },
                  {
                    "code": "P2.1.4",
                    "text": "進出口報單(CustomsDeclaration),海關申請進出口品名、數量、價值,申請通關繳納稅費,進口填寫報單檢附文進、商業發票裝箱單,出口填寫報單檢附裝貨單或託運單、裝箱單及出口許可證。"
                  },
                  {
                    "code": "P2.1.5",
                    "text": "商業發票(Commerciallnvoice),買賣雙方正式商業文件,列出貨物名稱、數量、單價、總價、付款方式,用於證明交易真實性貨物價值參考文件。"
                  },
                  {
                    "code": "P2.1.6",
                    "text": "裝箱單(PackingList),裝箱單列出包裝方式、件數、重量、公證等資訊,便於海關查驗。"
                  },
                  {
                    "code": "P2.1.7",
                    "text": "進出口貨物自動化連線報關後,分別報單核定為C1(免審免驗)C2(文件審核)C3(貨物查驗)。"
                  }
                ],
