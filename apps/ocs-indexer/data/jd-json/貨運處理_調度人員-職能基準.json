        "ocu_code": "T1",
        "ocu_name": "處理及安排託運物品",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "協調搬運準備事宜"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "到達現場後,選擇適當的搬運設備與材料,並諮詢客戶安排託運物品工作區域。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "根據工作場域規範,諮詢託運人並核對文件與託運物品、數量、包裝槽識是否齊全一致。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "根據工作場域規範,在包裝與運送區進行保護措施。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依工作場域政策,檢查客戶是否準備拆卸特定物品。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "確認搬運路線及貨運物品對載具的影響,並檢查地板、路徑/樓梯,以確保排除障礙物和危險。"
                  }
                ],
