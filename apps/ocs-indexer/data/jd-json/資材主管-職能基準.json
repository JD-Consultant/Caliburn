              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "向利益關係人溝通,確認談判之目的、目標與底線,以掌握採購與談判情境。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "監督團隊進行供應商資訊蒐集,並發展最佳選項,以進行合約的談判計畫。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "決定談判的流程、時間範圍與策略,確保談判的周全性。"
