            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "評估組織內部資訊設備需求,協助進行採購。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依需求規格(如效能、資安合規性等)篩選供應商,並協助評估採購設備。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "驗收新添置資訊設備,登記資產編號、規格與保固等資訊。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "設備上線或授權使用前,應完成資安設定。"
