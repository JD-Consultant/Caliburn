          {
            "task_codes": [
              {
                "code": "T1.2",
                "name": "實施並測試變更計畫"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "根據網路工程策略,執行網路變更時,須以對客戶流量影響最少的方式,並遵循職業安全衛生相關規範。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "執行新安裝設備的整合測試,以確保和現有設備及網路可交互運作。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "執行性能測試,以評估製造商規格及企業驗收測試程序中所陳述的效能。"
                  },
                  {
                    "code": "P1.2.4",
                    "text": "分析測試結果,並根據企業程序修正問題或升級,啟動品質保證程序。"
                  },
                  {
                    "code": "P1.2.5",
                    "text": "準備測試報告,說明企業內的適合使用區域。"
                  }
