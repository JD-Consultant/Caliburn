      {
        "ocu_code": "T1",
        "ocu_name": "對客戶影響最小的方式執行網路變更計畫",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "網路變更前置作業"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "取得並遵循執行工作時所需之相關規範。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "與相關人員評估工作順序並找出計畫改變對網路的可能效應及對客戶的影響。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "制定網路工程策略,包括中斷的管理,並使網路操作中心(NOC)參與其中。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "根據企業實務,準備和產出網路變更計畫文件。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "變更計畫文件"
                  }
                ],
