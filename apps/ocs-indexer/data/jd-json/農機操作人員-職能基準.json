    "job_description": "從事農事活動者 （包括一般農民、從事機械耕作服務者或有志投入農業的初入農民等），能夠掌握農機操作風險，理解農機基本原理及結構。從\n選用適當農機、熟悉正確操作流程到進行例行保養與簡易故障排除，達到農機運用有效性及人員操作安全性。",
    "ocs_level": 4
  },
  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": ".農機安全基礎概念",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "一般安全注意事項"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "操作農機時保持精神良好,並根據環境狀況等變數,評估農機操作安全性及使用適當時機。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "瞭解一般農機作業方法,並遵守安全注意事項,如在農機運作時,避免接觸危險區域。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依據不同農機種類,正確穿戴防護服裝及設備,如使用割草機時,穿戴安全帽、護目鏡、耳塞、圍裙、長筒雨鞋與手套等。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "評估個人體力與田間環境狀況"
                  },
                  {
                    "code": "O1.1.2",
                    "name": "瞭解一般安全操作守則與農機危險"
                  },
                  {
                    "code": "O1.1.3",
                    "name": "穿戴正確防護配備及適當衣著"
                  }
                ],
