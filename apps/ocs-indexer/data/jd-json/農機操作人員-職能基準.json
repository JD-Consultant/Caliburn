            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.2.1",
                    "text": "使用農機後,上路前應清理附著土壤,並清理輪胎土堆及掉落於道路上之落土。"
                  },
                  {
                    "code": "P1.2.2",
                    "text": "行駛於道路時,農用膠輪式機械(如曳引機、農用搬運車等)掛有農機號牌,並備有農業機械使用證及小客車駕駛執照。"
                  },
                  {
                    "code": "P1.2.3",
                    "text": "行駛於道路慢車道或靠右行駛;行駛速度符合車速規定,並附有農業機械照明設備或裝置。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.2.1",
                    "name": "清理農機落土"
                  },
                  {
                    "code": "O1.2.2",
                    "name": "申辦農業機械使用證與農機號牌"
                  },
                  {
                    "code": "O1.2.3",
                    "name": "瞭解農機相關交通法令"
                  }
                ],
                "knowledge": [],
                "skills": []
