            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "取得工作團隊的預算及財務計畫。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "與組織內部相關人士共同釐清預算及財務計畫,以確保計畫的可達成性、正確性及可解讀性。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "與組織內部相關人士共同協議預算及財務計畫可能需調整之處,並能夠提出因應措施。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "向團隊成員說明達成協議的預算及財務計畫細節,並確保團隊成員能夠達成預算及財務計畫要求之目標。"
                  }
