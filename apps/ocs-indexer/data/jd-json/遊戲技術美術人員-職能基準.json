            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "協助遊戲資深技術美術人員或美術總監確認美術整體風格包括主要材質、光影呈現方式等。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "評估並建議購買符合美術需求的第三方套件。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "制定美術素材的檔案命名及存放規則。"
                  },
