      {
        "ocu_code": "T1",
        "ocu_name": "遊戲數值規則設計",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "參數數值設計"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據企劃完成之遊戲類型、故事背景、世界觀及設計玩法,分析遊戲類型與特點。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "根據遊戲特點,決定核心參數與非核心參數,並規劃每個參數的範圍與數值權重。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "定義參數與公式,建立項目參數規劃表。"
                  }
                ],
                "outputs": [
