          {
            "task_codes": [
              {
                "code": "T2.2",
                "name": "商品陳列與耗材、作廢彩券管理"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P2.2.1",
                    "text": "能依公司規定,以擺設美觀與銷售方便為原則,正確陳列商品位置。"
                  },
                  {
                    "code": "P2.2.2",
                    "text": "依門店規範點算進貨商品與數量,如有品質不符的商品,能進行退(換)貨作業【註2】。"
                  },
                  {
                    "code": "P2.2.3",
                    "text": "能整理耗材區域,將耗材存放至正確位置,如低於安全庫存量,會撥打運彩公司客服,進行叫貨、補貨。"
                  },
                  {
                    "code": "P2.2.4",
                    "text": "非人為因素情況下,能依照運彩公司作業規範,確實填寫作廢申請表【註3】,並按月遞交作廢申請表正本至運彩公司。"
                  }
                ],
                "outputs": [
