  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "協助品質管理人員建立檢驗文件",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "製作一般待檢驗項目的相關文件"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據部門現存已建立的一般項目標準文件,確認待檢項目是否為類似或相同品項。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依據部門現存已建立的一般項目標準文件,建立類似或相同品項的品質管理計畫、檢驗表單及品質基準書。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "將完成文件交予主要負責人員進行審核。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "將新增或修改之檢驗順序、方法和相關表單,建置標準化作業(SOP)文件、標準化檢驗(SIP)文件。"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "檢驗表單"
                  },
                  {
                    "code": "O1.1.2",
                    "name": "品質基準書"
                  }
                ],
                "knowledge": [
                  {
                    "code": "K01",
                    "name": "品質管理概論"
                  },
                  {
                    "code": "K02",
                    "name": "ISO9001品質管理系統"
                  }
                ],
                "skills": [
                  {
                    "code": "S01",
                    "name": "文件閱讀及解讀能力"
                  },
