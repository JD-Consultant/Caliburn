  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A04",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A05",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中職以上機械製圖相關科別畢業，或職業訓練機械製圖相關科別半年以上訓練結訓之學員。"
    ],
    "supplements": [
      "癒合概論：包括銲接、铆接、結件等。",
      "電腦輔助繪圖軟體：係指符合鈑金繪圖作業的電腦繪圖2D及3D軟體。如Auto Cad、Solidworks、Radan CAD/CAM、Creo、SigmaNEST、JETCAM、",
      "Lantek Expert、TopSolid Progress、SheetMetalWorks、Fast SHAPES等。",
      "D工作圖：包含2D鈑金工作圖、2D零組件圖或交線展開圖、展開圖、排版圖等。",
      "D零組件圖：包含3D建模、3D組合件、立體分解系統圖（爆炸圖）等。",
      "相關文件資料：如2D圖面、3D圖面、知識文件等。"
    ]
  }
}