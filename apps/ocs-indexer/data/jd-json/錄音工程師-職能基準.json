  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "溝通能力：個人或團體相互交換訊息的歷程，藉以建立共識、協調活動、集思廣益或滿足需求，進而達成目標。"
      },
      {
        "code": "A02",
        "name": "耐心：承受延遲或煩惱，不急躁、不厭煩、不抱怨，並且保持冷靜。"
      },
      {
        "code": "A03",
        "name": "心態開放：可以接受與自身不同意見的平等交流，能接受不同合作對象的風格與行為模式差異，並且樂於協調打造和諧的工作環境。"
      },
      {
        "code": "A04",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A05",
        "name": "情緒管理佳：善於掌握自我、調節情緒，對生活中矛盾和事件引起的反應能適可而止的排解，能以樂觀幽默的態度即時緩解緊張的心理狀態。"
      },
      {
        "code": "A06",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件等。"
      },
      {
        "code": "A07",
        "name": "顧客導向：滿足顧客需求、增加顧客價值為出發點，特別注意顧客的消費能力、消費偏好以及消費行為的調查分析，以調整並符合顧客之需求。"
      },
      {
        "code": "A08",
        "name": "對音樂及時尚的喜好與熱忱：對於投入時尚與音樂產業有著高度的意願，並且會積極主動地去面對克服所碰到的挑戰。"
      },
      {
        "code": "A09",
        "name": "勇於嘗試：對於相同的工作條件，會主動變換自己的風格與方法，並且從中學習其中的差異。"
      },
      {
        "code": "A10",
        "name": "良好的職業道德：不踰越自己本身的職權範圍，也不擅自侵害他人權益，並且對於工作中學習的技術不惡意散佈。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "具備二年以上音樂相關領域實務經驗者。",
      "具備「英語溝通」技能為佳。"
    ],
    "supplements": []
  }
