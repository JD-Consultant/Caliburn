            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "與業主討論塗裝檢查範圍與內容。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "詳讀前移交施工紀錄/腐蝕評估紀錄。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "確認施工計畫書/品質計畫書的工法和作業程序。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依照施工計畫書/品質計畫書,確認檢查作業所需的塗裝檢查儀器和材料,及塗裝檢查儀器的校正週期。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "判別塗裝工程相關文件的規格符合原設計規範。"
                  },
                  {
                    "code": "P1.1.6",
                    "text": "針對與原始規範不符合處,與業主或授權人員溝通應遵循的處理方式。"
