  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A02",
        "name": "正直誠實：展現高道德標準及值得信賴的行為，且能以維持組織誠信為行事原則，瞭解違反組織、自己及他人的道德標準之影響。"
      },
      {
        "code": "A03",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A04",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A05",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A06",
        "name": "對應不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      },
      {
        "code": "A07",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "具備現場塗裝經驗3年以上或AMPP（NACE／SSPC-PCI）／FROSIO2級以上，及效期內之BOSIET／Survival Certificate。",
      "此項職能基準發展乃參考國內外職能資料，並經國內專家本土化及檢視完成。"
    ],
