        "ocu_name": "訂定離岸作業水上支撐結構預防與維護計畫",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "擬定計畫"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 4,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "閱讀業主或運維部門所提出之檢測及運維要求,以正確界定工作範圍與目標。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "閱讀業主或運維部門提出的結構設計標準與維護品保手冊,掌握工作項目與結構資訊。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "辨別因結構異常可能造成的水上支撐結構之安全風險與潛在問題。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "規劃風險管控措施,以制定預防與維護計畫。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "依據業主的職業安全衛生要求,評估預防與維護作業風險或危害因子,以擬定因應措施。"
                  }
                ],
                "outputs": [
