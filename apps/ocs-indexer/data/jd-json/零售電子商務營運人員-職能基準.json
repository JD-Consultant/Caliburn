        "tasks": [
          {
            "task_codes": [
              {
                "code": "T3.1",
                "name": "規劃品牌行銷方案"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P3.1.1",
                    "text": "依據行銷策略,蒐集市場競爭對手之商品資訊及行銷活動,透過分析確定品牌的優勢、劣勢、機會和威脅。"
                  },
                  {
                    "code": "P3.1.2",
                    "text": "規劃行銷通路(如電商平臺、社群媒體、搜尋引擎、即時通訊軟體等)投放廣告,並進行搜尋引擎優化(SEO)。"
                  },
                  {
                    "code": "P3.1.3",
                    "text": "強化品牌識別,將品牌元素及概念融於官方網站、顧客服務、促銷活動等環節,提升顧客對品牌識別度。"
                  },
                  {
                    "code": "P3.1.4",
                    "text": "掌握零售市場購物檔期(週年慶、節慶活動),分析相關銷售數據及網站流量,產出市場波動與消費者行為分析報告。"
                  },
                  {
                    "code": "P3.1.5",
                    "text": "分析現有顧客消費行為或數位軌跡,規劃再銷售方案。"
                  }
