  "ocs_content": {
    "ocu_units": [
      {
        "ocu_code": "T1",
        "ocu_name": "電器商品銷售服務",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "諮詢與銷售商品"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依賣場/門市電器商品銷售項目,接待顧客並主動說明商品功能、規格、節能、環保、智慧數位化及安全法規與價格。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依顧客需求,提供顧客電器商品諮詢服務與建議,並示範操作方法與展示商品優點,協助顧客選擇。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依顧客所選擇商品,操作與測試電器商品,並視電器商品屬性,說明維修與保固"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依賣場/門市行(促)銷活動程序,主動推廣行(促)銷活動。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "依組織目標,進行顧客需求銷售商品、點收正確金額,並開立發票/保固證明,以及交付電器商品或視電器商品體積/重量,適切包裝安排配送服務。"
                  }
                ],
