        "ocu_name": "電腦周邊硬體設備開發與設計",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "產品需求分析"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "規劃市場調查架構,包含市場趨勢、用戶需求及競爭對手分析,確保調查樣本規模足夠代表目標市場,開始進行市場調查。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "依據市場調查結果分析出產品需求,撰寫電腦周邊設備硬體設備需求報告。(報告內容須包含市場趨勢、用戶需求分析、競爭對手比較以及基於調查結果的產品開發建議)"
                  }
                ],
                "outputs": [
                  {
                    "code": "O1.1.1",
                    "name": "產品分析與需求報告"
                  }
                ],
