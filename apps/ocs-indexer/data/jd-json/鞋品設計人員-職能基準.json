        "ocu_name": "發想設計概念",
        "tasks": [
          {
            "task_codes": [
              {
                "code": "T1.1",
                "name": "依據品牌定位詮釋設計概念"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "蒐集市場需求與流行趨勢進行設計發想。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "與設計師、銷售團隊、管理階層及客戶討論,依據品牌定位、流行趨勢、目標客群及行銷規劃,進行設計方向可行性評估。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "撰寫設計說明書並考慮可能的限制條件。"
