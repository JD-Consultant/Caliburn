          {
            "task_codes": [
              {
                "code": "T1.3",
                "name": "管理生產流程"
              }
            ],
            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.3.1",
                    "text": "管理現場生產流程,並檢查生產流程符合職業安全衛生相關規範、作業規範及生產標準。"
                  },
                  {
                    "code": "P1.3.2",
                    "text": "管理生產資源,控制產品良率,確認符合訂單需求及最佳生產效率,並減少開補材料。"
                  },
                  {
                    "code": "P1.3.3",
                    "text": "管控生產流程及產品,符合議訂規格及品質目標,並記錄生產日報表及品質日報表視需要解決產線作業問題。"
                  },
                  {
                    "code": "P1.3.4",
                    "text": "聯繫前、後端相關部門,確保達成生產品質與目標,並定期回報進度。"
                  },
                  {
                    "code": "P1.3.5",
                    "text": "管理機具設備日常保養維護,使其發揮正常效能,並詳實記錄機具設備保養紀錄。"
                  }
                ],
