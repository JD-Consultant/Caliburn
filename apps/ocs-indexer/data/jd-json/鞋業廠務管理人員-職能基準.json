            "competency_blocks": [
              {
                "competency_level": 3,
                "indicators": [
                  {
                    "code": "P1.1.1",
                    "text": "依據職業安全衛生相關規範及組織要求,協助主管訂定生產管理規範。"
                  },
                  {
                    "code": "P1.1.2",
                    "text": "宣導生產管理規範及6S管理,並建立主管或生產部門成員之職責及標準工作規範。"
                  },
                  {
                    "code": "P1.1.3",
                    "text": "依據職業安全衛生相關規範,確保人員選用正確的安全防護設備。"
                  },
                  {
                    "code": "P1.1.4",
                    "text": "依生產工作需求,選用適切管理設備。"
                  },
                  {
                    "code": "P1.1.5",
                    "text": "依據組織生產管理要求,進行6S管理工作評估。"
                  }
