  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "親和力：對他人表現理解、友善、同理心、關心和禮貌，並能與不同背景的人發展及維持良好關係。"
      },
      {
        "code": "A02",
        "name": "主動積極：不需他人指示或要求能自動自發做事，面臨問題立即採取行動加以解決，且為達目標願意主動承擔額外責任。"
      },
      {
        "code": "A03",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度專注。"
      },
      {
        "code": "A04",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      },
      {
        "code": "A05",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以當的方式紓解自身壓力。"
      },
      {
        "code": "A06",
        "name": "應對不確定性：當狀況不明或問題不夠具體的情況下，能在必要時採取行動，以有效釐清模糊不清的態勢。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "高中（職）以上畢業；或具備餐飲服務技術士技能檢定證照。"
    ],
    "supplements": [
      "餐桌布置與擺設作業：如摺疊餐巾、鋪設檯布、設置桌位、擺放餐桌與餐具等。",
      "菜單內容：如菜餚烹調的方式、菜餚的食材、口味及口感。"
    ]
  }
}