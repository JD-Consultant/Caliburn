  "ocs_attitude": {
    "attitudes": [
      {
        "code": "A01",
        "name": "持續學習：能夠展現自我提升的企圖心，利用且積極參與各種機會，學習任務所需的新知識與技能，並能有效應用在特定任務。"
      },
      {
        "code": "A02",
        "name": "謹慎細心：對於任務的執行過程，能謹慎考量及處理所有細節，精確地檢視每個程序，並持續對其保持高度關注。"
      },
      {
        "code": "A03",
        "name": "壓力容忍：冷靜且有效地應對及處理高度緊張的情況或壓力，如緊迫的時間、不友善的人、各類突發事件及危急狀況，並能以適當的方式紓解自身壓力。"
      },
      {
        "code": "A04",
        "name": "自我管理：設立定義明確且實際可行的個人目標；對於及時完成任務展現高度進取、努力、承諾及負責任的行為。"
      },
      {
        "code": "A05",
        "name": "團隊意識：積極參與並支持團隊，能彼此鼓勵共同達成團隊目標。"
      }
    ]
  },
  "notes": {
    "prerequisites": [
      "國中畢業具一年工作經驗。",
      "高中（職）機械相關科系畢業者；。",
      "具職業訓練相關科別半年以上訓練結業者。"
    ],
    "supplements": [
      "高速車床：高速車床係指轉速區間介於1200RPM至3600RPM之加工機台。",
      "量測工具：如游標卡尺、內外徑分厘卡、量表、塞規、正弦桿、塊規、螺紋節距規、螺紋分厘卡、螺紋塞規、三線量規、畫線台等。",
      "各種車床切削：如端面、直徑、階級桿、錐度、偏心、切（斷）槽、螺紋、圓球、內孔、壓花等車削作業；及頂心、鑽孔、攻牙、搪孔等操作。"
    ]
  }
