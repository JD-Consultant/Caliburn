{
  "name": "@caliburn/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:proxy": "node --test scripts/dev-proxy.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts *.json *.ts *.js index.html",
    "codegen": "uv run --project ../api --locked python ../api/scripts/generate_contracts.py",
    "codegen:check": "uv run --project ../api --locked python ../api/scripts/generate_contracts.py --check"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.104.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
