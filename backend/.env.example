# App
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobintel
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/jobintel

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider — "openai" | "google" | "anthropic"
LLM_PROVIDER=openai

# OpenAI（LLM_PROVIDER=openai 時使用）
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # Embedding 固定 OpenAI，不隨 provider 切換

# Google Gemini（LLM_PROVIDER=google 時填入）
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-2.5-flash

# Anthropic Claude（LLM_PROVIDER=anthropic 時填入）
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-6

# iCAP RAG — 三段式信心門檻
# >= ICAP_HIGH_THRESHOLD   → reference mode（iCAP 為主）
# >= ICAP_MEDIUM_THRESHOLD → hybrid mode（混合）
# <  ICAP_MEDIUM_THRESHOLD → company_defined mode（不套用 iCAP）
ICAP_HIGH_THRESHOLD=0.70
ICAP_MEDIUM_THRESHOLD=0.55
ICAP_TOP_K=3

# Document output
DOCUMENT_OUTPUT_DIR=./output/documents

# CJK font path for PDF export (leave blank for auto-detection)
# Docker: auto-resolved via fonts-noto-cjk (no action needed)
# Windows: C:/Windows/Fonts/NotoSansTC-VF.ttf
# macOS:   /Library/Fonts/NotoSansTC-Regular.ttf
# FONT_PATH=
