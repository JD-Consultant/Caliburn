                        "items": {
                          "$ref": "#/$defs/JdNewBodyElement"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "not": {
                        "const": "jd_section"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "type": "object",
                    "required": [
                      "section_kind"
                    ]
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "not": {
                        "const": "table"
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "colSizes"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "marginLeft"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "not": {
                        "enum": [
                          "tr",
                          "td",
                          "th"
                        ]
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "type": "object",
                    "required": [
                      "size"
                    ]
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "not": {
                        "enum": [
                          "td",
                          "th"
                        ]
                      }
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "colSpan"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "rowSpan"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "background"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "borders"
                        ]
                      }
                    ]
                  }
                }
              }
            ],
            "description": "New supported document content. Never copy IDs or saved HTML attributes. Use numeric colSpan/rowSpan for a cell; omit for the native default of 1. Put only relevant, already-issued source_refs on the element they support. The App validates references and assigns new IDs."
          },
