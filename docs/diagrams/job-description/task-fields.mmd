%% title: 後端（現行）：職責、任務與 O/P 完整欄位
%% legend: ?＝可空，其餘 NOT NULL。JD 僅列關係鍵；四張內容表列完整欄位。Task 分類以職責 ID＋同一 JD ID 作複合外鍵檢查。
erDiagram
    direction TB
    job_descriptions ||..o{ duties : "擁有"
    job_descriptions ||..o{ job_tasks : "擁有"
    duties |o..o{ job_tasks : "可選分類／同 JD"
    job_tasks ||..o{ task_outcomes : "成果 O"
    job_tasks ||..o{ task_requirements : "要求 P"

    job_descriptions {
        uuid id PK "僅列關係鍵"
    }
    duties {
        uuid id PK
        uuid job_description_id FK
        text name "職責名稱"
        text? scope "職責範圍"
        int position "JD 職責清單內順序"
    }
    job_tasks {
        uuid id PK
        uuid job_description_id FK
        uuid? duty_id FK "null 表示未分類"
        text name "任務名稱"
        text? description "任務說明"
        int? competency_level "職能級別 1–6"
        int position "職責或未分類組內順序"
    }
    task_outcomes {
        uuid id PK
        uuid task_id FK
        text text "成果正文"
        int position "Task 的 O 清單內順序"
    }
    task_requirements {
        uuid id PK
        uuid task_id FK
        text text "要求正文"
        int position "Task 的 P 清單內順序"
    }
