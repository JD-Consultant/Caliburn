 [{"id": "r2-16", "type": "td", "children": [{"id": "r2-15", "type": "p", "children": [{"text": "所屬單位"}]}]}, {"id": "r2-18", "type": "td", "children": [{"id": "r2-17", "type": "p", "children": [{"text": "數位服務部／網站專案組"}]}]}]}, {"id": "r2-24", "type": "tr", "children": [{"id": "r2-21", "type": "td", "children": [{"id": "r2-20", "type": "p", "children": [{"text": "直屬主管"}]}]}, {"id": "r2-23", "type": "td", "children": [{"id": "r2-22", "type": "p", "children": [{"text": "網站專案組主管"}]}]}]}, {"id": "r2-29", "type": "tr", "children": [{"id": "r2-26", "type": "td", "children": [{"id": "r2-25", "type": "p", "children": [{"text": "主要協作對象"}]}]}, {"id": "r2-28", "type": "td", "children": [{"id": "r2-27", "type": "p", "children": [{"text": "專案經理、視覺設計師、後端工程師及客戶窗口"}]}]}]}]}], "section_kind": "identity"}, {"id": "section-purpose", "type": "jd_section", "children": [{"id": "r2-30", "type": "h2", "children": [{"text": "職務目的"}]}, {"id": "purpose", "type": "p", "children": [{"text": "將客戶確認的需求與視覺設計實現為可使用、可維護的網站前端，完成品質確認及交付，並依各專案的服務約定處理上線後問題與維護工作。"}]}], "section_kind": "purpose"}, {"id": "section-work", "type": "jd_section", "children": [{"id": "r2-31", "type": "h2", "children": [{"text": "主要職責與工作任務"}]}, {"id": "duty-1", "type": "jd_duty", "children": [{"id": "r2-32", "type": "h3", "children": [{"text": "一、釐清需求與規劃前端交付"}]}, {"id": "task-1", "type": "jd_task", "children": [{"id": "r2-33", "type": "p", "children": [{"bold": true, "text": "1. 釐清前端功能、使用情境及驗收範圍。"}]}, {"id": "task1-description", "type": "p", "children": [{"text": "與專案經理及客戶窗口確認網站需要支援的主要操作、裝置、瀏覽器與關鍵異常情境，整理開發範圍及尚待確認的事項。"}]}, {"id": "f03-task-1-outcomes", "type": "jd_outcomes", "children": [{"id": "r2-38", "type": "ul", "children": [{"id": "r2-35", "type": "li", "children": [{"id": "r2-34", "type": "lic", "children": [{"bold": true, "text": "主要產出："}, {"text": "可供開發與確認的前端需求及驗收範圍紀錄。"}]}]}]}]}, {"id": "f03-task-1-requirements", "type": "jd_requirements", "children": [{"id": "f03-task-1-requirements-list", "type": "ul", "children": [{"id": "r2-37", "type": "li", "children": [{"id": "r2-36", "type": "lic", "children": [{"bold": true, "text": "完成要求："}, {"text": "已確認與尚未確認的內容可以區分；不把推測直接當作客戶同意的需求。"}]}]}]}]}], "source_refs": ["fixture-source:task-1"]}, {"id": "task-2", "type": "jd_task", "children": [{"id": "r2-39", "type": "p", "children": [{"bold": true, "text": "2. 評估前端工作量、依賴條件及需求變更的影響。"}]}, {"id": "task2-description", "type": "p", "children": [{"text": "依工作範圍評估開發投入，辨識後端介面等依賴，說明變更對既有功能及交付安排的影響，提供調整建議。"}]}, {"id": "f03-task-2-outcomes", "type": "jd_outcomes", "children": [{"id": "f03-task-2-empty-outcome", "type": "p", "children": [{"text": ""}]}]}, {"id": "f03-task-2-requirements", "type": "jd_requirements", "children": [{"id": "r2-42", "type": "ul", "children": [{"id": "r2-41", "type": "li", "children": [{"id": "r2-40", "type": "lic", "children": [{"bold": true, "text": "完成要求："}, {"text": "估算包含必要前提與限制；新增或變更工作由專案經理協調確認後納入安排，不自行承諾報價或客戶期限。"}]}]}]}]}], "source_refs": ["fixture-source:task-2"]}]}, {"id": "duty-2", "type": "jd_duty", "children": [{"id": "r2-43", "type": "h3", "children": [{"text": "二、開發網站前端與整合資料介面"}]}, {"id": "task-3", "type": "jd_task", "children": [{"id": "r2-44", "type": "p", "children": [{"bold": true, "text": "3. 實作網站頁面、版面及互動功能。"}]}, {"id": "task3-description", "type": "p", "children": [{"text": "依已確認的需求與視覺設計開發前端，處理約定裝置與瀏覽器的差異，讓主要操作符合預期。"}]}, {"id": "f03-task-3-outcomes", "type": "jd_outcomes", "children": [{"id": "r2-49", "type": "ul", "children": [{"id": "r2-46", "type": "li", "children": [{"id": "r2-45", "type": "lic", "children": [{"bold": true, "text": "主要產出："}, {"text": "可供整合與檢查的前端頁面及程式版本。"}]}]}]}]}, {"id": "f03-task-3-requirements", "type": "jd_requirements", "children": [{"id": "f03-task-3-requirements-list", "type": "ul", "children": [{"id": "r2-48", "type": "li", "children": [{"id": "r2-47", "type": "lic", "children": [{"bold": true, "text": "完成要求："}, {"text": "主要操作、約定的鍵盤操作與基本可用性要求納入實作；發現設計與需求不一致時，先確認再調整。"}]}]}]}]}], "source_refs": ["fixture-source:task-3"]}, {"id": "task-4", "type": "jd_task", "children": [{"id": "r2-50", "type": "p", "children": [{"bold": true, "text": "4. 串接後端介面，處理資料與各種操作狀態。"}]}, {"id": "task4-description", "type": "p", "children": [{"text": "依介面約定實作資料顯示，以及載入、成功、失敗、逾時等情境的前端行為，並與後端工程師釐清問題及責任範圍。"}]}, {"id": "f03-task-4-outcomes", "type": "jd_outcomes", "children": [{"id": "f03-task-4-empty-outcome", "type": "p", "children": [{"text": ""}]}]}, {"id": "f03-task-4-requirements", "type": "jd_requirements", "children": [{"id": "r2-60", "type": "ul", "children": [{"id": "r2-59", "type": "li", "children": [{"id": "r2-51", "type": "lic", "children": [{"bold": true, "text": "完成要求："}]}, {"id": "r2-58", "type": "ul", "children": [{"id": "r2-53", "type": "li", "children": [{"id": "r2-52", "type": "lic", "children": [{"text": "查詢逾時時，保留必要輸入並提供重試方式。"}]}]}, {"id": "r2-55", "type": "li", "children": [{"id": "r2-54", "type": "lic", "children": [{"text": "訂單送出結果不明時，避免使用者重複送出，並與後端確認實際狀態，不直接判定下單失敗。"}]}]}, {"id": "r2-57", "type": "li", "children": [{"id": "r2-56", "type": "lic", "children": [{"text": "涉及後端資料或業務規則時，與負責人員確認，不自行改定規則。"}]}]}]}]}]}]}], "skill_ids": ["f03-jd_skill-3", "f03-jd_skill-4"], "source_refs": ["fixture-source:task-4"], "knowledge_ids": ["f03-jd_knowledge-2", "f03-jd_knowledge-4"]}]}, {"id": "duty-3", "type": "jd_duty", "children": [{"id": "r2-61", "type": "h3", "children": [{"text": "三、確認品質與完成交付"}]}, {"id": "task-5", "type": "jd_task", "children": [{"id": "r2-62", "type": "p", "children": [{"bold": true, "text": "5. 檢查前端功能，修正並驗證交付前的缺陷。"}]}, {"id": "task5-description", "type": "p", "children": [{"text": "檢查主要使用流程、約定的異常情境，以及裝置與瀏覽器的支援情況；記錄問題、修正前端缺陷並確認相關影響。"}]}, {"id": "f03-task-5-outcomes", "type": "jd_outcomes", "children": [{"id": "r2-67", "type": "ul", "children": [{"id": "r2-64", "type": "li", "children": [{"id": "r2-63", "type": "lic", "children": [{"bold": true, "text": "主要產出："}, {"text": "檢查結果、缺陷處理紀錄及待解限制說明。"}]}]}]}]}, {"id": "f03-task-5-requirements", "type": "jd_requirements", "children": [{"id": "f03-task-5-requirements-list", "type": "ul", "children": [{"id": "r2-66", "type": "li", "children": [{"id": "r2-65", "type": "lic", "children": [{"bold": true, "text": "完成要求："}, {"text": "修正後確認原問題及受影響操作；未解事項交由專案經理協調，不自行宣稱已通過客戶驗收。"}]}]}]}]}], "source_refs": ["fixture-source:task-5"]}, {"id": "task-6", "type": "jd_task", "children": [{"id": "r2-68", "type": "p", "children": [{"bold": true, "text": "6. 準備前端交付內容，配合發布、驗收與維護交接。"}]}, {"id": "task6-description", "type": "p", "children": [{"text": "整理可辨識的交付版本、操作或維護說明、已知限制及交接事項，並配合處理發布過程中的前端問題。"}]}, {"id": "f03-task-6-outcomes", "type": "jd_outcomes", "children": [{"id": "r2-73", "type": "ul", "children": [{"id": "r2-70", "type": "li", "children": [{"id": "r2-69", "type": "lic", "children": [{"bold": true, "text": "主要產出："}, {"text": "交付版本及接收者可使用的交接說明。"}]}]}]}]}, {"id": "f03-task-6-requirements", "type": "jd_requirements", "children": [{"id": "f03-task-6-requirements-list", "type": "ul", "children": [{"id": "r2-72", "type": "li", "children": [{"id": "r2-71", "type": "lic", "children": [{"bold": true, "text": "完成要求："}, {"text": "交付版本與檢查結果一致；發布問題能提供重現資訊；涉及服務端部署時，與負責該部署的後端工程師協作。客戶驗收仍由客戶確認。"}]}]}]}]}], "source_refs": ["fixture-source:task-6"]}]}, {"id": "duty-4", "type": "jd_duty", "children": [{"id": "r2-74", "type": "h3", "children": [{"text": "四、處理上線問題與約定維護"}]}, {"id": "task-7", "type": "jd_task", "children": [{"id": "r2-75", "type": "p", "children": [{"bold": true, "text": "7. 處理約定範圍內的上線後前端問題。"}]}, {"id": "task7-description", "type": "p", "children": [{"text": "收到問題後，了解影響與重現條件，區分前端缺陷、後端問題或新增需求；依判斷進行修正、驗證或轉交適當人員。"}]}, {"id": "r2-80", "type": "ul", "children": [{"id": "r2-77", "type": "li", "children": [{"id": "r2-76", "type": "lic", "children": [{"bold": true, "text": "執行時機："}, {"text": "上線後發生屬於服務範圍的問題時，包含少見但影響主要操作的異常。"}]}]}]}, {"id": "f03-task-7-outcomes", "type": "jd_outcomes", "children": [{"id": "f03-task-7-empty-outcome", "type": "p", "children": [{"text": ""}]}]}, {"id": "f03-task-7-requirements", "type": "jd_requirements", "children": [{"i