": [{"text": "理解頁面實作、裝置差異及前端行為問題"}]}]}, {"id": "f03-jd_knowledge-2", "type": "jd_knowledge", "children": [{"id": "r2-100", "type": "p", "children": [{"text": "前後端介面契約、資料格式與非同步狀態"}]}, {"id": "r2-102", "type": "p", "children": [{"text": "理解資料串接、載入與錯誤情境，釐清前後端責任"}]}]}, {"id": "f03-jd_knowledge-3", "type": "jd_knowledge", "children": [{"id": "r2-105", "type": "p", "children": [{"text": "基本可用性與約定的鍵盤操作要求"}]}, {"id": "r2-107", "type": "p", "children": [{"text": "辨識會阻礙使用者完成主要操作的問題"}]}]}, {"id": "f03-jd_knowledge-4", "type": "jd_knowledge", "children": [{"id": "r2-110", "type": "p", "children": [{"text": "軟體測試、缺陷追蹤與版本控管"}]}, {"id": "r2-112", "type": "p", "children": [{"text": "支援功能檢查、修正驗證及交付版本辨識"}]}]}, {"id": "f03-jd_knowledge-5", "type": "jd_knowledge", "children": [{"id": "r2-115", "type": "p", "children": [{"text": "專案範圍、驗收及維護約定"}]}, {"id": "r2-117", "type": "p", "children": [{"text": "判斷工作是否在服務範圍內，辨識需要再確認的需求"}]}]}], "section_kind": "knowledge"}, {"id": "section-skills", "type": "jd_section", "children": [{"id": "r2-120", "type": "h2", "children": [{"text": "所需技能"}]}, {"id": "r2-121", "type": "p", "children": [{"text": "技能"}]}, {"id": "r2-123", "type": "p", "children": [{"text": "具體內涵"}]}, {"id": "f03-jd_skill-1", "type": "jd_skill", "children": [{"id": "r2-126", "type": "p", "children": [{"text": "需求澄清與工作評估"}]}, {"id": "r2-128", "type": "p", "children": [{"text": "將模糊要求轉成可確認的操作情境；評估工作量、介面依賴與變更影響，說明估算前提"}]}]}, {"id": "f03-jd_skill-2", "type": "jd_skill", "children": [{"id": "r2-131", "type": "p", "children": [{"text": "前端開發與調整"}]}, {"id": "r2-133", "type": "p", "children": [{"text": "運用網頁技術實現設計與互動，依約定的裝置及操作方式調整頁面"}]}]}, {"id": "f03-jd_skill-3", "type": "jd_skill", "children": [{"id": "r2-136", "type": "p", "children": [{"text": "介面整合與問題診斷"}]}, {"id": "r2-138", "type": "p", "children": [{"text": "處理資料及非同步狀態，運用重現步驟、瀏覽器檢查與介面資料定位問題"}]}]}, {"id": "f03-jd_skill-4", "type": "jd_skill", "children": [{"id": "r2-141", "type": "p", "children": [{"text": "測試與修正驗證"}]}, {"id": "r2-143",