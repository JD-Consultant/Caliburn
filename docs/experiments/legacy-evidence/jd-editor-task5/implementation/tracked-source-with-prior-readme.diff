+            with self._lock:
+                self._entries.pop(token, None)
+            return True
+
+    def cleanup(self):
+        with self._lock:
+            tokens = tuple(self._entries)
+        results = [self.finish(token, terminate=True) for token in tokens]
+        return all(results) and self.quiescent
