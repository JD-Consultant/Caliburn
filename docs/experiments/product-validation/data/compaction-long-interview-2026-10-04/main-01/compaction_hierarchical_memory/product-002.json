    "profile": {
      "job_title": "庫存與物流行政專員",
      "organization_unit": "營運部",
      "reports_to": "倉儲主管",
      "purpose": "處理到貨登錄、庫存差異、退貨、缺貨追蹤、店間調撥及庫存報表，支援營運中的庫存資訊維護與物流行政作業；採購決策與客戶交涉不屬本職務責任。"
    }
  },
  "work": {
    "revision_id": "bcfbb73b-a25b-4f50-99e3-77ad7281ef44",
