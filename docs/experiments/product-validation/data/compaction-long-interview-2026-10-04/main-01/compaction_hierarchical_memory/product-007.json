{
  "profile": {
    "revision_id": "f74f6766-6610-404c-8b41-b37a4b3561be",
    "profile": {
      "job_title": "庫存與物流行政專員",
      "organization_unit": "營運部",
      "reports_to": "倉儲主管",
      "purpose": "處理到貨登錄、庫存差異、退貨、缺貨追蹤、店間調撥及庫存報表，支援營運中的庫存資訊維護與物流行政作業；採購決策與客戶交涉不屬本職務責任。"
    }
  },
  "work": {
    "revision_id": "f74f6766-6610-404c-8b41-b37a4b3561be",
    "areas": [
      {
        "area_id": "86f5e544-788a-464c-8136-8411148d12b9",
        "content_revision_id": "a40649cb-cf53-44ce-9048-d326c0295b85",
        "title": "到貨與庫存資料管理",
        "scope_text": "負責進貨單據與實際到貨資料核對、差異記錄及符合資料後的 ERP 登錄。"
      },
      {
        "area_id": "508f49dd-664c-4876-bc01-6658ac26c329",
        "content_revision_id": "b50be94d-cdbd-417b-a359-fed40eb0f9df",
        "title": "退貨清單核對與交接",
        "scope_text": "依退貨清單核對前一天收到的退貨，整理退貨差異表並交接客服窗口；此流程時點與到貨驗收分開。"
      }
    ],
    "tasks": [
      {
        "task_id": "98eb2f87-bbbd-4f29-83be-d58f30da0f60",
        "content_revision_id": "d8f77c64-76fb-4ba3-a9e6-6cd395228ff0",
        "area_id": "86f5e544-788a-464c-8136-8411148d12b9",
        "title": "核對並登錄到貨資料",
        "description": "每日處理約 15–20 張進貨單；比對採購單、送貨單與實際到貨的品號、批號及數量。由倉庫同事清點實物，本人核對單據並記錄差異；資料符合後登錄 ERP。",
        "details": [
          {
            "detail_id": "5450522d-d6c5-4bd4-a775-a975e103dd4b",
            "kind": "outcome",
            "text": "符合實際到貨並完成核對的進貨資料登錄於 ERP。"
          },
          {
            "detail_id": "0ebdb1c1-1c74-4007-8c52-ec7867d7a275",
            "kind": "outcome",
            "text": "到貨資料差異有記錄，供後續處理或查核。"
          },
          {
            "detail_id": "a512b0c0-fbb5-441d-89c9-e56a738b78e6",
            "kind": "outcome",
            "text": "未確認的到貨差異保留在待處理清單，供後續追蹤。"
          },
          {
            "detail_id": "c3dfa283-b366-48f3-8712-ad9f7a43da55",
            "kind": "outcome",
            "text": "實際收貨時間及未決原因留存，供財務判定有疑義或超過截止的單據歸屬月份。"
          },
          {
            "detail_id": "fb62b481-2db8-4ecc-a4f4-ce48419373f0",
            "kind": "requirement",
            "text": "不得直接以供應商送貨單上的數量作為實際收貨數；須以實際到貨清點資料進行核對，資料符合後才登錄 ERP。"
          },
          {
            "detail_id": "52c27909-acfd-4f96-8e6c-e6fd1be903d8",
            "kind": "requirement",
            "text": "發現商品外箱破損或短少時，拍照並記錄實收件數及原單號，通知採購；未確認部分留在待處理清單。"
          },
          {
            "detail_id": "b11d0533-7776-433a-87f3-5ea1d232bbe7",
            "kind": "requirement",
            "text": "退換貨或補貨由採購決定；本人不自行同意接受替代品，也不修改採購單上的價格。"
          },
          {
            "detail_id": "793087df-15c0-4b3b-adf1-70ddde68dc17",
            "kind": "requirement",
            "text": "通常於到貨當天下班前完成已確認項目的 ERP 登錄。"
          },
          {
            "detail_id": "9e148c3b-99ab-498f-8e2e-a595148e16b9",
            "kind": "requirement",
            "text": "月底依財務提供的截止清單處理；超過截止或有疑義的單據，由財務決定歸屬月份。本人保留實際收貨時間與未決原因，不自行回填日期。"
          }
        ]
      },
      {
        "task_id": "b643dab6-640c-4f03-a868-53565a39db32",
        "content_revision_id": "372b89eb-6c8f-409b-b286-55b1ce3ca308",
        "area_id": "86f5e544-788a-464c-8136-8411148d12b9",
        "title": "追蹤收貨異常至結案",
        "description": "針對收貨異常更新差異清單與處理進度，依採購決定的退貨或補貨方向持續追蹤；本人不保證供應商實際補貨時程。",
        "details": [
          {
            "detail_id": "22998975-56d2-406c-aaa0-c03f5e2a6795",
            "kind": "outcome",
            "text": "收貨異常持續追蹤，至補貨或退貨完成且帳物相符後結案。"
          },
          {
            "detail_id": "83837dca-efed-4205-82a8-c1cd634d7f44",
            "kind": "requirement",
            "text": "異常處理兩個工作日未獲回覆時提醒採購；到第四個工作日仍無進展時回報主管。"
          },
          {
            "detail_id": "8ec454d2-3902-4bfb-8755-47c8362e9494",
            "kind": "requirement",
            "text": "結案須待補貨或退貨完成且帳物相符；供應商實際補貨時間不由本人保證。"
          }
        ]
      },
      {
        "task_id": "c26bdf3f-c17e-4f78-87bf-5e901c49a2ee",
        "content_revision_id": "8918da02-f75d-4063-8cbc-9f62560b361f",
        "area_id": "508f49dd-664c-4876-bc01-6658ac26c329",
        "title": "核對退貨並交接差異表",
        "description": "每個工作日 08:35 開始核對前一天收到的退貨，整理退貨差異表並交給客服窗口。",
        "details": [
          {
            "detail_id": "fbac615f-ecdd-458e-844f-3e40b6800bd6",
            "kind": "outcome",
            "text": "前一天收到的退貨完成核對，退貨差異表交接至客服窗口。"
          },
          {
            "detail_id": "0f425674-d6a0-457e-bc39-398b217d8392",
            "kind": "requirement",
            "text": "退貨核對於每個工作日 08:35 開始，並於 09:10 前將退貨差異表交給客服窗口；此時限適用於退貨流程，不適用於進貨驗收。"
          }
        ]
      }
    ],
