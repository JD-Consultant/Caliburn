{
  "profile": {
    "revision_id": "25d9904e-33f1-4954-8e21-bc0a1bcc0b46",
    "profile": {
      "job_title": "庫存與物流行政專員",
      "organization_unit": "營運部",
      "reports_to": "倉儲主管",
      "purpose": "透過到貨登錄、庫存差異與缺貨追蹤、退貨、店間調撥及庫存報表等行政作業，維持營運所需庫存資訊與物流作業的可追蹤性，並支援相關單位掌握庫存狀況。採購訂貨決策及客服對客人處理、對外承諾交期不在此職務責任範圍。"
    }
  },
  "work": {
    "revision_id": "25d9904e-33f1-4954-8e21-bc0a1bcc0b46",
    "areas": [
      {
        "area_id": "dd676f46-f3f4-4bf0-b81b-da95f4c2db9a",
        "content_revision_id": "180ed18a-900a-4f6e-9b0f-bbbd03e72301",
        "title": "庫存與物流行政作業",
        "scope_text": "處理到貨登錄、庫存差異與缺貨追蹤、退貨、店間調撥及庫存報表等工作；採購訂貨決策與客服對客處理及對外承諾交期不屬此職責範圍。"
      }
    ],
    "tasks": [
      {
        "task_id": "203b1b1b-5d4e-4e43-8d36-1135b557d999",
        "content_revision_id": "b5bea027-68db-42e8-b24f-50841fd702dc",
        "area_id": "dd676f46-f3f4-4bf0-b81b-da95f4c2db9a",
        "title": "核對進貨單據並登錄到貨資料",
        "description": "每日約處理 15–20 張進貨單，比對採購單、供應商送貨單與實際到貨的品號、批號及數量。倉庫同事負責清點實物；本人核對單據並記錄差異，資料符合後登錄 ERP。",
        "details": [
          {
            "detail_id": "2cdf581b-df63-47ce-8fe5-2a497c45e808",
            "kind": "outcome",
            "text": "核對後的到貨資料登錄於 ERP。"
          },
          {
            "detail_id": "587ab130-1413-45ff-9373-93f32a33f3a1",
            "kind": "outcome",
            "text": "進貨單據與實際到貨的差異有記錄。"
          },
          {
            "detail_id": "5f636bf0-7d10-44b0-b517-3da9ac6f5dd0",
            "kind": "requirement",
            "text": "實際到貨數量須以倉庫同事清點結果為據，不可直接把供應商送貨單上的數量當作實收數。"
          },
          {
            "detail_id": "ce4ffa59-95da-4254-8864-bfaa546f3fc6",
            "kind": "requirement",
            "text": "單據資料符合後才登錄 ERP。"
          }
        ]
      },
      {
        "task_id": "071c3770-b4dd-4b71-8a4a-cff997b24ae7",
        "content_revision_id": "31c19eaa-9813-406e-a09d-24be22d117ae",
        "area_id": "dd676f46-f3f4-4bf0-b81b-da95f4c2db9a",
        "title": "提報進貨驗收不良並處理安全疑慮",
        "description": "驗收時依本批實際驗收件數判斷不良件比例；超過 5% 時提報倉儲主管。有安全疑慮時先隔離並通知主管，不受比例門檻限制。",
        "details": [
          {
            "detail_id": "022f9ff1-8abd-4c14-9f38-ce924ad0f073",
            "kind": "outcome",
            "text": "超過不良比例門檻的進貨情形已提報倉儲主管。"
          },
          {
            "detail_id": "af5e3b36-4b10-496e-8fac-01540aaf4154",
            "kind": "outcome",
            "text": "有安全疑慮的貨品先行隔離，並通知主管。"
          },
          {
            "detail_id": "1769aca2-8295-4497-9c53-456db285e961",
            "kind": "requirement",
            "text": "不良件數占本批實際驗收件數超過 5% 時提報；剛好 5% 不因這項比例規則提報。"
          },
          {
            "detail_id": "903f0e6e-e401-4ced-bdd5-17974644aa7e",
            "kind": "requirement",
            "text": "有安全疑慮時，仍須先隔離並通知主管；不以不良比例是否達到 5% 作為忽略安全問題的理由。"
          }
        ]
      },
      {
        "task_id": "81d71470-f766-4e3d-8740-a50589db867a",
        "content_revision_id": "10f1c0f3-876d-49f8-a5cc-7bec87ef6d84",
        "area_id": "dd676f46-f3f4-4bf0-b81b-da95f4c2db9a",
        "title": "追蹤收貨異常至完成結案",
        "description": "更新收貨差異清單及處理進度，依未回覆或未進展情況提醒採購並向主管回報，持續追蹤至補貨或退貨完成且帳物相符。供應商實際補貨時間不由本人保證。",
        "details": [
          {
            "detail_id": "38c0c988-5d65-446e-b8d0-5b4dd5cf2ce1",
            "kind": "outcome",
            "text": "收貨差異清單及處理進度保持更新。"
          },
          {
            "detail_id": "ddf42a8a-312a-4281-88c0-3bc00ef707ce",
            "kind": "outcome",
            "text": "收貨異常於補貨或退貨完成且帳物相符後結案。"
          },
          {
            "detail_id": "e784a413-589f-47c2-89ba-c6f85f7655d7",
            "kind": "requirement",
            "text": "兩個工作日未獲回覆時提醒採購；第四個工作日仍無進展時回報主管。"
          },
          {
            "detail_id": "2534b0d7-624c-4593-9e89-daef2c26f830",
            "kind": "requirement",
            "text": "供應商實際補貨時間不屬本人可保證的事項。"
          }
        ]
      }
    ],
