{
  "profile": {
    "revision_id": "145da4ad-ab55-40f3-ae5c-7f3a4e442a03",
    "profile": {
      "job_title": "倉庫管理員",
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "負責物流中心的收貨驗收、上架、揀貨補貨、庫存盤點及客戶與供應商退貨入庫，維持貨物流轉與庫存作業的準確，支援後續出貨及退貨處理。"
    }
  },
  "work": {
    "revision_id": "145da4ad-ab55-40f3-ae5c-7f3a4e442a03",
    "areas": [
      {
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "物流中心倉儲與庫存作業",
        "scope_text": "涵蓋收貨驗收、上架、揀貨補貨、庫存盤點，以及客戶與供應商退貨入庫。"
      }
    ],
    "tasks": [
      {
        "task_id": "9301a06b-657b-4284-852c-4ba3dfb0656a",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "驗收進貨與上架入庫",
        "description": "收貨時比對採購單、送貨單上的品項與實際收到的數量；核對無誤後，依已安排的儲位上架、貼標籤，並在庫存系統登記入庫。若發現數量不符，拍照並將差異告知採購。",
        "outcomes": [
          {
            "detail_id": "e6559418-9858-42d4-b32e-62481f3f14c6",
            "text": "提供採購差異情況及照片，供採購後續處理。"
          },
          {
            "detail_id": "f93327b6-b480-4764-bb94-3d1c711e1407",
            "text": "貨品依已安排的儲位上架並貼標籤，庫存系統完成入庫登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "ad77ce78-7f02-427f-af82-def3921f1409",
            "text": "不自行決定拒收或退換貨；相關處理由採購決定。"
          }
        ]
      },
      {
        "task_id": "421cdb20-0f0e-4fea-a788-f09aa160c7cf",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "依出貨單揀貨",
        "description": "依出貨單揀取貨品，依先進先出原則作業。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "4b64c267-f267-4ef5-8cab-098c1860640e",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "依安全庫存狀況通知採購補貨",
        "description": "看到商品低於安全庫存時，通知採購補貨。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "3d7446e2-b254-4cc7-af7f-fe04a045f6a2",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "執行日常與月底庫存盤點",
        "description": "每天快下班時，盤點當天異動較多的商品，不作全倉盤點；月底盤點自己負責的整區。",
        "outcomes": [
          {
            "detail_id": "ca0df9f7-3e43-481c-9500-96421e9cc2d3",
            "text": "月底盤點結果提供主管抽查。"
          },
          {
            "detail_id": "2e4391a5-d054-45f3-bfec-6c0905a4a0df",
            "text": "庫存差異超過主管設定的範圍時，撰寫差異報告。"
          }
        ],
        "requirements": []
      },
      {
        "task_id": "403eb502-a060-46d2-a3d6-1adb850ed19c",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "檢查並處理客戶退貨",
        "description": "檢查客戶退貨的外觀與數量，辦理貨品放置及登記，包括入庫或送至待處理區；瑕疵品與否由品保判定。",
        "outcomes": [
          {
            "detail_id": "465e431d-8f17-4ac0-9398-8a1ef593fbfa",
            "text": "客戶退貨依檢查與後續處理需要完成入庫，或送至待處理區。"
          }
        ],
        "requirements": [
          {
            "detail_id": "316ea756-9d47-437f-a3d0-2bc739ed85e2",
            "text": "瑕疵品與否由品保判定，倉庫不自行認定。"
          }
        ]
      },
      {
        "task_id": "869cce12-1100-4841-8647-7ced17fb8ef5",
        "area_id": "e6829426-7548-4967-9408-8b50dd36be25",
        "title": "備妥供應商退貨並登記出貨",
        "description": "依採購決定退回的貨品，將貨物備妥並登記出貨；是否退貨由採購決定。",
        "outcomes": [
          {
            "detail_id": "6b1852fe-24f3-4129-b8f6-a4113262ba6c",
            "text": "決定退回的供應商貨品完成備貨與出貨登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "dee8a423-8bf2-49ec-b354-7079ad8f8383",
            "text": "是否退回由採購決定；本人負責備貨及登記出貨，不負責決定退貨。"
          }
        ]
      }
    ],
    "capabilities": [],
    "task_links": [],
    "collaborators": [
      {
        "collaborator_id": "31b42c6b-6c7c-417c-8fe2-ca4589099916",
        "name": "採購",
        "scope_text": "進貨數量不符時，提供差異情況及照片給採購；進貨拒收或退換貨由採購決定。商品低於安全庫存時，通知採購補貨。供應商退貨由採購決定是否退回，決定退回後由你備妥貨品並登記出貨。"
      },
      {
        "collaborator_id": "61b4f465-9075-4f4e-b939-7bc76de3702b",
        "name": "品保",
        "scope_text": "判定客戶退回商品是否為瑕疵品；倉庫檢查商品外觀與數量，依處理需要辦理入庫或送至待處理區，不自行認定瑕疵。"
      }
    ],
    "conditions": [
      {
        "condition_id": "9ad6366e-23f0-4716-aaf1-bbf465f0ca2b",
        "kind": "schedule_travel",
        "text": "早上七點上班，週一至週六輪休。"
      }
    ]
  },
