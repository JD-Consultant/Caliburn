      "job_title": "倉庫揀貨員",
      "organization_unit": null,
      "reports_to": null,
      "purpose": "依訂單完成正確揀貨，維持庫存作業可追查。"
    }
  },
  "work": {
    "revision_id": "b53949a2-41af-49ee-86cb-896564537c14",
    "areas": [
      {
        "area_id": "0197c298-d9bf-46ce-9781-73c50ec10600",
        "title": "揀貨與核對",
        "scope_text": "揀貨、核對品項及回報庫存差異。"
      }
    ],
    "tasks": [
      {
        "task_id": "9a6b40f8-9ccf-4b29-a9b0-880e9d49410c",
        "area_id": "0197c298-d9bf-46ce-9781-73c50ec10600",
        "title": "揀貨並核對庫存",
        "description": "依出貨單核對品項及數量，先進先出；異常先比對進出貨與儲位，記錄交主管確認，不自行改帳。",
        "outcomes": [
          {
            "detail_id": "8bac546b-ea74-440d-b0a5-ef4f12bf7114",
            "text": "完成依出貨單揀取並核對的貨品；如發現庫存差異，留下查核紀錄供主管確認。"
          }
        ],
        "requirements": [
          {
            "detail_id": "c2fe7d96-2397-405d-a537-368bd6c3860b",
            "text": "依先進先出原則出貨；實貨與系統不一致時，先核對進出貨紀錄及儲位、記錄差異交主管確認，不自行更改數量。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "9dd73129-364e-4937-9bd2-bab406fb1ea9",
        "kind": "knowledge",
        "name": "庫存先進先出原則",
        "description": "理解依入庫先後安排批次出貨的原則。"
      },
      {
        "capability_id": "abcefc48-1d74-405e-b1fd-3348f92a4c4c",
        "kind": "skill",
        "name": "貨品核對與差異查核紀錄",
        "description": "能依出貨單核對品名與數量；遇實貨與系統不一致時，比對進出貨紀錄及儲位並記錄差異，交主管確認。"
      }
    ],
