{
  "profile": {
    "revision_id": "95ffc355-d8df-4ac6-9318-d0ded7e14437",
    "profile": {
      "job_title": null,
      "organization_unit": "客服部",
      "reports_to": null,
      "purpose": "受理並處理客戶使用問題，並整理客訴資訊供主管掌握常見問題，支持服務問題的追蹤與改善判斷。"
    }
  },
  "work": {
    "revision_id": "95ffc355-d8df-4ac6-9318-d0ded7e14437",
    "areas": [
      {
        "area_id": "cc4afead-bef2-4a3a-938c-a80532202830",
        "title": "客戶使用問題處理",
        "scope_text": "受理並處理客戶使用問題，必要時轉交技術同事。"
      },
      {
        "area_id": "c91bf174-a5b3-4314-a7e2-714d878ef9ea",
        "title": "客訴資訊整理與回報",
        "scope_text": "整理每週客訴資料供主管掌握常見問題及未結案情況。"
      }
    ],
    "tasks": [
      {
        "task_id": "5152af6e-0109-415e-aea2-196698b6fd4d",
        "area_id": "cc4afead-bef2-4a3a-938c-a80532202830",
        "title": "回應客戶使用問題",
        "description": "每天受理問題，核對訂單與操作紀錄；無法處理轉交技術同事，不決定退款。",
        "outcomes": [
          {
            "detail_id": "08505b9f-4e57-483c-ae93-629311fccef9",
            "text": "客戶提出的使用問題獲得處理；需技術處理者轉交技術同事接續處理。"
          }
        ],
        "requirements": []
      },
      {
        "task_id": "848b89ae-7939-42b8-85e8-dcd88756e5d4",
        "area_id": "c91bf174-a5b3-4314-a7e2-714d878ef9ea",
        "title": "整理每週客訴資料",
        "description": "每週五整理類型、件數和未結案清單給主管，由主管決定改善，不分派工作。",
        "outcomes": [
          {
            "detail_id": "09ba336e-4940-47d8-b1b6-748be4c23663",
            "text": "讓主管掌握較常發生的客訴問題及未結案情況，作為判斷改善事項的資訊。"
          }
        ],
        "requirements": []
      }
    ],
    "capabilities": [
      {
        "capability_id": "364d0d3e-ba64-4192-9318-5ad7e173148b",
        "kind": "skill",
        "name": "客戶問題初步查核與轉介",
        "description": "查核訂單與操作紀錄以處理客戶使用問題，並辨識無法處理、需轉交技術同事的情況。"
      },
      {
        "capability_id": "9b283f48-8c83-4af6-b6e3-b0ffca3beba7",
        "kind": "skill",
        "name": "客訴資訊分類與彙整",
        "description": "整理客訴類型、件數及未結案清單，使主管能掌握常見問題。"
      }
    ],
