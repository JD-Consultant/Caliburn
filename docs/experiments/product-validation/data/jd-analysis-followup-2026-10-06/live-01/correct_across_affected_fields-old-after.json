  "profile": {
    "revision_id": "daa1e2a5-a521-4e54-96c6-8bc5fb3854b5",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "負責日常收貨與退貨相關作業，包含客戶退貨檢查入庫，以及依採購通知備妥供應商退貨並登記出貨，支援貨品進出流程及相關紀錄。"
    }
  },
  "work": {
    "revision_id": "daa1e2a5-a521-4e54-96c6-8bc5fb3854b5",
    "areas": [
      {
        "area_id": "2e564d10-5f72-4052-9f99-2351a5ca93dd",
        "title": "收貨與退貨管理",
        "scope_text": "涵蓋每日收貨、客戶退貨檢查與入庫，以及依採購通知備妥供應商退貨並登記出貨。"
      }
    ],
    "tasks": [
      {
        "task_id": "d1ad57bd-e5a7-49a1-aa3a-95c2fa9e633d",
        "area_id": "2e564d10-5f72-4052-9f99-2351a5ca93dd",
        "title": "核對收貨差異",
        "description": "每日處理約 15–20 張收貨單，數量不符時拍照、記錄並通知採購。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "9d5d564a-3021-477f-9bbb-5d6b6dc6a8ba",
        "area_id": "2e564d10-5f72-4052-9f99-2351a5ca93dd",
        "title": "檢查客戶退貨並辦理入庫",
        "description": "檢查客戶退回的貨品並辦理入庫。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "f154e93a-3503-4ade-9045-f69887ddab7a",
        "area_id": "2e564d10-5f72-4052-9f99-2351a5ca93dd",
        "title": "備妥供應商退貨並登記出貨",
        "description": "依採購通知備妥供應商退貨貨品並登記出貨；不負責決定是否退貨。",
        "outcomes": [
          {
            "detail_id": "2c6cb846-ca67-465d-b987-c9fc6ed48292",
            "text": "依通知備妥的供應商退貨貨品及出貨登記，供後續出貨作業。"
          }
        ],
        "requirements": [
          {
            "detail_id": "9f1807d7-1cdd-40cf-b2dc-b1b69c23962d",
            "text": "供應商退貨是否退回由採購決定；本人依通知備貨並登記出貨。"
          }
        ]
      }
    ],
