{
  "profile": {
    "revision_id": "a9b8fa90-f018-4f58-8b2c-ccac6d6c22a7",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "執行倉庫收貨驗收與上架、出貨揀貨、庫存盤點及退貨檢查與交接，支援物流中心貨物流轉與庫存管理。"
    }
  },
  "work": {
    "revision_id": "a9b8fa90-f018-4f58-8b2c-ccac6d6c22a7",
    "areas": [
      {
        "area_id": "44ca140b-cced-470a-b266-31d272eec7fd",
        "title": "物流中心倉儲作業",
        "scope_text": "負責收貨上架、出貨揀貨、庫存盤點與退貨交接。"
      }
    ],
    "tasks": [
      {
        "task_id": "27ecde0c-3615-409b-a430-ddba4c133931",
        "area_id": "44ca140b-cced-470a-b266-31d272eec7fd",
        "title": "驗收進貨與上架",
        "description": "核對單據與實貨，記錄差異並通知採購，將已確認商品上架。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "d63a562f-fac1-4dfa-ba5c-13ecb8dd1cad",
        "area_id": "44ca140b-cced-470a-b266-31d272eec7fd",
        "title": "依單據揀貨",
        "description": "依出貨單揀貨並掃碼核對品項，不符時停止並查原因。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "a9be986f-13b1-45a4-af6c-a702994fff8d",
        "area_id": "44ca140b-cced-470a-b266-31d272eec7fd",
        "title": "盤點庫存",
        "description": "每日下班前複點高異動商品，月底盤本人區域；主管確認後才調整帳面。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "3ed2c22f-fcba-4568-908a-0fd0c1eb5559",
        "area_id": "44ca140b-cced-470a-b266-31d272eec7fd",
        "title": "處理退貨與交接",
        "description": "檢查客戶退貨，正常品入庫，疑似瑕疵轉品保；依採購通知備妥供應商退貨並登記出貨，不決定退貨。",
        "outcomes": [],
        "requirements": []
      }
    ],
