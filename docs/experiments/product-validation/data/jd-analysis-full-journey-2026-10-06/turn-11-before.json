        "capability_id": "f3ac95aa-c53c-4f9a-b8f6-03035c814af6"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "67cd18ed-d014-4b42-8687-b636f8a9f8a3",
        "name": "採購",
        "scope_text": "收取倉庫管理員提供的到貨差異資訊與照片，決定是否收貨或退回供應商；另於品項低於安全庫存時接收倉庫管理員的補貨通知。"
      },
      {
        "collaborator_id": "952be4e3-13f6-4931-881d-1e193952e1e6",
        "name": "品保",
        "scope_text": "負責判定客戶退貨品是否屬瑕疵；倉庫管理員不負責此判定。"
      },
      {
        "collaborator_id": "a0c6be45-197a-4fb4-87c1-678f1e6942ba",
        "name": "倉儲主管",
        "scope_text": "月底抽查員工負責區域的盤點結果，並設定差異報告的判定範圍；員工在差異超過該範圍時撰寫差異報告。"
      }
    ],
    "conditions": [
      {
        "condition_id": "8cf4933e-5987-4268-9261-97c2cd89d501",
        "kind": "schedule_travel",
        "text": "早上七點上班，週一至週六輪休。"
      }
    ]
  },
