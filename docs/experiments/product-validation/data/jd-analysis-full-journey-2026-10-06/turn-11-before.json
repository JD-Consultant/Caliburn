{
  "profile": {
    "revision_id": "57067e2a-e9ed-4c3c-ba86-e315ce97ee0c",
    "profile": {
      "job_title": "倉庫管理員",
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "執行物流中心收貨驗收、上架、揀貨補貨、庫存盤點、客戶退貨入庫及供應商退貨備貨與出貨登記，協助維持貨品流轉及庫存資訊相符。"
    }
  },
  "work": {
    "revision_id": "57067e2a-e9ed-4c3c-ba86-e315ce97ee0c",
    "areas": [
      {
        "area_id": "6f12a177-6dd3-457e-ad12-2e70a2a9ebb8",
        "title": "收貨與入庫",
        "scope_text": "處理進貨的收貨驗收及貨品上架。"
      },
      {
        "area_id": "211311ca-7992-4b66-a37f-b00e287e0873",
        "title": "出貨揀貨",
        "scope_text": "依出貨單揀貨，並遵循先進先出原則。"
      },
      {
        "area_id": "b3b3a1f6-9ac5-49ad-ba6a-4ce236c45912",
        "title": "庫存管理",
        "scope_text": "執行庫存盤點；品項低於安全庫存時，通知採購補貨。"
      },
      {
        "area_id": "804bccbb-2b42-4a24-84cc-69e3b684198d",
        "title": "退貨處理",
        "scope_text": "處理客戶退貨入庫及供應商退貨。"
      }
    ],
    "tasks": [
      {
        "task_id": "7b0a705e-c2bb-4b93-b127-6af68b41f778",
        "area_id": "6f12a177-6dd3-457e-ad12-2e70a2a9ebb8",
        "title": "收貨驗收及上架",
        "description": "依採購單及送貨單核對實際到貨品項與數量；發現不符時拍照、告知採購並回報倉儲主管。驗收後、上架前以手持掃描器再次掃描條碼確認品項，再依儲位規則上架、貼標籤，並在庫存系統登記入庫。",
        "outcomes": [
          {
            "detail_id": "8eee34b5-3e7e-45b4-bbe4-c18fe2abc2f7",
            "text": "到貨差異資訊及照片提供採購與倉儲主管，供採購決定是否收貨或退回供應商。"
          },
          {
            "detail_id": "e6353437-2951-4ddf-930a-3ce30722304c",
            "text": "貨品依儲位規則上架並貼標籤，入庫資料登記於庫存系統。"
          }
        ],
        "requirements": [
          {
            "detail_id": "4511eeb5-199c-41c6-bc87-dbe56fcd04e3",
            "text": "本人不自行決定是否收貨或退回供應商，後續由採購決定。"
          },
          {
            "detail_id": "d3c63a2f-826b-43fa-89eb-60fd2e9b60fd",
            "text": "上架前使用手持掃描器再次掃描條碼確認品項。"
          }
        ]
      },
      {
        "task_id": "3e2c0caa-1f76-4b19-bd2f-760bb6a5e753",
        "area_id": "211311ca-7992-4b66-a37f-b00e287e0873",
        "title": "依出貨單揀貨",
        "description": "依出貨單找貨並揀選貨品。",
        "outcomes": [],
        "requirements": [
          {
            "detail_id": "4c5311ab-c275-49f5-97b4-2462767f571e",
            "text": "揀貨按先進先出原則進行。"
          }
        ]
      },
      {
        "task_id": "e3535c6f-2aac-4d99-a1e2-4ec8bb35c917",
        "area_id": "b3b3a1f6-9ac5-49ad-ba6a-4ce236c45912",
        "title": "日常庫存複點與月底區域盤點",
        "description": "執行平日當天異動較多品項的複點，以及月底全倉盤點中本人負責區域的複點；差異超過主管規定範圍時撰寫差異報告。",
        "outcomes": [
          {
            "detail_id": "54d4e60a-5140-4287-8909-aa3f63dc1cc2",
            "text": "月底本人負責區域的盤點結果交主管抽查；超過主管規定範圍的差異形成差異報告。"
          }
        ],
        "requirements": [
          {
            "detail_id": "14a9402a-06ce-47e1-9c94-cc079bee8ef3",
            "text": "平日複點於每天下班前進行，僅盤點當天異動較多品項而非全倉；月底全倉盤點時，複點本人負責區域後交主管抽查。差異範圍由主管規定，超過該範圍才撰寫差異報告。"
          }
        ]
      },
      {
        "task_id": "db985107-7d09-4a7a-aa32-4872d1f868f4",
        "area_id": "b3b3a1f6-9ac5-49ad-ba6a-4ce236c45912",
        "title": "通知採購補貨",
        "description": "品項低於安全庫存時，通知採購補貨。",
        "outcomes": [
          {
            "detail_id": "510b453b-a226-45bb-81db-b4cecbafefa1",
            "text": "低於安全庫存品項的補貨需求已通知採購。"
          }
        ],
        "requirements": [
          {
            "detail_id": "9fc19a9e-9e06-4598-86f1-abd499760b94",
            "text": "本人負責通知採購補貨，不負責採購決定或價格決定。"
          }
        ]
      },
      {
        "task_id": "b0a19f08-b5ab-4b53-b0ff-720c0b9c5897",
        "area_id": "804bccbb-2b42-4a24-84cc-69e3b684198d",
        "title": "檢查及處理客戶退貨",
        "description": "檢查客戶退貨商品外觀並核對數量，之後將商品入庫或先放至待處理區。",
        "outcomes": [
          {
            "detail_id": "b733e61c-59bc-4ccd-9024-7829138ace9a",
            "text": "客戶退貨商品完成外觀與數量核對，並已入庫或暫置待處理區。"
          }
        ],
        "requirements": [
          {
            "detail_id": "8dee0542-b60a-415b-9b51-3ecdfeb5483d",
            "text": "客戶退貨瑕疵品由品保判定，不由本人判定。"
          }
        ]
      },
      {
        "task_id": "b92656e6-f8f3-4347-9ee3-8cdc380b15e7",
        "area_id": "804bccbb-2b42-4a24-84cc-69e3b684198d",
        "title": "備妥供應商退貨及登記出貨",
        "description": "採購決定退貨後，備妥要退的貨品並登記出貨。",
        "outcomes": [
          {
            "detail_id": "11947193-4124-44a7-aca5-372632173493",
            "text": "待退貨品已備妥，並完成出貨登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "c74c4876-b251-4db2-a9a9-7d3491b2e8f6",
            "text": "是否退貨由採購決定；本人只在採購決定退貨後備妥貨品及登記出貨，不自行決定退貨與否。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "04206626-1083-429a-bd4e-fd992d4ef98a",
        "kind": "skill",
        "name": "到貨單據與實物核對",
        "description": "以採購單、送貨單及實際到貨品項與數量核對收貨內容；上架前使用手持掃描器再次確認品項，發現差異時拍照並通報採購及倉儲主管。"
      },
      {
        "capability_id": "f3ac95aa-c53c-4f9a-b8f6-03035c814af6",
        "kind": "knowledge",
        "name": "倉儲儲位規則",
        "description": "理解物流中心儲位規則及其對上架作業的要求。"
      }
    ],
    "task_links": [
      {
        "task_id": "7b0a705e-c2bb-4b93-b127-6af68b41f778",
        "capability_id": "04206626-1083-429a-bd4e-fd992d4ef98a"
      },
      {
