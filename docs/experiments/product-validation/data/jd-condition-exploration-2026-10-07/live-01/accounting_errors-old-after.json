        "name": "報支申請同事",
        "scope_text": "提交報支資料；資料缺漏時依通知補齊。"
      },
      {
        "collaborator_id": "c3e356c8-c832-409f-beda-21210b35f0a9",
        "name": "主管",
        "scope_text": "接收整理後的報支清單並核准；核准權限屬主管，不屬本人。"
