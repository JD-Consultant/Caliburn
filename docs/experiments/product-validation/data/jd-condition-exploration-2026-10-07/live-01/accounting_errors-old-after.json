        "area_id": "f417e5f6-62db-4e48-a83c-0a0d5bbf82bf",
        "title": "報支資料核對",
        "scope_text": "資料核對、補件及清單交接，不含核准或付款。"
      }
    ],
    "tasks": [
      {
        "task_id": "1b36682b-3e62-44d6-b67c-b4de8c314bb0",
        "area_id": "f417e5f6-62db-4e48-a83c-0a0d5bbf82bf",
        "title": "核對報支並整理送審清單",
        "description": "核對發票、金額和申請單，缺件請申請人補齊；使用報支系統和試算表，清單交主管核准，由出納付款。",
        "outcomes": [
          {
            "detail_id": "9bffe03e-b9c8-42d0-855f-fb47e7f9ea8e",
            "text": "整理出可供主管審核的報支清單；核准後由出納付款。"
          }
        ],
        "requirements": [
          {
            "detail_id": "1e372b0b-72c1-4de4-b31e-06336f96e76d",
            "text": "報支資料齊全且清單交主管後，即完成本人這段處理；不負責核准或付款。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "12bf63be-4218-4263-adaa-11eea107a692",
        "kind": "skill",
        "name": "報支資料核對與缺件追蹤",
        "description": "比對發票、金額與申請單，登記資料缺漏並通知申請人補齊。"
      }
    ],
    "task_links": [
