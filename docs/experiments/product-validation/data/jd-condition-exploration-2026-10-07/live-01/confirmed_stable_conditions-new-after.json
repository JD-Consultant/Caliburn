{
  "profile": {
    "revision_id": "34268d61-477a-452d-8ddc-4ddd644065b8",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "登錄並核對同事已確認的訂單資料，交由主管確認，支援後續訂單處理。"
    }
  },
  "work": {
    "revision_id": "34268d61-477a-452d-8ddc-4ddd644065b8",
    "areas": [
      {
        "area_id": "82bc7d17-8014-4a28-b121-53340f84d86a",
        "title": "訂單資料處理",
        "scope_text": "資料登錄、金額核對與主管交接。"
      }
    ],
    "tasks": [
      {
        "task_id": "5266b561-3563-4c81-ba40-26a757c926fe",
        "area_id": "82bc7d17-8014-4a28-b121-53340f84d86a",
        "title": "登錄並核對訂單",
        "description": "依同事已確認的訂單資料登錄系統並核對金額；資料缺漏時請同事補齊，發現錯誤時先查原始資料，再交主管決定更正。",
        "outcomes": [
          {
            "detail_id": "47e36a21-8b46-4be3-8c05-82f3dca33690",
            "text": "已登錄並核對金額的訂單資料交主管確認。"
          }
        ],
        "requirements": [
          {
            "detail_id": "d5b38bc8-ab03-47e7-aad2-82510d39894c",
            "text": "發現錯誤時不可直接送出，須先查原始資料；更正由主管決定，本人不核准訂單。"
          },
          {
            "detail_id": "56d484fb-8cf7-4053-8d41-8b23b230cfb0",
            "text": "原訂單資料缺漏時，請同事補齊後再登錄。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "a96894b4-d9c8-4f43-80c9-205e89fdb95a",
        "kind": "skill",
        "name": "訂單資料核查與差異處理",
        "description": "依原始資料核查登錄內容及金額，辨識缺漏或錯誤，並按責任界線請同事補件或交主管處理。"
      }
    ],
    "task_links": [
      {
        "task_id": "5266b561-3563-4c81-ba40-26a757c926fe",
        "capability_id": "a96894b4-d9c8-4f43-80c9-205e89fdb95a"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "5afde395-8c6f-4b48-906f-d8d5d54c73a8",
        "name": "同事",
        "scope_text": "提供已確認的訂單資料；資料缺漏時補齊後交由本人登錄。"
      },
      {
        "collaborator_id": "b8c018ac-3d06-47f2-a170-c61a7398620f",
        "name": "主管",
        "scope_text": "接收已登錄並核對的訂單資料；由主管決定錯誤資料如何更正。"
      }
    ],
    "conditions": [
      {
        "condition_id": "105406fa-c67e-4dcc-aa5d-d0310e089b02",
        "kind": "work_environment",
        "text": "固定在同一辦公室工作，無外勤或特殊工作環境。"
      },
      {
        "condition_id": "dfb55ec8-494c-4364-b53a-90333c19a254",
        "kind": "schedule_travel",
        "text": "全年工作量大致穩定，無特殊忙季；時限不因工作量變化而改變。"
      }
    ]
  },
