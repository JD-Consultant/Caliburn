        "title": "訂單資料處理",
        "scope_text": "資料登錄、金額核對與主管交接。"
      }
    ],
    "tasks": [
      {
        "task_id": "0dae7240-f7a7-4e17-9cf3-6f1caf0fdb90",
        "area_id": "f507fab9-49b0-485e-aad6-98a9a439f570",
        "title": "登錄並核對訂單",
        "description": "將同事已確認的訂單資料登錄系統並核對金額；原單缺資料時請同事補齊後再登錄。發現錯誤時先查核原始資料，再交主管決定更正方式。",
        "outcomes": [
          {
            "detail_id": "6c25d568-2a0b-449f-95e2-eccbc1e3d71d",
            "text": "完成登錄與金額核對的訂單交主管。"
          }
        ],
        "requirements": [
          {
            "detail_id": "4cbac136-b3d1-45ae-a04f-8ddf1b65ce26",
            "text": "原單缺資料時須待同事補齊後再登錄；發現錯誤不得直接送出，須先查核原始資料並交主管決定更正方式；本人不核准訂單。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "9e52946e-6102-4bd6-bdd8-faf82098b81a",
        "kind": "skill",
        "name": "訂單資料核對與差異處理",
        "description": "依已確認資料完成訂單登錄與金額核對；發現缺漏或錯誤時查核原始資料，並按責任界線暫停送出及交主管處理。"
      }
    ],
    "task_links": [
