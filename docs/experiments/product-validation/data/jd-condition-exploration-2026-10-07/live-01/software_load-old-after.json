      "purpose": "處理已回報的網站前端問題，供測試驗證及客服追蹤。"
    }
  },
  "work": {
    "revision_id": "65a5557c-a41f-4ceb-b572-7b86a970523c",
    "areas": [
      {
        "area_id": "c084482f-d9dc-45ed-b94d-a3259098d585",
        "title": "網站前端維護",
        "scope_text": "重現、修正及回報前端問題，後端由同事負責。"
      }
    ],
    "tasks": [
      {
        "task_id": "541a5c3e-6ac3-477d-a56e-4eb04ce79aae",
        "area_id": "c084482f-d9dc-45ed-b94d-a3259098d585",
        "title": "處理前端問題單",
        "description": "在辦公室使用問題單系統及版本控制，依客服提供的畫面與操作步驟重現並修正本人負責的前端問題；後端問題交同事處理。收到回報後十二小時內回覆初步判斷；修正後交由測試同事驗證，測試通過並回報結果給客服後結束處理；產品主管決定是否發布。",
        "outcomes": [
          {
            "detail_id": "5c62b970-f27e-41d7-8c2d-249b081a1432",
            "text": "修正本人負責的前端問題，交由測試同事驗證，並將處理結果回報客服。"
          }
        ],
        "requirements": [
          {
            "detail_id": "76528a77-6631-474a-89f7-18e2b8b2399b",
            "text": "收到問題回報後十二小時內回覆初步判斷；此時限不代表須於十二小時內修復。"
          },
          {
            "detail_id": "2bf8aded-d282-47b9-9129-69bc6021a17f",
            "text": "測試通過並將結果回報客服後，才結束該問題的處理。"
          }
        ]
      }
    ],
