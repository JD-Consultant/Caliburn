      "reports_to": "倉儲主管",
      "purpose": "依已確認的到貨及儲位安排，完成收貨與上架並留下入庫紀錄。"
    }
  },
  "work": {
    "revision_id": "900a4531-0985-4d4e-a715-6fdd7d5b5034",
    "areas": [
      {
        "area_id": "7888b58a-1dd1-4131-85fa-defa7074d0e6",
        "title": "收貨與上架",
        "scope_text": "核對到貨品項與數量；數量不符時通知採購；符合者依安排搬運上架並完成入庫登記。"
      }
    ],
    "tasks": [
      {
        "task_id": "ab63b119-155e-4ada-adc6-bcd2c0b557ae",
        "area_id": "7888b58a-1dd1-4131-85fa-defa7074d0e6",
        "title": "核對收貨並完成上架與入庫登記",
        "description": "收貨後核對品項與數量；符合時，依安排搬運至儲位，上架前掃描條碼確認品項、貼標籤，並在庫存系統登記。數量不符時拍照通知採購；收退由採購決定。",
        "outcomes": [
          {
            "detail_id": "7c233d78-c458-498e-87ae-05f97d5d7d57",
            "text": "核對符合的貨品依安排儲位完成上架，並完成入庫紀錄。"
          }
        ],
        "requirements": [
          {
            "detail_id": "a5444dcf-2587-48ec-8c32-034171ca05ee",
            "text": "數量不符時拍照通知採購；收退由採購決定。"
          },
          {
            "detail_id": "037df589-4602-4e2d-b455-e7c0a7a32d28",
            "text": "日常自行搬箱，最重約15公斤；操作堆高機須有操作證照。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "02d13368-0c8c-43ec-8b18-a3b25b26d893",
        "kind": "skill",
        "name": "收貨核對與差異通報",
        "description": "核對到貨品項與數量，發現數量不符時拍照通知採購，並遵守由採購決定收退的責任界線。"
      }
    ],
