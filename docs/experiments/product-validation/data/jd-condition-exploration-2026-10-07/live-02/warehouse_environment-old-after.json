    "profile": {
      "job_title": null,
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "依已確認的到貨及儲位安排，完成收貨與上架並留下入庫紀錄。"
    }
  },
  "work": {
    "revision_id": "fcfe1114-4c93-400a-8fa7-8e5d2d230648",
    "areas": [
      {
        "area_id": "b06410eb-c9f4-402e-a1af-af87851aba50",
        "title": "收貨與上架",
        "scope_text": "核對到貨、異常交接及依安排上架。"
      }
    ],
    "tasks": [
      {
        "task_id": "79528e55-3433-49c7-bf71-2f374181b1fa",
        "area_id": "b06410eb-c9f4-402e-a1af-af87851aba50",
        "title": "核對到貨並完成上架與入庫",
        "description": "核對到貨後依安排搬運與上架，掃碼確認品項、貼標籤及登記入庫；自行搬箱最重約十五公斤，堆高機操作須有證照。",
        "outcomes": [
          {
            "detail_id": "7d612dc8-377a-4018-8273-93d82a413865",
            "text": "貨品依安排放入儲位並完成入庫系統紀錄，作為庫存入帳資訊。"
          }
        ],
        "requirements": [
          {
            "detail_id": "e49d0251-e7e7-450a-a173-374a3efb1a1f",
            "text": "到貨品項與數量核對相符才上架；不符時拍照通知採購，收退由採購決定。"
          },
          {
            "detail_id": "85583382-15cc-4498-8db9-9dcc467f4b0f",
            "text": "上架前掃條碼確認品項並貼標籤；自行搬箱最重約十五公斤，操作堆高機須有操作證照。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "88fd23c9-1b86-4807-87de-7507d2280e4d",
        "kind": "skill",
        "name": "堆高機操作",
        "description": "操作堆高機搬運貨品；此項工作要求持有操作證照。"
      }
    ],
    "task_links": [
