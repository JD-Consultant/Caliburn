      "reports_to": null,
      "purpose": "完成收貨上架及指定盤點，維持貨物和入庫紀錄可追查。"
    }
  },
  "work": {
    "revision_id": "7d84c817-641c-46d7-8bf7-9eef9188a3ff",
    "areas": [
      {
        "area_id": "5d2cecf7-68b2-4b50-a386-bdfa40bb895d",
        "title": "收貨與庫存核對",
        "scope_text": "收貨上架及依不同周期盤點。"
      }
    ],
    "tasks": [
      {
        "task_id": "25a08c3d-ba16-44b5-834c-a5dcaae33883",
        "area_id": "5d2cecf7-68b2-4b50-a386-bdfa40bb895d",
        "title": "收貨驗收與上架",
        "description": "核對單據和實貨，差異拍照通知採購並回報主管，由採購決定收退；符合才依安排上架、貼標籤及登記。",
        "outcomes": [],
        "requirements": [
          {
            "detail_id": "1f0da0a5-e0ed-4635-bace-d7b66a752326",
            "text": "發現差異的貨物先留置等待決定；本人不決定收退，後續處理依採購或主管安排。"
          }
        ]
      },
      {
        "task_id": "f46ae730-5bef-4f5d-9664-715c16bfc0c4",
        "area_id": "5d2cecf7-68b2-4b50-a386-bdfa40bb895d",
        "title": "配合庫存盤點",
        "description": "下班前複點高異動商品；月底點本人區域，十二月配合財務全倉盤點，結果交主管。",
        "outcomes": [
          {
            "detail_id": "661decb7-cdbd-4181-b887-ba0087701d55",
            "text": "完成本人區域或分配範圍的盤點清點，並將結果交主管。"
          }
        ],
        "requirements": [
          {
            "detail_id": "4b1390e9-036e-4083-8a8b-0aa1065c1db5",
            "text": "盤點依不同週期安排，並非每天都進行全部盤點。"
          }
        ]
      }
    ],
