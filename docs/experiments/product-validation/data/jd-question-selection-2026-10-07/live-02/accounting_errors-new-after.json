      }
    ],
    "collaborators": [
      {
        "collaborator_id": "4f41114a-8ac8-4865-ac98-dbe854f519fa",
        "name": "報支申請同事",
        "scope_text": "提交報支資料；有缺件時依通知補齊。"
      },
      {
        "collaborator_id": "efa31799-996f-4426-9972-260b8e52bd31",
        "name": "主管",
        "scope_text": "接收附原始資料的報支清單並決定是否核准。"
      },
      {
        "collaborator_id": "df4273a8-28ce-4738-9625-a98d38a110d0",
        "name": "出納",
        "scope_text": "主管核准後負責付款。"
      }
    ],
    "conditions": [
