{
  "profile": {
    "revision_id": "1becf201-5bd3-477c-a958-c0e6621bad18",
    "profile": {
      "job_title": "帳務助理",
      "organization_unit": null,
      "reports_to": null,
      "purpose": "核對並補齊同事的報支資料，整理清單與原始資料交主管審核，支援後續付款作業。"
    }
  },
  "work": {
    "revision_id": "1becf201-5bd3-477c-a958-c0e6621bad18",
    "areas": [
      {
        "area_id": "c6ad427a-a393-4bcc-9b73-52d6b649f430",
        "title": "報支資料核對",
        "scope_text": "資料核對、補件及清單交接，不含核准或付款。"
      }
    ],
    "tasks": [
      {
        "task_id": "a35cd374-16f0-47b5-88ec-a9c4fc57a4de",
        "area_id": "c6ad427a-a393-4bcc-9b73-52d6b649f430",
        "title": "核對報支並整理送審清單",
        "description": "收到同事的報支資料後，使用公司報支系統及試算表核對發票、金額與申請單；登記缺件並請對方補齊。資料齊全後，整理清單並附原始資料交主管。此工作止於送交主管，不負責核准或付款。",
        "outcomes": [
          {
            "detail_id": "a8bccec3-6780-4f42-b368-f93b1b79e2a9",
            "text": "形成附原始報支資料的清單，交主管審核；主管核准後由出納付款。"
          }
        ],
        "requirements": [
          {
            "detail_id": "3c311bba-9b14-48e9-891a-1ed34a881c1d",
            "text": "發票、申請單與金額相符，缺件補齊後，將清單連同原始資料送主管；是否核准由主管決定，付款由出納處理。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "29a96a72-15ab-430b-b78a-5860c8e6d1df",
        "kind": "knowledge",
        "name": "報支文件與資料核對要求",
        "description": "理解報支發票、申請單、金額及文件齊備性的核對要求。"
      },
      {
        "capability_id": "609785cc-34e4-42de-9c2d-273ffd2ada48",
        "kind": "skill",
        "name": "報支資料核對與缺件追蹤",
        "description": "核對報支資料的一致性，辨識並登記缺件，通知申請人補齊。"
      }
    ],
    "task_links": [
      {
        "task_id": "a35cd374-16f0-47b5-88ec-a9c4fc57a4de",
        "capability_id": "29a96a72-15ab-430b-b78a-5860c8e6d1df"
      },
