      "purpose": "依已確認資料登錄及核對訂單，提供主管確認。"
    }
  },
  "work": {
    "revision_id": "a9da10cc-4865-444e-903a-2e2e2c471207",
    "areas": [
      {
        "area_id": "9e332008-3f07-4533-92bb-05288d70b115",
        "title": "訂單資料處理",
        "scope_text": "資料登錄、金額核對與主管交接。"
      }
    ],
    "tasks": [
      {
        "task_id": "4a844bea-01eb-4430-9cc3-51a3142cfdea",
        "area_id": "9e332008-3f07-4533-92bb-05288d70b115",
        "title": "登錄並核對訂單",
        "description": "依同事已確認的訂單資料登錄系統並核對金額。",
        "outcomes": [
          {
            "detail_id": "38f89706-3a6b-46c5-b68c-71dfc1a4c0ae",
            "text": "完成登錄及金額核對的訂單資料交主管。"
          }
        ],
        "requirements": [
          {
            "detail_id": "7a0ef4dd-bcc3-440b-8667-232378965486",
            "text": "登錄前使用同事已確認的資料；若原單缺資料，請同事補齊後再登錄。"
          },
          {
            "detail_id": "f7e03ed7-ab23-45e4-83a8-cbb27f0017bd",
            "text": "發現錯誤不得直接送出，先核對原資料並交主管決定更正方式；本人不核准訂單。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "b127b067-74c5-495a-988d-59d38dbc67b7",
        "kind": "skill",
        "name": "訂單資料登錄與金額核對",
        "description": "依已確認的訂單資料完成登錄與金額核對，辨識資料缺漏或錯誤，並依責任分工請同事補資料或交主管處理。"
      }
    ],
    "task_links": [
      {
        "task_id": "4a844bea-01eb-4430-9cc3-51a3142cfdea",
        "capability_id": "b127b067-74c5-495a-988d-59d38dbc67b7"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "f404db9d-7a2d-4700-a30f-46f6902d80d9",
        "name": "同事",
        "scope_text": "提供已確認的訂單資料；資料缺漏時依要求補齊。"
      },
      {
        "collaborator_id": "1a7f1380-c3bb-4635-a1b0-064ca7a12d3a",
        "name": "主管",
        "scope_text": "接收完成登錄與核對的訂單資料；訂單資料有錯誤時決定更正方式。"
      }
    ],
    "conditions": [
