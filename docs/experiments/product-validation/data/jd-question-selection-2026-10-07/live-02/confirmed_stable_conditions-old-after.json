    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "依已確認資料登錄及核對訂單，提供主管確認。"
    }
  },
  "work": {
    "revision_id": "ed86d1a9-9a25-4cc7-b567-f8f50c2bc383",
    "areas": [
      {
        "area_id": "3a7213ff-b244-43ca-9079-1cce4f281318",
        "title": "訂單資料處理",
        "scope_text": "資料登錄、金額核對與主管交接。"
      }
    ],
    "tasks": [
      {
        "task_id": "b25f0b66-2a9f-4fd7-940c-dbe4e49e782a",
        "area_id": "3a7213ff-b244-43ca-9079-1cce4f281318",
        "title": "登錄並核對訂單",
        "description": "將同事已確認的訂單資料登錄系統並核對金額；完成後交主管，本人不核准訂單。",
        "outcomes": [
          {
            "detail_id": "8d93ae23-99f8-4070-a10a-107aa8e9c7ea",
            "text": "完成訂單資料登錄與金額核對後交主管。"
          }
        ],
        "requirements": [
          {
            "detail_id": "88ad6f52-cfd8-4f2d-8204-2a77fe74bd64",
            "text": "使用同事已確認的訂單資料；若原單缺資料，請同事補齊後再登錄。"
          },
          {
            "detail_id": "9a39215f-e30a-4adb-9413-e929515d9155",
            "text": "發現錯誤不得直接送出，須先核對原始資料；更正方式由主管決定，本人不核准訂單。"
          },
          {
            "detail_id": "74d3f23f-e8ef-4504-912e-37c28fbe1927",
            "text": "固定在同一辦公室工作，無外勤或特殊環境；全年工作量大致一致，無特殊忙季，時限不因忙季改變。"
          }
        ]
      }
    ],
    "capabilities": [],
    "task_links": [],
    "collaborators": [
      {
        "collaborator_id": "56a5a4c9-2a8e-4b29-a7b7-7a74b27b3b5d",
        "name": "同事",
        "scope_text": "提供已確認的訂單資料；原單缺資料時補齊。"
      },
      {
        "collaborator_id": "8a625b2a-58db-4a5c-96cd-31e39400bb4d",
        "name": "主管",
        "scope_text": "接收已完成登錄與核對的訂單；發現錯誤時決定更正方式。本人不核准訂單。"
      }
    ],
    "conditions": []
  },
