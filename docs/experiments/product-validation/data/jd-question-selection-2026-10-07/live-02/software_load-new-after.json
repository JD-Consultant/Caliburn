{
  "profile": {
    "revision_id": "d1d891a4-d4d3-48bf-879c-84b15ee838df",
    "profile": {
      "job_title": "網站維護工程師",
      "organization_unit": null,
      "reports_to": null,
      "purpose": "處理已回報的網站前端問題，供測試驗證及客服追蹤。"
    }
  },
  "work": {
    "revision_id": "d1d891a4-d4d3-48bf-879c-84b15ee838df",
    "areas": [
      {
        "area_id": "34255980-16d1-46f3-9f0c-43e470ff901e",
        "title": "網站前端維護",
        "scope_text": "重現、修正及回報前端問題，後端由同事負責。"
      }
    ],
    "tasks": [
      {
        "task_id": "ca1d08ba-ea2e-4a1f-932e-f8236b53445c",
        "area_id": "34255980-16d1-46f3-9f0c-43e470ff901e",
        "title": "處理前端問題單",
        "description": "依客服提供的畫面、操作步驟與問題單紀錄重現問題，修正本人負責的前端；若判斷為後端問題，附上資料交同事處理；若無法重現，指出缺少的操作資訊請客服補充。改動後由測試同事驗證，產品主管決定是否發布。",
        "outcomes": [
          {
            "detail_id": "2e9adeeb-094d-4e49-890e-96fab0d899e2",
            "text": "前端修正交由測試驗證；測試通過並將結果回報客服後，該問題單結束。"
          }
        ],
        "requirements": [
          {
            "detail_id": "7a5daff8-2bdc-4bd6-8da1-0cc38cf56d2b",
            "text": "收到客服回報後十二小時內回覆初步判斷；此時限不是要求十二小時內完成修復。"
          },
          {
            "detail_id": "49c52059-8e4c-4628-8a26-43746914dafa",
            "text": "無法重現時須請客服補充缺少的操作資訊，不能直接視為已修復。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "8edd436f-e915-45ab-99e1-794f930e9d02",
        "kind": "skill",
        "name": "前端問題診斷與修正",
        "description": "依畫面、操作步驟及問題紀錄重現問題，判斷前端或後端歸屬，修正負責的前端問題；無法重現時辨識缺少的操作資訊並請求補充。"
      }
    ],
    "task_links": [
      {
        "task_id": "ca1d08ba-ea2e-4a1f-932e-f8236b53445c",
        "capability_id": "8edd436f-e915-45ab-99e1-794f930e9d02"
      }
    ],
