{
  "profile": {
    "revision_id": "d276117f-12bb-4747-a93a-4a8334d428b4",
    "profile": {
      "job_title": "網站維護工程師",
      "organization_unit": null,
      "reports_to": null,
      "purpose": "持續處理已回報的網站前端問題，完成修正與驗證交接，讓客服取得處理結果並追蹤問題。"
    }
  },
  "work": {
    "revision_id": "d276117f-12bb-4747-a93a-4a8334d428b4",
    "areas": [
      {
        "area_id": "66ac4250-e90e-47b4-a2b5-b16a6ceed8c8",
        "title": "網站前端維護",
        "scope_text": "重現、修正及回報前端問題，後端由同事負責。"
      }
    ],
    "tasks": [
      {
        "task_id": "8f7ea47e-3236-4586-b312-4670d2717c50",
        "area_id": "66ac4250-e90e-47b4-a2b5-b16a6ceed8c8",
        "title": "處理前端問題單",
        "description": "通常在辦公室透過問題單系統及版本控制，依客服提供的畫面、操作步驟與問題紀錄重現並修正本人負責的前端問題。無法重現時請客服補充缺少的操作資訊；判斷為後端問題時附上資料交同事處理。修正後由測試同事驗證，測試通過並將結果回報客服後才結束問題單；是否發布由產品主管決定。收到回報後十二小時內回覆初步判斷，不代表須於十二小時內修復。",
        "outcomes": [
          {
            "detail_id": "a8c9bf81-26de-4b06-9042-5c8fa3a0eaef",
            "text": "修正本人負責且可重現的前端問題，交由測試同事驗證，並在測試通過後回報客服，完成問題單處理。"
          }
        ],
        "requirements": [
          {
            "detail_id": "311f2ffd-e87c-4982-88d0-0b96539ed5d5",
            "text": "收到問題回報後十二小時內回覆初步判斷；此時限不代表必須在十二小時內完成修復。問題單須待測試通過且結果回報客服後才結束；無法重現時先請客服補充操作資訊，後端問題交同事處理，不視為本人已修復。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "db527e42-108e-426a-af9e-6ffa12b500a2",
        "kind": "skill",
        "name": "前端問題重現與修正",
        "description": "依問題單提供的操作資訊與紀錄重現前端問題，判斷是否屬於本人負責的前端範圍並完成修正；遇到無法重現或後端問題時，整理缺漏資訊或交接資料。"
      }
    ],
    "task_links": [
      {
        "task_id": "8f7ea47e-3236-4586-b312-4670d2717c50",
        "capability_id": "db527e42-108e-426a-af9e-6ffa12b500a2"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "bab7214b-6461-4c23-add5-6a2a34f04f2a",
        "name": "客服",
        "scope_text": "提供問題畫面及操作步驟；若問題無法重現，依回覆補充缺少的操作資訊；收到修正結果回報後追蹤問題單。"
      },
      {
        "collaborator_id": "f6adeba5-1459-4bac-abd0-43f85598404e",
        "name": "後端同事",
        "scope_text": "遇到判斷為後端的問題時，接收整理的資料並處理後端問題；本人不負責修正後端。"
      },
      {
        "collaborator_id": "8cef3d68-dbe1-4b0c-b8b8-844b08b8ed2f",
        "name": "測試同事",
        "scope_text": "對修正後的前端問題進行測試驗證。"
      },
      {
        "collaborator_id": "902fd897-dbe8-407a-8482-7853f5f4ab1c",
        "name": "產品主管",
        "scope_text": "決定修正內容是否發布；本人不承擔發布決策。"
      }
    ],
    "conditions": []
  },
