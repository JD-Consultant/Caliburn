{
  "profile": {
    "revision_id": "97f9ba8d-6cfc-4cb1-b591-18ac289a4c00",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "完成收貨上架及指定盤點，維持貨物和入庫紀錄可追查。"
    }
  },
  "work": {
    "revision_id": "97f9ba8d-6cfc-4cb1-b591-18ac289a4c00",
    "areas": [
      {
        "area_id": "2a59ca47-a5b8-4984-afde-45f085fdb3db",
        "title": "收貨與入庫作業",
        "scope_text": "核對到貨與相關單據，處理差異交接，並依確認結果完成上架及入庫登記。"
      },
      {
        "area_id": "c791803b-7a90-4e73-b00d-c1455182b062",
        "title": "庫存盤點",
        "scope_text": "依平日、月底及年度安排清點指定品項或區域，配合主管抽查及財務全倉盤點。"
      }
    ],
    "tasks": [
      {
        "task_id": "88efcea4-c6b0-45c7-abc9-071ca470924e",
        "area_id": "2a59ca47-a5b8-4984-afde-45f085fdb3db",
        "title": "收貨驗收與上架",
        "description": "收貨時核對採購單、送貨單與實貨。發現差異時拍照通知採購並回報主管，將貨物暫置待確認區、保留標籤與單據，由採購追蹤並決定收貨或退貨；本人依確認結果執行，不決定收退或調整庫存。符合收貨條件的貨物依安排上架、貼標籤並登記庫存系統。",
        "outcomes": [
          {
            "detail_id": "3bb16732-52ef-4cc5-b5d5-33fc3d6e74e8",
            "text": "符合收貨條件的貨物完成上架、貼標籤及庫存系統登記；差異貨物保留待確認資料，供採購追蹤處理。"
          }
        ],
        "requirements": [
          {
            "detail_id": "fd161d42-e314-4a35-898b-f5615bda38a5",
            "text": "差異貨物須拍照通知採購並回報主管，暫置待確認區並保留標籤與單據；收退及庫存調整由採購決定，本人依確認結果執行。"
          }
        ]
      },
      {
        "task_id": "8f4e6aeb-ee5c-4f99-9927-f84a6432484d",
        "area_id": "c791803b-7a90-4e73-b00d-c1455182b062",
        "title": "配合庫存盤點",
        "description": "平日下班前僅複點異動較多的品項；月底清點本人負責區域並接受主管抽查；每年十二月配合財務進行全倉盤點，完成分配給本人的清點並將結果交主管。上述為不同周期的盤點工作，並非每日都執行全部盤點。",
        "outcomes": [
          {
            "detail_id": "a4908183-be5e-47ef-baac-691d8d8a72cb",
            "text": "完成各周期指定品項、區域或分配範圍的清點；年度盤點結果交主管。"
          }
        ],
        "requirements": []
      }
    ],
    "capabilities": [
      {
        "capability_id": "8320daf2-c5fe-4bd2-8d71-50775630ec3f",
        "kind": "skill",
        "name": "到貨資料核對與差異辨識",
        "description": "對照採購單、送貨單與實際到貨，辨識單據或貨物差異並據實回報。"
      }
    ],
    "task_links": [
      {
        "task_id": "88efcea4-c6b0-45c7-abc9-071ca470924e",
        "capability_id": "8320daf2-c5fe-4bd2-8d71-50775630ec3f"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "c22bd564-95a5-4e81-a1f6-802db205ba56",
        "name": "採購",
        "scope_text": "接收收貨差異通知並追蹤處理、決定收貨或退貨；本人依確認結果執行，不代替採購決策或調整庫存。"
      },
      {
        "collaborator_id": "a2e576aa-231a-4b4a-88f7-151140bbf562",
        "name": "主管",
        "scope_text": "接收收貨差異回報、抽查月底區域盤點，並接收年度盤點結果。"
      },
      {
        "collaborator_id": "f6c002ee-c9ab-4f85-91b0-4bc3a618f524",
        "name": "財務",
        "scope_text": "十二月全倉盤點時配合財務，完成分配給本人的清點範圍。"
      }
    ],
    "conditions": []
  },
