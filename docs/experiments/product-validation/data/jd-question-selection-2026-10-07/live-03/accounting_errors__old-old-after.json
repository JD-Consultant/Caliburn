{
  "profile": {
    "revision_id": "38981ee0-895e-47b7-989f-d3be59d80e75",
    "profile": {
      "job_title": "帳務助理",
      "organization_unit": null,
      "reports_to": null,
      "purpose": "整理可核對的報支資料供主管審核與出納付款。"
    }
  },
  "work": {
    "revision_id": "38981ee0-895e-47b7-989f-d3be59d80e75",
    "areas": [
      {
        "area_id": "352a73ab-57e8-4c54-8510-f3b5ca152e58",
        "title": "報支資料核對",
        "scope_text": "資料核對、補件及清單交接，不含核准或付款。"
      }
    ],
    "tasks": [
      {
        "task_id": "19d0070e-5444-4671-9912-cc7f29ecb450",
        "area_id": "352a73ab-57e8-4c54-8510-f3b5ca152e58",
        "title": "核對報支並整理送審清單",
        "description": "使用公司報支系統及試算表核對同事提交的發票、金額與申請單；登記缺件並請申請人補齊，將核對清單連同原始資料交主管審核。核准由主管決定，付款由出納處理，本人不負責核准或付款。",
        "outcomes": [
          {
            "detail_id": "73f8d20c-062e-4566-ac92-99ad6d07795c",
            "text": "形成資料齊全且附原始資料的報支清單，交主管審核，供後續核准與付款作業。"
          }
        ],
        "requirements": [
          {
            "detail_id": "d7ca0bfa-de10-4064-ae89-9d8165c12def",
            "text": "發票、申請單與金額須相符；缺件須登記並請申請人補齊，資料齊全後連同原始資料送交主管。"
          },
          {
            "detail_id": "0bb7853e-742c-48c2-a9d8-941ab2a042c1",
            "text": "在辦公室處理電子資料，無外勤。"
          }
        ]
      }
    ],
    "capabilities": [],
    "task_links": [],
    "collaborators": [
      {
        "collaborator_id": "ef26714e-1d6e-456e-9dad-36cc3d4a80c0",
        "name": "提出報支資料的同事",
        "scope_text": "提交報支資料；資料缺件時依通知補齊。"
      },
      {
        "collaborator_id": "1651dbc8-5def-4e56-b257-a7fc34596958",
        "name": "主管",
        "scope_text": "接收核對清單及原始資料並決定是否核准；本人不代為核准。"
      },
      {
        "collaborator_id": "4482f7bd-dd45-46a5-8eea-cff24c6571e1",
        "name": "出納",
        "scope_text": "主管核准後負責付款；本人不負責付款。"
      }
    ],
    "conditions": []
  },
