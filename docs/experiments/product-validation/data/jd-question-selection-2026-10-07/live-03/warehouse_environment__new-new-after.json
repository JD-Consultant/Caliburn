{
  "profile": {
    "revision_id": "61565232-b3c4-444a-b123-bcbc9e6296be",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": "倉儲主管",
      "purpose": "確保到貨核對、依安排入庫與入庫紀錄相互一致，使庫存資料反映實際收貨及上架情況。"
    }
  },
  "work": {
    "revision_id": "61565232-b3c4-444a-b123-bcbc9e6296be",
    "areas": [
      {
        "area_id": "403bbd53-598f-4583-b2fb-5eb7e84fb493",
        "title": "收貨與上架",
        "scope_text": "核對到貨、異常交接及依安排上架。"
      }
    ],
    "tasks": [
      {
        "task_id": "4468ae44-5003-4b15-937f-e29a178865ac",
        "area_id": "403bbd53-598f-4583-b2fb-5eb7e84fb493",
        "title": "核對到貨並完成上架登記",
        "description": "依採購單、送貨單與實貨核對品項和數量；相符後依主管安排搬運至指定儲位，上架前掃描條碼確認品項、貼標籤並在庫存系統登記入庫。品項或數量不符時先停止搬運／上架、覆核單據並拍照，通知主管與採購；退貨由採購決定，後續依確認的安排處理，不自行決定。",
        "outcomes": [
          {
            "detail_id": "80d218a0-a805-494f-aab6-0b142735132d",
            "text": "貨品依安排放入指定儲位，並完成入庫紀錄。"
          }
        ],
        "requirements": [
          {
            "detail_id": "506bb253-198a-4710-9037-40db8a7dcbca",
            "text": "上架前須核對品項與數量；不符時先停下、覆核單據並拍照通知主管與採購，之後依確認安排處理，不自行決定；退貨由採購決定。"
          },
          {
            "detail_id": "7752a919-02bb-491c-b663-cd16352ab6c6",
            "text": "自行搬運箱件最重約十五公斤；操作堆高機須有操作證照。"
          }
        ]
      }
    ],
    "capabilities": [
      {
        "capability_id": "868bd276-043d-4faf-bc22-b847c02b9aaf",
        "kind": "skill",
        "name": "收貨核對與異常交接",
        "description": "比對採購單、送貨單與實貨，辨識品項或數量不符並依既定方式停下、覆核與通報，按確認安排處理。"
      },
      {
        "capability_id": "52c7d2a9-83d7-42e6-b24b-dc99d0a277b1",
        "kind": "skill",
        "name": "條碼掃描與庫存入庫登記",
        "description": "以條碼掃描確認品項、完成標籤處理，並在庫存系統登記入庫。"
      },
      {
        "capability_id": "2a5aec63-a549-4388-a504-21198216c61b",
        "kind": "skill",
        "name": "堆高機操作",
        "description": "操作堆高機搬運貨品，並依要求持有操作證照。"
      }
    ],
    "task_links": [
      {
        "task_id": "4468ae44-5003-4b15-937f-e29a178865ac",
        "capability_id": "868bd276-043d-4faf-bc22-b847c02b9aaf"
      },
      {
