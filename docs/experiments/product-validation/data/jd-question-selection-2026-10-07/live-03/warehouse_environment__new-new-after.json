      },
      {
        "task_id": "4468ae44-5003-4b15-937f-e29a178865ac",
        "capability_id": "2a5aec63-a549-4388-a504-21198216c61b"
      }
    ],
    "collaborators": [
      {
        "collaborator_id": "c23f313d-d6b4-4399-a460-81a881efe92b",
        "name": "倉儲主管",
        "scope_text": "接收不符項目的照片與核對資訊，協同確認後續安排；本人依確認安排處理，不自行決定。"
      },
      {
        "collaborator_id": "4c360e0e-8946-45d2-9916-b9d78c38b87e",
        "name": "採購",
        "scope_text": "接收不符項目的照片與核對資訊；退貨由採購決定，後續安排確認後由本人依安排處理。"
      }
    ],
    "conditions": []
  },
