  "before": {
    "profile": {
      "revision_id": "cb28de27-6d80-49b0-a1ff-6a8ca4f4cb86",
      "profile": {
        "job_title": null,
        "organization_unit": "物流中心",
        "reports_to": "倉儲主管",
        "purpose": "核對到貨並依安排完成貨品上架與入庫登記，及時回報差異，以維持入庫與庫存紀錄的正確性。"
      }
    },
    "work": {
      "revision_id": "cb28de27-6d80-49b0-a1ff-6a8ca4f4cb86",
      "areas": [
        {
          "area_id": "bd3e9f29-08ed-44f4-b3e4-6e45db058016",
          "title": "收貨與上架",
          "scope_text": "收貨後核對採購單、送貨單及實貨；不符時停下查核並交主管與採購確認，依安排完成搬運、上架及入庫紀錄。"
        }
      ],
      "tasks": [
        {
          "task_id": "4b4c2db1-e611-423e-b28a-61edbeee4bcd",
          "area_id": "bd3e9f29-08ed-44f4-b3e4-6e45db058016",
          "title": "收貨核對、搬運與上架",
          "description": "核對採購單、送貨單與實際到貨品項及數量；符合後依主管安排的儲位搬運上架，掃描條碼確認品項、貼標籤並在庫存系統登記。品項或數量不符時先停下、核對單據並拍照回報主管與採購，再依確認的安排處理；不自行決定收退。自行搬箱最重約十五公斤，亦操作堆高機。",
          "outcomes": [
            {
              "detail_id": "6aaee997-37ad-40fe-98b2-2095de0a966a",
              "text": "核對無誤的貨品依安排放入儲位，完成條碼確認、貼標及庫存系統入庫紀錄，作為收貨與上架完成的紀錄。"
            }
          ],
          "requirements": [
            {
              "detail_id": "2038e60b-74e1-4c21-b7aa-bd68b7f697d1",
              "text": "品項或數量不符時先停止後續上架，核對單據並拍照交主管與採購；依確認的安排處理，收退由採購決定，員工不自行決定。"
            },
            {
              "detail_id": "1951fbb9-5e74-4872-bc04-ee5cb896db7f",
              "text": "自行搬箱最重約十五公斤；操作堆高機須有操作證照，公司安排考照。"
            }
          ]
        }
      ],
      "capabilities": [
        {
          "capability_id": "6b513413-11e5-4fd9-b1c7-889d291f0777",
          "kind": "knowledge",
          "name": "收貨單據與庫存入帳規則",
          "description": "理解採購單、送貨單與實際到貨品項及數量的核對方式，以及條碼確認、標籤和庫存系統入庫紀錄的要求。"
        },
        {
          "capability_id": "ce4dbba4-37f2-42df-9180-6dbb32eca418",
          "kind": "skill",
          "name": "到貨核對與入庫作業",
          "description": "核對到貨品項與數量、辨識不符並停下查核及回報，依安排完成條碼確認、貼標與系統入庫登記。"
        }
      ],
      "task_links": [
        {
          "task_id": "4b4c2db1-e611-423e-b28a-61edbeee4bcd",
          "capability_id": "6b513413-11e5-4fd9-b1c7-889d291f0777"
        },
        {
          "task_id": "4b4c2db1-e611-423e-b28a-61edbeee4bcd",
          "capability_id": "ce4dbba4-37f2-42df-9180-6dbb32eca418"
        }
      ],
      "collaborators": [
        {
          "collaborator_id": "8bc2acf8-064c-4d8b-b95f-31bfb507e9d5",
          "name": "倉儲主管",
          "scope_text": "依主管安排的儲位上架；到貨品項或數量不符時，核對單據、拍照並向主管及採購回報，再依確認的安排處理。"
        },
        {
          "collaborator_id": "8b9af071-af79-4540-94b9-0e8c75a9486f",
          "name": "採購",
          "scope_text": "到貨品項或數量不符時接收核對結果及照片；收退由採購決定，員工依確認的安排處理，不自行決定收退。"
        }
      ],
      "conditions": []
    },
