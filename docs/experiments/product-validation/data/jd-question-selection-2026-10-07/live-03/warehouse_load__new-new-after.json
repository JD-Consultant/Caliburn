{
  "profile": {
    "revision_id": "e63afa38-2dd2-4f57-9e23-6176c49a88cc",
    "profile": {
      "job_title": null,
      "organization_unit": null,
      "reports_to": null,
      "purpose": "完成收貨上架及指定盤點，維持貨物和入庫紀錄可追查。"
    }
  },
  "work": {
    "revision_id": "e63afa38-2dd2-4f57-9e23-6176c49a88cc",
    "areas": [
      {
        "area_id": "e61ef74a-9e02-408b-9f9d-36710c4982f2",
        "title": "收貨與庫存核對",
        "scope_text": "收貨上架及依不同周期盤點。"
      }
    ],
    "tasks": [
      {
        "task_id": "b424c3c7-e18f-4114-8e1a-e66ff7301743",
        "area_id": "e61ef74a-9e02-408b-9f9d-36710c4982f2",
        "title": "收貨驗收與上架",
        "description": "核對單據和實貨，差異拍照通知採購並回報主管，由採購決定收退；符合才依安排上架、貼標籤及登記。",
        "outcomes": [
          {
            "detail_id": "6c2ffa1a-36a7-4d96-91ae-4f71554067e8",
            "text": "符合條件的貨物完成上架、貼標籤及庫存系統登記；有差異的貨物留在待確認狀態，供採購追蹤處理。"
          }
        ],
        "requirements": [
          {
            "detail_id": "12fb362e-e39f-414b-9844-50121c34bcb8",
            "text": "發現差異時先將貨物放在待確認區並保留標籤與單據；收貨或退貨由採購決定，依確認結果執行，不自行調整庫存。"
          }
        ]
      },
      {
        "task_id": "c3f777a1-0fa0-4204-9393-32f36451be84",
        "area_id": "e61ef74a-9e02-408b-9f9d-36710c4982f2",
        "title": "配合庫存盤點",
        "description": "下班前複點高異動商品；月底點本人區域，十二月配合財務全倉盤點，結果交主管。",
        "outcomes": [
          {
            "detail_id": "cb5d184d-a6db-44bb-8b5d-99ea6a1cf034",
            "text": "完成本人負責範圍的盤點清點並將結果交主管。"
          }
        ],
        "requirements": [
          {
            "detail_id": "ed7330b8-6f61-4692-94e9-a435618936b8",
            "text": "平日下班前只複點異動多的品項；月底清點本人區域；每年十二月配合財務全倉盤點，清點分派範圍。這些周期工作並非每天都全部執行。"
          }
        ]
      }
    ],
    "capabilities": [],
    "task_links": [],
    "collaborators": [],
    "conditions": []
  },
