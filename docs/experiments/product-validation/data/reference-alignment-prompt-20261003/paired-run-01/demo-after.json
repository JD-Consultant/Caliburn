{
  "jd/work": {
    "revision_id": "29b2bd29-c469-4c0f-9f3f-6526f0d6e878",
    "areas": [
      {
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "庫存管理",
        "scope_text": "涵蓋進貨驗收、庫存盤點、缺貨追蹤、客戶退貨核對與庫存狀態登錄，以及每週庫存異常週報。"
      }
    ],
    "tasks": [
      {
        "task_id": "d8aff247-4e68-47ed-be23-5aa4f3fc4d09",
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "進貨驗收與收貨差異追蹤",
        "description": "平日每天約處理 8 至 12 張進貨單；促銷旺季約 15 至 20 張。核對採購單、送貨單與實際到貨商品，並將結果登錄 ERP。數量不符或商品破損時拍照、記錄並通知採購，持續追蹤直至實物、單據與 ERP 紀錄相符；逾約定回覆時間未獲回覆時提醒採購，必要時回報主管。",
        "outcomes": [
          {
            "detail_id": "c59bb654-063b-47ec-95bb-e8171ead0a5f",
            "text": "進貨驗收結果登錄於 ERP，供進貨與庫存資訊查核。"
          },
          {
            "detail_id": "03d8fefe-e2ad-449a-a744-69b1d6bdf442",
            "text": "異常追蹤表記載商品、差異數量、照片、處理進度與預計回覆時間，並追蹤至異常完成處理及結案。"
          }
        ],
        "requirements": [
          {
            "detail_id": "6507d2e6-f1af-4ae0-af39-a5be8dd5bbed",
            "text": "採購負責與供應商協調；退換貨或補貨方式由採購與主管決定，庫存管理專員不自行決定。"
          },
          {
            "detail_id": "992e59c0-2200-4b73-994b-8ce0a8e7d3b1",
            "text": "需更正 ERP 紀錄時，須有主管核准的資料才能處理。"
          },
          {
            "detail_id": "020017a9-eb7f-4bff-bfed-bb35c3c4d2a2",
            "text": "實物、單據與 ERP 紀錄一致後才結案；逾約定回覆時間仍未回覆時提醒採購，必要時回報主管。"
          }
        ]
      },
      {
        "task_id": "f2307c47-2261-4270-98ec-a7992398c600",
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "執行庫存盤點與差異查核",
        "description": "每週抽盤，並在月底與倉庫同事分區進行全盤。發現帳實差異時先確認盤點時間，再查核進貨、出貨及退貨紀錄，判斷是否有實物已移動但 ERP 尚未登錄；仍有差異時與同事複盤，整理差異數量、查核過程及原因交主管確認。需要調整庫存時，依核准的庫存調整單在 ERP 操作，並記錄調整單號與異動紀錄。",
        "outcomes": [
          {
            "detail_id": "5e2145ee-fa15-4caf-aec2-8e153171e13d",
            "text": "盤點差異的數量、查核過程及原因經整理後交主管確認。"
          },
          {
            "detail_id": "1db54e61-3d88-4060-8159-e643e5b42d6d",
            "text": "經核准執行的庫存調整留有調整單號及 ERP 異動紀錄，可供追溯。"
          }
        ],
        "requirements": [
          {
            "detail_id": "7cc0125a-634f-455c-a885-47b0347b5500",
            "text": "每週抽盤優先選擇高單價、出入庫頻繁或過往常出現差異的商品；月底與倉庫同事分區盤點。"
          },
          {
            "detail_id": "1ea53af8-062a-406b-8b9b-159f2b15a71c",
            "text": "ERP 庫存調整須取得核准的庫存調整單後才能操作。"
          }
        ]
      },
      {
        "task_id": "8792d601-df04-44ed-9068-de42b36014c6",
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "缺貨風險確認與補貨追蹤",
        "description": "每天早上從 ERP 查看低於安全庫存的商品，並處理客服或倉庫反映可能缺貨的訂單。核對可用庫存、待出貨訂單及尚未登錄的到貨或退貨，以確認實際缺口；整理缺貨風險清單提供採購，追蹤預計到貨日與數量。若缺口影響當天要出貨的訂單，立即通知客服和倉儲主管，不等週報；其他缺貨逾採購承諾回覆時間仍未獲消息時，先提醒採購，仍未回覆再回報主管。持續更新追蹤，直到補貨驗收入庫、ERP 可用庫存更新且受影響訂單已有處理安排。",
        "outcomes": [
          {
            "detail_id": "d79554b5-9801-4d23-93d3-cbce953f8a6e",
            "text": "缺貨風險與預計到貨日、到貨數量整理於清單提供採購，並持續更新追蹤。"
          },
          {
            "detail_id": "8e08f527-20c2-4b9b-9736-a8a0d627caaf",
            "text": "當天出貨訂單受缺貨影響時，缺口資訊即時通知客服與倉儲主管；追蹤持續至補貨驗收入庫、ERP 可用庫存更新且受影響訂單已有處理安排。"
          }
        ],
        "requirements": [
          {
            "detail_id": "c548c9f6-ced1-40f0-9f35-b00800ee174b",
            "text": "拆單、延後出貨及是否通知客人由相關單位決定；安全庫存標準、採購數量與供應商選擇不由本人決定，也不自行承諾客人交期。"
          },
          {
            "detail_id": "3968b5f4-bad6-4d85-927b-cbcfc5acf20c",
            "text": "本人負責確認庫存資訊並追蹤補貨與受影響訂單安排，不負責保證供應商準時到貨。"
          },
          {
            "detail_id": "1e580391-b7a0-49e2-9656-54b16e33fbd8",
            "text": "缺貨影響當天出貨訂單時須即時通知客服與倉儲主管；其他缺貨超過採購承諾回覆時間未獲消息時，先提醒採購，仍未回覆再回報主管，不等週報。"
          }
        ]
      },
      {
        "task_id": "77a101dc-2fbe-459c-b807-812661d56600",
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "客戶退貨核對與庫存狀態登錄",
        "description": "幾乎每天處理客戶退貨回倉；核對退貨單與實際收到的商品，依倉庫同事檢查確認的狀況登錄為可售或待處理庫存。待處理商品經倉庫同事複檢、倉儲主管確認可售並通知後，由本人核對退貨單號及確認紀錄、更新 ERP 狀態並保留確認與異動紀錄。若退貨單與實收不符，記錄實收商品、數量與照片並標示待確認，請客服查原退貨申請，待倉儲主管確認登錄方式後處理。",
        "outcomes": [
          {
            "detail_id": "262cca50-e906-40b6-8629-40c1706345d3",
            "text": "退貨商品登錄至對應的庫存狀態，供後續庫存作業識別。"
          },
          {
            "detail_id": "d79fa1ca-e1e5-49af-a3a6-b4095395ae80",
            "text": "可售狀態調整留有退貨單號、主管確認紀錄及 ERP 異動紀錄，供後續查核。"
          },
          {
            "detail_id": "37a73214-62a4-4f06-8332-945518630baa",
            "text": "不符的退貨有實收商品、數量及照片紀錄並標示待確認，待客服與主管確認後再依決定處理。"
          }
        ],
        "requirements": [
          {
            "detail_id": "e7d94970-da58-4d17-822c-f339b7465f0e",
            "text": "待處理商品須經倉庫同事複檢、倉儲主管確認可售並通知後，才依退貨單號與確認紀錄調整 ERP 狀態；未收到確認前維持待處理，不自行判定為可售。"
          },
          {
            "detail_id": "27653a78-d430-4cfc-840c-914fb2e375a8",
            "text": "退貨單與實收商品不一致時，先標示待確認並請客服查原退貨申請；倉儲主管確認登錄方式前，不自行更改數量或將商品列為可售。"
          }
        ]
      },
      {
        "task_id": "abc5ca52-0409-4de8-a783-eed327fa95d2",
        "area_id": "941fd434-4d0c-4bb0-971c-7736c269e38d",
        "title": "彙整庫存異常週報",
        "description": "每週彙整尚未結案的收貨差異、盤點差異與缺貨事項，逐項補上目前卡點、處理負責人及預計回覆時間後提供倉儲主管。收貨與缺貨進度向採購確認；盤點差異依複盤及主管確認紀錄更新。尚未確認的事項標示為待回覆，不記為已解決。",
        "outcomes": [
          {
            "detail_id": "4007ca51-6d89-40ab-9671-5e48526e740d",
            "text": "倉儲主管透過週報掌握尚未結案的收貨差異、盤點差異與缺貨事項，以及各項的目前卡點、處理負責人和預計回覆時間。"
          }
        ],
        "requirements": [
          {
            "detail_id": "77697d75-b76b-4590-a425-05aa3566115e",
            "text": "週報須補上各項目前的處理進度；未確認的事項標示為待回覆，不得寫為已解決，而不只是匯出 ERP 報表。"
          }
        ]
      }
    ],
