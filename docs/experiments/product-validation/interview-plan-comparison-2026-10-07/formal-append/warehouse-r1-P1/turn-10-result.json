        },
        {
          "task_id": "32841949-9922-49d4-b229-77551aaa4a8f",
          "area_id": "9dfee5df-277a-46b9-ad9a-eec7cea40121",
          "title": "處理客戶退貨",
          "description": "依客服退貨單核對退回商品的數量、品項及外觀並拍照記錄；按既定規則區分可再上架、待檢及破損隔離。無退貨單或商品不符時先隔離並交客服確認；可再上架商品掃碼入庫，待檢商品交品保，並保留交接紀錄。",
          "outcomes": [
            {
              "detail_id": "81302921-f037-4c92-b2de-f90dc0bf78c1",
              "text": "可再上架商品完成掃碼入庫；待檢商品交品保，無退貨單或商品不符者隔離交客服確認，並保留交接紀錄。"
            }
          ],
          "requirements": [
            {
              "detail_id": "e2d574fa-1620-4c9b-85a9-d796b139dd9e",
              "text": "依既定規則區分可再上架、待檢及破損隔離；不負責決定退款。"
            }
          ]
        },
        {
          "task_id": "de2faa0e-0216-46d7-8ef8-af731dc047cf",
          "area_id": "9dfee5df-277a-46b9-ad9a-eec7cea40121",
          "title": "供應商退貨出庫",
          "description": "依採購提供的退貨單備貨、核對數量、拍照並登記出庫，交承運商簽收，再將簽收資料回給採購；不辦理供應商退貨入庫。",
          "outcomes": [
            {
              "detail_id": "a885cc2c-0fef-47d5-a85d-f22810c32864",
              "text": "供應商退貨完成出庫並由承運商簽收，簽收資料回交採購。"
            }
          ],
          "requirements": [
            {
              "detail_id": "74799724-8462-448d-a73e-bf9f4cae974f",
              "text": "退貨品項由採購決定；本人不決定退貨條件，也不辦理供應商退貨入庫。"
            }
          ]
        },
        {
          "task_id": "1d36c014-c0e1-4aaf-9f73-c3369b8ffd9b",
          "area_id": "1043e6c6-ef34-4c9c-99f0-32bf0fc78f11",
          "title": "倉庫新人帶教與操作觀察",
          "description": "新人第一週示範掃碼、揀貨及安全動線，再讓新人跟著操作；當場觀察並記錄作業情況，向組長回報，是否能獨立上線由主管核准。",
          "outcomes": [
            {
              "detail_id": "06213db9-9752-46b5-9396-c1555e13f981",
              "text": "完成帶教檢核表並向組長回報操作觀察結果；新人是否能獨立上線由主管核准。"
            }
          ],
          "requirements": [
            {
              "detail_id": "47a238c5-8b9e-495f-8e26-b3fe223e726b",
              "text": "當場檢查新人是否漏掃、拿錯批號或走進車道，並記入帶教檢核表；首次漏掃時讓新人重做並解釋原因，反覆錯誤時交組長安排再訓練。"
            }
          ]
        }
      ],
      "capabilities": [
        {
          "capability_id": "531c9100-13c4-44fa-ab3a-4916b3659f16",
          "kind": "skill",
          "name": "批號效期核對與庫位差異追查",
          "description": "依揀貨資訊核實品項、批號及效期，並追查系統庫存與實際儲位不符的情況；不擅自替換批號，需協調時交組長處理。"
        },
        {
          "capability_id": "7d2369ff-5d31-44b6-bfd9-4ab704730f46",
          "kind": "skill",
          "name": "新人現場帶教與觀察回報",
          "description": "透過示範與跟做觀察帶教新人，依檢核表記錄掃碼、批號及安全動線操作；首次漏掃時讓新人重做並解釋原因，反覆錯誤時交組長安排再訓練，並回報操作觀察結果。"
        }
      ],
      "task_links": [
        {
          "task_id": "1d36c014-c0e1-4aaf-9f73-c3369b8ffd9b",
          "capability_id": "7d2369ff-5d31-44b6-bfd9-4ab704730f46"
        },
        {
          "task_id": "38d62fac-8ebb-4d84-b973-581da9a0bae4",
          "capability_id": "531c9100-13c4-44fa-ab3a-4916b3659f16"
        }
      ],
      "collaborators": [
        {
          "collaborator_id": "a58df641-0558-4106-a10f-123cd594cc30",
          "name": "採購",
          "scope_text": "收貨差異時接收通知並回覆補送或接受的處理方式；供應商退貨時決定退貨品項並提供退貨單。倉庫管理員依採購回覆登記入庫、按退貨單備貨並登記出庫，將承運商簽收資料回交採購。"
        },
        {
          "collaborator_id": "db432533-015d-475f-bde2-a806f26fd580",
          "name": "客服",
          "scope_text": "接收無退貨單或退回商品不符的隔離品，確認後續處理；倉庫管理員不負責決定退款。"
        },
        {
          "collaborator_id": "d6d47016-9853-4f21-8461-1db2df1dab76",
          "name": "品保",
          "scope_text": "接收待檢的客戶退貨商品；倉庫管理員保留交接紀錄。"
        },
        {
          "collaborator_id": "e00fdec8-e566-41d3-8f84-65e900ea8153",
          "name": "承運商",
          "scope_text": "接收供應商退貨貨品並簽收；倉庫管理員將簽收資料回交採購。"
        },
        {
          "collaborator_id": "e3e3b11f-ace3-4aea-a5ea-fb0dfc79838c",
          "name": "包裝區",
          "scope_text": "接收揀貨完成的商品進行複核；倉庫管理員負責將揀貨交接至包裝區。"
        },
        {
          "collaborator_id": "4766ef0e-d6b6-4fcd-a6f1-cee42e51f7f4",
          "name": "組長",
          "scope_text": "接收新人操作觀察回報；新人反覆錯誤時安排再訓練。另協調系統顯示有庫存但儲位空置的揀貨異常，倉庫管理員先查移庫情況及前一波次，再交組長協調。"
        },
        {
          "collaborator_id": "af2d56f0-2e56-40f0-b3d8-d7ef1a6bd099",
          "name": "主管",
          "scope_text": "核准新人是否可以獨立上線；帶教人將操作觀察結果回報組長。"
        }
      ],
      "conditions": [
        {
          "condition_id": "f1aac24e-654c-4522-b054-2fd0b252b90a",
          "kind": "schedule_travel",
          "text": "早上 7 點上班，週一至週六輪休。"
        }
      ]
    },
