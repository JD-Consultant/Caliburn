        "organization_unit": "物流中心",
        "reports_to": "倉儲主管",
        "purpose": "負責物流中心貨品收貨驗收、庫內存放與揀補、庫存盤點及退貨處理等倉儲工作，維持貨品與庫存作業順暢，並協助新人熟悉工作。"
      }
    },
    "work": {
      "revision_id": "8d2a7f4f-6a01-4c64-a38a-1eb5452d2b45",
      "areas": [
        {
          "area_id": "e650a1ba-1d19-4a47-8e09-d908ce4d3edc",
