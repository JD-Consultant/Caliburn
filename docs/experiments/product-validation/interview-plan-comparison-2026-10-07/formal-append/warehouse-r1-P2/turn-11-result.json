            }
          ]
        },
        {
          "task_id": "b14b3306-df8c-495e-a1eb-d6bc99e5659d",
          "area_id": "5d25184f-903a-4116-979f-8a41e4bc8542",
          "title": "依規劃儲位上架並登記入庫",
          "description": "依已規劃的儲位放置貨品、貼上品項與批號標籤，使用 WMS 掃碼登記入庫，並確認實物位置與系統儲位一致。臨時放不下時向組長尋求調整，不自行改儲位規則；常溫貨使用棧板車，超重貨請有操作證照的同事開堆高機。",
          "outcomes": [
            {
              "detail_id": "53841b66-b01a-46bd-ab34-b642734f40c5",
              "text": "貨品依規劃儲位完成上架、品項與批號標示及 WMS 入庫登記。"
            },
            {
              "detail_id": "a59b5ba9-0241-4318-84d0-b380830aa4ab",
              "text": "實物儲位與 WMS 登記的儲位保持一致。"
            }
          ],
          "requirements": [
            {
              "detail_id": "5bf39522-347c-45b7-bc86-68706b160d39",
              "text": "遇臨時儲位放不下時，先找組長調整位置，不自行更改儲位規則。"
            },
            {
              "detail_id": "ec43ed80-e4bb-42e3-8130-cc468183fe99",
              "text": "常溫貨使用棧板車；超重貨由有操作證照的同事駕駛堆高機。"
            }
          ]
        },
        {
          "task_id": "449ddcfd-9795-443f-9705-3a0742eb4c34",
          "area_id": "46f34626-eb59-4b2c-91a6-32988277027c",
          "title": "依出貨波次單揀貨並交包裝區複核",
          "description": "依出貨波次單揀貨，核對品項、數量、批號與效期，完成後交包裝區複核。若系統顯示有貨但儲位為空，先查移庫與前一波次，不擅自以其他批號替代；異常交組長協調。",
          "outcomes": [
            {
              "detail_id": "33faf70f-11c7-430f-ab3f-ae1a9583d7f7",
              "text": "完成出貨波次揀貨並交包裝區複核。"
            }
          ],
          "requirements": [
            {
              "detail_id": "b8bfa9b2-3e69-48e1-8572-91f94d031c80",
              "text": "核對品項、數量、批號與效期，並於截單時間前完成揀貨。"
            },
            {
              "detail_id": "ea638060-83c4-40ed-a09e-d878c165551c",
              "text": "系統有貨但儲位空時，先查移庫與前一波次，不擅自拿其他批號替代；異常交組長協調。"
            }
          ]
        },
        {
          "task_id": "5184e39b-cc94-4575-9fa5-9283eeb48a71",
          "area_id": "46f34626-eb59-4b2c-91a6-32988277027c",
          "title": "補充揀貨區貨品",
          "description": "揀貨區貨品不足時，從備貨區補貨。",
          "outcomes": [
            {
              "detail_id": "4da35d96-579f-4a88-bffe-1d616a85cf11",
              "text": "揀貨區不足時，從備貨區補充貨品以支援揀貨。"
            }
          ],
          "requirements": []
        },
        {
          "task_id": "9f10f931-b762-4383-a276-c5c46f6fb2a9",
          "area_id": "e00bd1cf-9adf-4dc3-84ab-12b882726019",
          "title": "執行每週循環盤點及差異複點",
          "description": "每週執行循環盤點；盤點發現差異時，先查最近的入庫、出庫及移庫紀錄，再進行複點。",
          "outcomes": [],
          "requirements": []
        },
        {
          "task_id": "ec7ed5b6-fe2d-430e-90dd-00b9eda0c5de",
          "area_id": "092b2d24-4544-4ef0-b4d6-e1ff32780d44",
          "title": "示範並觀察新進員工的倉庫作業",
          "description": "新人第一週示範掃碼、揀貨與安全動線，讓新人跟著操作；當場觀察是否漏掃、拿錯批號或進入車道，並記錄於帶教檢核表。將觀察結果回報組長；新人能否獨立上線由主管核准。",
          "outcomes": [
            {
              "detail_id": "9cf2c982-d2fe-41cd-a938-38ad53406a6f",
              "text": "完成新人操作觀察的檢核表記錄並向組長回報；是否核准新人獨立上線由主管決定。"
            }
          ],
          "requirements": [
            {
              "detail_id": "37060b45-8b6d-46ff-bb54-d69b7481ad79",
              "text": "首次漏掃時，讓新人重做並說明原因。"
            },
            {
              "detail_id": "8d104937-4fcd-43bd-84fa-87dbd43fc2a2",
              "text": "若反覆出現錯誤，交由組長安排再訓練。"
            }
          ]
        },
        {
          "task_id": "60ad64e2-8f32-480e-a1d9-d43e90bfe66a",
          "area_id": "cc805ce5-4d63-4e66-9bbb-bee906139954",
          "title": "檢查並分流客戶退貨",
          "description": "依客服退貨單核對退回商品的數量、品項和外觀，拍照記錄，並按既定規則區分為可再上架、待檢或破損隔離。無單或商品不符時先隔離並交客服確認；可再上架商品掃碼入庫，待檢商品交品保並保留交接紀錄。",
          "outcomes": [
            {
              "detail_id": "2b4ace75-5b4c-47cb-9629-bf85730bb451",
              "text": "可再上架商品完成掃碼入庫；待檢商品交品保並保留交接紀錄。"
            },
            {
              "detail_id": "52f87591-41ee-4e18-9e27-e17e4a92c194",
              "text": "退貨依既定規則分類為可再上架、待檢或破損隔離；無單或商品不符時隔離並交客服確認。"
            }
          ],
          "requirements": [
            {
              "detail_id": "18c8358d-7e1e-4f5c-9e99-ac9b4ca8a4ba",
              "text": "依客服退貨單核對退貨品項、數量與外觀並拍照記錄；不決定退款。"
            },
            {
              "detail_id": "f40766f3-a47a-4b37-a4f1-52042daf35fb",
              "text": "無退貨單或商品與退貨單不符時，先隔離並交客服確認。"
            }
          ]
        }
      ],
      "capabilities": [
        {
          "capability_id": "67572385-c1a8-4772-91c6-050e2cbdd958",
          "kind": "knowledge",
          "name": "客戶退貨分類規則",
          "description": "理解既定分類規則，以區分可再上架、待檢及破損隔離的退貨商品。"
        }
      ],
      "task_links": [
        {
          "task_id": "60ad64e2-8f32-480e-a1d9-d43e90bfe66a",
          "capability_id": "67572385-c1a8-4772-91c6-050e2cbdd958"
        }
      ],
      "collaborators": [
        {
          "collaborator_id": "492295b4-1cdd-4ec2-a6ba-59dc0f55faf3",
          "name": "組長",
          "scope_text": "員工上架遇臨時無法放置時，向組長請求調整位置；揀貨遇異常時交由組長協調；帶教新人時向組長回報觀察結果，遇反覆錯誤由組長安排再訓練。員工不自行更改儲位規則。"
        },
        {
          "collaborator_id": "157109af-7792-4a2a-b252-a355e65f0654",
          "name": "具堆高機操作證照的同事",
          "scope_text": "超重貨由有證照的同事操作堆高機。"
        },
        {
          "collaborator_id": "f9f0174b-e180-403d-bb95-af6a5652e156",
          "name": "包裝區",
          "scope_text": "接收揀貨完成的貨品並進行複核。"
        },
        {
          "collaborator_id": "f9a5be8e-b1a3-4b7d-8ee0-6bca654b199f",
          "name": "新進員工",
          "scope_text": "新人第一週跟隨倉庫管理員學習掃碼、揀貨及安全動線並實際操作；倉庫管理員觀察、記錄並評估其能否自行上線。"
        },
        {
          "collaborator_id": "ad553697-22bb-41b5-8304-c87ba7442a17",
          "name": "主管",
          "scope_text": "核准新人是否可以獨立上線。"
        },
        {
          "collaborator_id": "4a5e3701-7c65-4c2a-b08a-e7027faf5bc6",
          "name": "客服",
          "scope_text": "接收無退貨單或商品與退貨單不符的商品確認事項。"
        },
        {
          "collaborator_id": "a513a2c8-c959-4cdc-975d-8924fd70f507",
          "name": "品保",
          "scope_text": "接收待檢的客戶退貨商品。"
        }
      ],
      "conditions": [
        {
          "condition_id": "6f48db95-7fa0-4919-b36b-110588639498",
          "kind": "schedule_travel",
          "text": "早上 7 點上班；週一至週六輪休。"
        }
      ]
    },
