{
  "profile": {
    "revision_id": "cdf9c567-75b0-4229-b4e9-ccb7665b7c55",
    "profile": {
      "job_title": "倉庫管理員",
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "負責物流中心貨品收貨驗收、上架、揀貨補貨、庫存盤點及退貨處理，支援貨物流轉與倉儲作業；並協助帶領新人。"
    }
  },
  "work": {
    "revision_id": "cdf9c567-75b0-4229-b4e9-ccb7665b7c55",
    "areas": [
      {
        "area_id": "ef1853d5-68e8-4c2c-a78f-a7712cfd0d45",
        "title": "收貨、儲位與庫存作業",
        "scope_text": "涵蓋進貨驗收、貨品上架、揀貨補貨與庫存盤點。"
      },
      {
        "area_id": "0f056ba1-5d95-498a-bff4-0c2d856e3438",
        "title": "退貨處理",
        "scope_text": "處理客戶退貨與供應商退貨相關工作。"
      },
      {
        "area_id": "8141d3ff-dfed-42b8-9ec2-c5ab575027a1",
        "title": "新人帶領",
        "scope_text": null
      }
    ],
    "tasks": [
      {
        "task_id": "ec325ff8-2ffb-4304-b632-75c1529af5f0",
        "area_id": "ef1853d5-68e8-4c2c-a78f-a7712cfd0d45",
        "title": "收貨驗收及差異處理",
        "description": "逐箱點件，核對品項、數量、外包裝與送貨單。發現差異時拍照、登記收貨異常表並通知採購；依採購回覆補送或接受後，再按結果登記入庫。",
        "outcomes": [
          {
            "detail_id": "5937ca3f-55f9-4706-82c4-6c83a7e42671",
            "text": "完成與採購回覆相符的入庫登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "6a2d4370-10f9-4d4a-b3c9-d7641726c92b",
            "text": "不議價、不選供應商，也不決定是否拒收或退換貨。"
          }
        ]
      },
      {
        "task_id": "c5bf08d6-2adf-45bf-aa85-35e255df784c",
