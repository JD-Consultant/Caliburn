    "capabilities": [
      {
        "capability_id": "67e5da6e-8eec-42e1-b49b-cbc125f242bc",
        "kind": "skill",
        "name": "到貨核對與異常記錄",
        "description": "逐箱核對到貨品項、數量、外包裝與送貨單，辨認並記錄差異，依採購回覆銜接入庫登記。"
      }
    ],
