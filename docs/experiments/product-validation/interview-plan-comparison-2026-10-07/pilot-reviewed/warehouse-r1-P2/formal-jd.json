    "collaborators": [
      {
        "collaborator_id": "c89cec32-5962-4da3-b9da-6d0905fcf45e",
        "name": "採購",
        "scope_text": "接收收貨差異的照片及異常登記，回覆補送或接受的處理方式；倉庫管理員依回覆辦理入庫登記，不負責議價或選擇供應商。"
      }
    ],
    "conditions": [
      {
        "condition_id": "0f450e5b-7d48-406d-9961-1d82fb383484",
        "kind": "schedule_travel",
        "text": "早上 7 點上班，週一至週六輪休。"
      }
    ]
  },
