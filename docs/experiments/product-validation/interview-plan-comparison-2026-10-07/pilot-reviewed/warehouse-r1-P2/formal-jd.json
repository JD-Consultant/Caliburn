{
  "profile": {
    "revision_id": "3323cf20-b7c8-48a9-a9cc-9e489a9bf51b",
    "profile": {
      "job_title": "倉庫管理員",
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "執行物流中心倉庫的收貨驗收、上架、揀貨補貨、庫存盤點及退貨作業，並帶領新人，支持倉庫日常貨物流轉與庫存管理。"
    }
  },
  "work": {
    "revision_id": "3323cf20-b7c8-48a9-a9cc-9e489a9bf51b",
    "areas": [
      {
        "area_id": "3856b57e-f8d4-48e4-9e59-8ef9eed2605d",
        "title": "收貨驗收與上架",
        "scope_text": "負責進貨收貨驗收及貨品上架作業。"
      },
      {
        "area_id": "b2f54102-ae8b-4e6e-95bd-eaf0970cac11",
        "title": "揀貨與補貨",
        "scope_text": "負責倉庫揀貨及補貨作業。"
      },
      {
        "area_id": "5ba05012-8c9c-4603-bc2a-df3b3cc2c68f",
        "title": "庫存盤點",
        "scope_text": "負責倉庫庫存盤點作業。"
      },
      {
        "area_id": "db15a6f1-6901-4c83-b391-3f5f03d65a40",
        "title": "客戶與供應商退貨",
        "scope_text": "負責客戶退貨及供應商退貨作業。"
      },
      {
        "area_id": "3b1bf368-9004-43fc-9be5-978eddcd49fb",
        "title": "新人帶教",
        "scope_text": "負責帶領倉庫新人。"
      }
    ],
    "tasks": [
      {
        "task_id": "990e37af-ab4d-4859-8c86-4b721c2db861",
        "area_id": "3856b57e-f8d4-48e4-9e59-8ef9eed2605d",
        "title": "執行進貨收貨驗收與上架",
        "description": "逐箱點件，核對品項、數量、外包裝及送貨單，並對照採購單與實收數量；發現差異時拍照、登記收貨異常表並通知採購。",
        "outcomes": [
          {
            "detail_id": "0f899ad7-e25c-4171-af26-33dd24547664",
            "text": "依採購對差異所回覆的補送或接受方式，按處理結果辦理入庫登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "af2119f6-c9f6-418d-9e14-35f439671f08",
            "text": "進貨差異須依採購回覆處理後才登記入庫；本人不負責議價、選擇供應商或決定拒收。"
          }
        ]
      },
      {
        "task_id": "ae7ebca0-7ca0-41d2-ba88-9bed0548d2c4",
        "area_id": "b2f54102-ae8b-4e6e-95bd-eaf0970cac11",
        "title": "執行揀貨",
        "description": "依出貨波次單揀貨；揀貨區不足時從備貨區補貨。",
        "outcomes": [
          {
            "detail_id": "b2111767-8a79-4caf-b76c-40c5281c3a45",
            "text": "完成波次揀貨後交包裝區複核。"
          }
        ],
        "requirements": [
          {
            "detail_id": "57d31ebc-de61-4c39-bd4a-946a7e57b358",
            "text": "揀貨時核對品項、數量、批號及效期，並於截單時間前完成。"
          },
          {
            "detail_id": "48d78799-c6b1-447f-a645-3ac964dfb8d2",
            "text": "系統顯示有庫存但儲位空時，先查移庫與前一波次；不擅自改用其他批號，異常交組長協調。"
          }
        ]
      },
      {
        "task_id": "6907d97b-9cc6-48b2-8b56-2a1c4d8e3ccb",
        "area_id": "b2f54102-ae8b-4e6e-95bd-eaf0970cac11",
        "title": "執行補貨",
        "description": "負責倉庫補貨作業。",
        "outcomes": [],
        "requirements": []
      },
