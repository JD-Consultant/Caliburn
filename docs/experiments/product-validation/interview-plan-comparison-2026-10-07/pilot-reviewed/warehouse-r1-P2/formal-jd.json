    ],
    "capabilities": [
      {
        "capability_id": "c8051b13-f02d-49b0-a8e8-f6d26e22fb14",
        "kind": "skill",
        "name": "到貨核對與異常紀錄",
        "description": "逐箱清點到貨，核對品項、數量、外包裝與收貨文件，辨識差異並以異常紀錄、照片通報。"
      },
      {
        "capability_id": "c7e39274-53c3-4598-8deb-57a6b374a73a",
        "kind": "skill",
        "name": "庫存與儲位異常查核",
        "description": "系統顯示有庫存但儲位無貨時，查核移庫與前一波次，不擅自以其他批號替代，並將異常交由組長協調。"
      }
    ],
    "task_links": [
