      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "執行物流中心收貨驗收、上架、揀貨補貨、庫存盤點與退貨處理，並帶領新人，支援倉庫日常作業。"
    },
    "work": {
      "revision_id": "c420d2c0-1d87-4360-949c-9f5f8d41f547",
      "areas": [
        {
          "area_id": "8a83b931-0347-4acb-976e-b8659aa74cb3",
          "title": "收貨與入庫",
          "scope_text": "負責進貨驗收與上架；查核數量差異並通報採購，依採購回覆登記入庫；拒收或退換貨不由本人決定。"
        },
        {
          "area_id": "7c81b480-22ac-4b86-acbc-64f621d778b7",
          "title": "揀貨、補貨與庫存",
          "scope_text": "負責揀貨、補貨及庫存盤點作業。"
        },
        {
          "area_id": "ca918d06-431d-479e-a3ff-785e860fa403",
          "title": "退貨作業",
          "scope_text": "涵蓋客戶退貨的檢查、分類、入庫、隔離與交接，以及依採購決定辦理供應商退貨出庫；本人不決定客戶退款或供應商退貨條件。"
        },
        {
          "area_id": "3c4aac42-ac03-4427-a63a-540fb7725dfa",
          "title": "新人帶教",
          "scope_text": "新人第一週由本人示範、帶做並記錄操作觀察，向組長回報；反覆錯誤由組長安排再訓練，新人是否能獨立上線由主管核准。"
        },
        {
          "area_id": "8d5b4c46-557f-4bb3-9f2d-e67da0c044f9",
          "title": "班別交接",
          "scope_text": "於晚班交接未完成波次、缺貨與隔離貨的位置，並留下交班紀錄，銜接後續作業。"
        },
        {
          "area_id": "28d44ef4-5bc9-40f0-a86d-35f40a8f5410",
          "title": "冷藏貨品溫控",
          "scope_text": "負責冷藏食品區每日早晚溫度檢查及超標批次隔離、記錄與通報；不自行放行冷藏貨品，能否出貨由品保決定。"
        }
      ],
      "tasks": [
        {
          "task_id": "26979991-707e-4e99-bdc8-664de26bce8f",
          "area_id": "8a83b931-0347-4acb-976e-b8659aa74cb3",
          "title": "收貨驗收與上架",
          "description": "負責進貨驗收與上架。收貨時逐箱點件，核對品項、數量、外包裝、送貨單與採購單；差異拍照、登記收貨異常表並通知採購，收到採購關於補送或接受的回覆後，依結果登記入庫。上架時按已規劃儲位放貨、貼品項及批號標籤，掃碼於 WMS 登記入庫，並確認實物與系統儲位一致。臨時放不下時先找組長調位，不自行改儲位規則；常溫貨用棧板車，超重貨由有證照同事操作堆高機。本人不議價、不選供應商，也不決定拒收或退換貨。",
          "outcomes": [
            {
              "detail_id": "25f8004a-47a1-4c17-b3ae-d942db497881",
              "text": "進貨差異拍照佐證、登記於收貨異常表並通知採購。"
            },
            {
              "detail_id": "1dcd078c-1b90-4699-af5b-0fe982dc1e66",
              "text": "收到採購關於補送或接受的回覆後，依回覆結果登記入庫。"
            },
            {
              "detail_id": "46101c5e-bd18-4be7-a74f-fc22395d49fe",
              "text": "貨品依已規劃儲位上架並貼品項、批號標籤；以 WMS 掃碼登記入庫，確認實物與系統儲位一致。"
            }
          ],
          "requirements": [
            {
              "detail_id": "ed2f6335-e8db-4cfa-808a-c433d41c92a8",
              "text": "拒收或退換貨不由本人決定。"
            },
            {
              "detail_id": "e5ffb8f8-0e7f-45b6-aab4-5014bfaa68e4",
              "text": "不議價或選擇供應商。"
            },
            {
              "detail_id": "afea408e-c467-49b4-bb2b-a2b16642bcc0",
              "text": "臨時無法放入已規劃儲位時，先由組長協調調整位置，不自行更改儲位規則。"
            },
            {
              "detail_id": "5d404f20-5722-46f6-92e3-b06415179d4a",
              "text": "常溫貨以棧板車處理；超重貨由有證照同事操作堆高機。"
            }
          ]
        },
        {
          "task_id": "eeb9c6c6-a478-44d8-b5dd-1fd6d46ffaf8",
          "area_id": "7c81b480-22ac-4b86-acbc-64f621d778b7",
          "title": "揀貨",
          "description": "依出貨波次單揀貨，核對品項、數量、批號及效期。系統顯示有貨但儲位空缺時，先查移庫與前一波次；不擅自拿其他批號替代，異常交組長協調。雙十一及春節前出貨量約為平日兩倍；依組長安排的急單與波次調整揀貨順序，先回報人力與缺貨瓶頸。",
          "outcomes": [
            {
              "detail_id": "6ea3b099-422b-4f3a-a964-b29522ca7ed0",
              "text": "揀貨完成後交包裝區複核。"
            }
          ],
          "requirements": [
            {
              "detail_id": "ba06e9b8-2a7e-41fb-8792-5f2e65236e2e",
              "text": "須於截單時間前完成揀貨。"
            },
            {
              "detail_id": "5fec1429-7a4e-4a55-ae71-07c5738cdd1e",
              "text": "系統顯示有貨但儲位空缺時，不擅自拿其他批號替代，並將異常交組長協調。"
            },
            {
              "detail_id": "89e83b68-a725-4674-9f99-6c9d75527bf7",
              "text": "雙十一及春節前出貨量約為平日兩倍，調整揀貨順序時仍須完成批號與效期核對。"
            }
          ]
        },
        {
          "task_id": "e4c70b8a-6649-42d6-a468-8d8d2a1b0e43",
          "area_id": "7c81b480-22ac-4b86-acbc-64f621d778b7",
          "title": "補貨",
          "description": "揀貨區不足時，從備貨區補貨。",
          "outcomes": [
            {
              "detail_id": "badd3171-ef85-456e-bef6-f13bf2405dbe",
              "text": "將備貨區貨品補至揀貨區，供揀貨作業使用。"
            }
          ],
          "requirements": []
        },
        {
          "task_id": "42de1695-45c6-4b94-8510-ebcecfc361b9",
          "area_id": "7c81b480-22ac-4b86-acbc-64f621d778b7",
          "title": "庫存盤點",
          "description": "每週進行循環盤點；差異時查近期入庫、出庫與移庫紀錄後複點，將差異、查過的單據及原因記在盤點差異表，交倉儲主管核准。主管交財務調帳後，於結案前核對更新後數量。",
          "outcomes": [
            {
              "detail_id": "6e310c28-ac17-4750-a976-623904d86540",
              "text": "完成盤點差異表並提交倉儲主管核准。"
            },
            {
              "detail_id": "4008e7ab-5c83-4b23-8a58-d857e9e07e94",
              "text": "財務調帳後，於結案前核對更新後的庫存數量。"
            }
          ],
          "requirements": [
            {
              "detail_id": "c53332a8-cfcb-4b7f-87f9-f0aaf074d29b",
              "text": "每週進行循環盤點。"
            },
            {
              "detail_id": "6c37a531-e93a-4a87-a06b-1cf17ecd03b5",
              "text": "本人不直接更改庫存數量；由倉儲主管核准並交財務調帳。"
            },
            {
              "detail_id": "c13cc311-8eae-4484-ae00-be94102b2407",
              "text": "找不到差異原因時保留待查。"
            }
          ]
        },
        {
          "task_id": "361d04c7-7e07-4932-9149-29bcecb8514a",
          "area_id": "7c81b480-22ac-4b86-acbc-64f621d778b7",
          "title": "配合年度全倉盤點",
