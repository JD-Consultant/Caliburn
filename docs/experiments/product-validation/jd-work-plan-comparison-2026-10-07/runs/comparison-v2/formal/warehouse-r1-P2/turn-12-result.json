          "name": "組長",
          "scope_text": "協調揀貨異常。"
        },
        {
          "collaborator_id": "4b87d449-229d-4802-ba24-1f2cf116a5a5",
          "name": "新進人員",
          "scope_text": "接受掃碼、揀貨及安全動線示範，跟著實作並接受現場觀察與帶教評估。"
        },
        {
          "collaborator_id": "6fa1efd3-a997-42e1-b075-a546bea67c3b",
          "name": "倉儲主管",
          "scope_text": "核准員工提交的盤點差異表，並將核准的差異交財務調帳。"
        },
        {
          "collaborator_id": "5b205ceb-f137-4f73-83dc-277a4ca0ac91",
          "name": "客服",
          "scope_text": "提供客服退貨單；無單或商品不符時接收退貨品項以確認。"
        },
        {
          "collaborator_id": "3439808a-95cd-44f6-9ed0-693a150cece7",
          "name": "品保",
          "scope_text": "接收分類為待檢的客戶退貨商品。"
        }
      ],
      "conditions": []
    },
