    ],
    "collaborators": [
      {
        "collaborator_id": "b5045091-9fe5-43a7-b650-e04843643be4",
        "name": "採購",
        "scope_text": "在進貨數量差異時接收員工通知，並回覆補送或接受的處理結果；員工依回覆辦理入庫登記。"
      }
    ],
