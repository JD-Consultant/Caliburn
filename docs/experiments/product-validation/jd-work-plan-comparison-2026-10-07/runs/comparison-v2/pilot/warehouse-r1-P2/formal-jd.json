{
  "profile": {
    "revision_id": "d550c913-ec57-494f-89a4-6e756281653c",
    "profile": {
      "job_title": "倉庫管理員",
      "organization_unit": "物流中心",
      "reports_to": "倉儲主管",
      "purpose": "負責物流中心收貨驗收、貨物上架與揀補、庫存盤點、退貨處理及新人帶教，支援貨物流轉、庫存管理與新人上線準備。"
    }
  },
  "work": {
    "revision_id": "d550c913-ec57-494f-89a4-6e756281653c",
    "areas": [
      {
        "area_id": "c575f26b-e927-4f91-9ca2-0e36d9a98d38",
        "title": "收貨與入庫管理",
        "scope_text": "負責物流中心收貨點收驗收、貨物上架、差異通報及依採購回覆登記入庫。"
      },
      {
        "area_id": "de1a600d-5f64-44d8-a974-6d5e8d990786",
        "title": "庫存盤點管理",
        "scope_text": "執行每週循環盤點，核查庫存異動並複點差異。"
      },
      {
        "area_id": "e563adee-b9df-453e-9147-490e873681ec",
        "title": "新人帶教與上線評估",
        "scope_text": "負責新人第一週倉庫作業示範、跟做觀察及能否獨立上線的判斷。"
      },
      {
        "area_id": "60425c6b-e06c-4156-8c2f-dd42c3945acf",
        "title": "揀貨與補貨作業",
        "scope_text": "負責物流中心揀貨及補貨作業。"
      },
      {
        "area_id": "d83ee610-9798-45ed-88a6-f73ebd208d63",
        "title": "退貨處理",
        "scope_text": "負責客戶退貨及供應商退貨作業。"
      }
    ],
    "tasks": [
      {
        "task_id": "d0e73a95-e8f4-447b-9194-c8962dccb6c8",
        "area_id": "c575f26b-e927-4f91-9ca2-0e36d9a98d38",
        "title": "收貨點收、驗收與差異處理",
        "description": "逐箱清點，核對品項、數量、外包裝與送貨單；發現差異時拍照、登記收貨異常表並通知採購。採購回覆補送或接受後，依回覆結果登記入庫。",
        "outcomes": [
          {
            "detail_id": "c7e2055b-02ee-4623-9ca9-7a0cdb11cf33",
            "text": "收貨差異以照片及收貨異常表記錄並通知採購。"
          },
          {
            "detail_id": "a9366012-d3d4-4c77-920c-670ddba286bc",
            "text": "依採購回覆結果完成入庫登記。"
          }
        ],
        "requirements": [
          {
            "detail_id": "82e1d9fc-e59e-4246-9bdd-f66a3a581b1e",
            "text": "不負責議價、選擇供應商或決定拒收。"
          }
        ]
      },
      {
        "task_id": "eefaefc0-bb39-47a7-b325-d32e0292dd32",
        "area_id": "c575f26b-e927-4f91-9ca2-0e36d9a98d38",
        "title": "貨物上架",
        "description": "負責物流中心貨物上架作業。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "5384e757-b266-4564-bddd-8515d2f59a9b",
        "area_id": "de1a600d-5f64-44d8-a974-6d5e8d990786",
        "title": "執行每週循環盤點與差異查核",
        "description": "每週執行循環盤點；發現差異時，先查近期入庫、出庫及移庫紀錄，再複點。複點後將差異、已查單據及原因記錄於盤點差異表，交倉儲主管核准；主管再交財務調帳，本人不直接修改庫存數量。結案前核對更新後數量；若找不到原因，將差異保留待查。",
        "outcomes": [
          {
            "detail_id": "c3a87860-00e5-4a90-929d-28938934352a",
            "text": "盤點差異、已查單據及原因記錄於盤點差異表，並交倉儲主管核准。"
          },
          {
            "detail_id": "be3f9601-c1ea-4a4c-beee-43124139d41a",
            "text": "結案前核對更新後的庫存數量。"
          },
          {
            "detail_id": "2e3d9763-5074-4777-b825-13136b585081",
            "text": "找不到差異原因時，保留待查。"
          }
        ],
        "requirements": [
          {
            "detail_id": "52d0984e-4395-4ca4-a9fe-481a025b8843",
            "text": "每週執行循環盤點。"
          },
          {
            "detail_id": "507ba8b6-bb2e-4761-bee9-478a3ee44efe",
            "text": "不直接修改庫存數量；差異須經倉儲主管核准後由主管交財務調帳。"
          }
        ]
      },
      {
        "task_id": "a0c977b3-0e2e-4a38-a7f5-58c2569de9fd",
        "area_id": "e563adee-b9df-453e-9147-490e873681ec",
        "title": "帶教新人倉庫作業並評估上線準備",
        "description": "新人第一週示範掃碼、揀貨與安全動線，再讓新人跟著操作；當場觀察是否漏掃、拿錯批號或進入車道，並將觀察記錄於帶教檢核表，由本人判斷新人能否獨立上線。",
        "outcomes": [
          {
            "detail_id": "311a94a5-c5e1-4d22-9cdf-df6d6900be00",
            "text": "帶教檢核表記錄新人操作中的觀察事項。"
          },
          {
            "detail_id": "0a987463-5eae-4b85-81ea-334167981b22",
            "text": "形成新人能否獨立上線的判斷。"
          }
        ],
        "requirements": []
      },
      {
        "task_id": "f801199c-f6a4-4043-a885-c7439957bdb4",
        "area_id": "60425c6b-e06c-4156-8c2f-dd42c3945acf",
        "title": "執行揀貨與補貨作業",
        "description": "負責物流中心揀貨與補貨作業。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "f0168f95-b6e2-4d98-9997-0a01770a73c0",
        "area_id": "d83ee610-9798-45ed-88a6-f73ebd208d63",
        "title": "處理客戶退貨",
        "description": "負責處理客戶退貨。",
        "outcomes": [],
        "requirements": []
      },
      {
        "task_id": "7d10bf4b-873d-40e8-8605-68c539cbbc39",
        "area_id": "d83ee610-9798-45ed-88a6-f73ebd208d63",
        "title": "處理供應商退貨",
        "description": "負責處理供應商退貨。",
        "outcomes": [],
        "requirements": []
      }
    ],
    "capabilities": [
      {
        "capability_id": "854263b9-80ea-414d-a7d9-8b2a30add2d4",
        "kind": "skill",
        "name": "收貨核對與差異通報",
        "description": "核對採購單、送貨單與實收品項和數量，檢查外包裝，並以照片及異常表記錄差異、通知採購。"
      },
      {
        "capability_id": "3d64175e-6421-4c0d-8e62-9ce592f73214",
        "kind": "skill",
        "name": "庫存盤點差異查核",
        "description": "透過查核入庫、出庫及移庫紀錄與複點追查盤點差異，並記錄結果、依權責交辦調帳後核對更新數量。"
      },
      {
        "capability_id": "13fcfc5d-6a4d-4391-a067-502820572c1c",
        "kind": "skill",
        "name": "新人倉庫作業帶教與上線評估",
        "description": "示範掃碼、揀貨與安全動線，觀察新人操作錯誤並記錄於檢核表，據以判斷是否可獨立上線。"
      },
      {
        "capability_id": "2c0073d2-cea5-489b-b07d-c486bf60c2c3",
        "kind": "knowledge",
        "name": "庫存異動與差異調帳流程",
        "description": "了解入庫、出庫與移庫紀錄的查核方式，以及盤點差異經主管核准、財務調帳和結案核對的權責流程。"
      }
    ],
