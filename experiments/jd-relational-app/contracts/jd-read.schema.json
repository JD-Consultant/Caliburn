{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliburn.local/contracts/jd-read-v1.schema.json",
  "title": "ReadCatalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "read": {
      "$ref": "#/$defs/ReadInput"
    },
    "page": {
      "$ref": "#/$defs/ReadPage"
    },
    "failure": {
      "$ref": "#/$defs/ReadFailure"
    }
  },
  "required": [
    "read",
    "page",
    "failure"
  ],
  "$defs": {
    "ReadInput": {
      "title": "ReadInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "current",
            "item",
            "section",
            "history"
          ]
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "view",
        "target_ref",
        "cursor"
      ],
      "description": "Read a complete current JD, an issued item or section, or historical revisions. All arguments are required. Use null target for current or the history index; use a returned cursor to continue exactly the same view. History is read-only."
    },
    "SectionRecord": {
      "title": "SectionRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "section"
          ]
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "section_ref",
        "title"
      ]
    },
    "ContainerRecord": {
      "title": "ContainerRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "container"
          ]
        },
        "container_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "owner_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "child_kind": {
          "type": "string",
          "enum": [
            "duty",
            "task",
            "outcome",
            "requirement",
            "knowledge",
            "skill",
            "collaborator",
            "work_environment",
            "schedule_travel",
            "shared_authority",
            "shared_collaboration",
            "qualification"
          ]
        }
      },
      "required": [
        "type",
        "container_ref",
        "section_ref",
        "owner_ref",
        "child_kind"
      ]
    },
    "ItemRecord": {
      "title": "ItemRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "item"
          ]
        },
        "item_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "container_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "type": "string",
          "enum": [
            "duty",
            "task",
            "outcome",
            "requirement",
            "knowledge",
            "skill",
            "collaborator",
            "work_environment",
            "schedule_travel",
            "shared_authority",
            "shared_collaboration",
            "qualification"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "item_ref",
        "section_ref",
        "container_ref",
        "kind",
        "position"
      ]
    },
    "FieldRecord": {
      "title": "FieldRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "field"
          ]
        },
        "item_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "field_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "enum": [
            "job_title",
            "organization_unit",
            "employee_name",
            "reports_to",
            "purpose",
            "name",
            "description",
            "scope_text",
            "text"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "item_ref",
        "section_ref",
        "field_ref",
        "name",
        "value"
      ]
    },
    "RelationRecord": {
      "title": "RelationRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "task_capability"
          ]
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "task_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capability_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "capability_kind": {
          "type": "string",
          "enum": [
            "knowledge",
            "skill"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "section_ref",
        "task_ref",
        "capability_ref",
        "capability_kind",
        "position"
      ]
    },
    "SourceRecord": {
      "title": "SourceRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "source"
          ]
        },
        "section_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "related_capability_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "type": "string"
        },
        "basis_status": {
          "type": "string",
          "enum": [
            "current",
            "needs_recheck"
          ]
        },
        "readability": {
          "type": "string",
          "enum": [
            "not_checked",
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "type",
        "section_ref",
        "target_ref",
        "related_capability_ref",
        "source_ref",
        "basis_status",
        "readability"
      ]
    },
    "RevisionRecord": {
      "title": "RevisionRecord",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "revision"
          ]
        },
        "revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "initial",
            "manual",
            "ai"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "change_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "revision_ref",
        "revision_number",
        "origin",
        "created_at",
        "change_ref",
        "operation_ref"
      ]
    },
    "ReadRecord": {
      "title": "ReadRecord",
      "anyOf": [
        {
          "$ref": "#/$defs/SectionRecord"
        },
        {
          "$ref": "#/$defs/ContainerRecord"
        },
        {
          "$ref": "#/$defs/ItemRecord"
        },
        {
          "$ref": "#/$defs/FieldRecord"
        },
        {
          "$ref": "#/$defs/RelationRecord"
        },
        {
          "$ref": "#/$defs/SourceRecord"
        },
        {
          "$ref": "#/$defs/RevisionRecord"
        }
      ]
    },
    "ReadPage": {
      "title": "ReadPage",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "view": {
          "type": "string",
          "enum": [
            "current",
            "item",
            "section",
            "history"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "current",
            "history"
          ]
        },
        "revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReadRecord"
          }
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "oversized_unit": {
          "type": "boolean"
        }
      },
      "required": [
        "format_version",
        "view",
        "access",
        "revision_ref",
        "records",
        "start_index",
        "total_records",
        "has_more",
        "next_cursor",
        "oversized_unit"
      ],
      "description": "Application read projection. Fields are complete, not previews. has_more requires continuation; finishing this view does not mean the JD is professionally complete. Source readability is a separate observation from basis_status."
    },
    "ReadFailure": {
      "title": "ReadFailure",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "read_error"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_input",
            "invalid_ref",
            "stale_view",
            "target_missing",
            "read_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "next_action": {
          "type": "string",
          "enum": [
            "correct_arguments",
            "reread_current",
            "stop"
          ]
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "next_action"
      ]
    }
  }
}
