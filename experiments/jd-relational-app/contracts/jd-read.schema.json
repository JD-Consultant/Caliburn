      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 200000
        }
      },
      "required": [
        "message_id",
        "role",
        "text"
      ]
    },
    "SourceReadPage": {
      "title": "SourceReadPage",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
