    "ChangeReadPage": {
      "title": "ChangeReadPage",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "view": {
          "type": "string",
          "enum": [
            "change"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "history"
          ]
        },
        "change_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "base_revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "result_revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "type": "string",
          "enum": [
            "manual",
            "ai"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeReadRecord"
          }
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_changes": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "oversized_unit": {
          "type": "boolean"
        }
      },
      "required": [
        "format_version",
        "view",
        "access",
        "change_ref",
        "operation_ref",
        "base_revision_ref",
        "result_revision_ref",
        "origin",
        "records",
        "start_index",
        "total_records",
        "total_changes",
        "has_more",
        "next_cursor",
        "oversized_unit"
      ],
      "description": "Flat original-operation records grouped by change_index. A page may continue within a change; every full field and each affected task is atomic. Follow next_cursor to completion. Page byte budget measures the exact UTF-8 inner tool result; an unavoidable oversized atomic record is emitted alone and flagged. All content references are history-only; this page is not a current document or a write permission."
    },
    "RestorePreviewPage": {
      "title": "RestorePreviewPage",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2
        },
        "view": {
          "type": "string",
          "enum": [
            "restore_preview"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "current"
          ],
          "description": "The comparison is against the current head, which may move before a restore is confirmed."
        },
        "base_revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "The head this comparison was read at; confirming a restore sends it back, and a head that moved is refused."
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeReadRecord"
          }
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "total_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_changes": {
          "type": "integer",
          "minimum": 0
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "oversized_unit": {
          "type": "boolean"
        },
        "target_revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "The saved revision whose content would become current."
        }
      },
      "required": [
        "format_version",
        "view",
        "access",
        "base_revision_ref",
        "records",
        "start_index",
        "total_records",
        "total_changes",
        "has_more",
        "next_cursor",
        "oversized_unit",
        "target_revision_ref"
      ],
      "description": "What restoring a chosen revision would change, compared against the head it was read at. There is no operation and no origin here: nothing has happened yet."
    },
    "RestorePreviewInput": {
      "title": "RestorePreviewInput",
      "type": "object",
      "additionalProperties": false,
      "description": "Ask what restoring one saved revision would change; reading never writes.",
      "properties": {
        "target_revision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "target_revision_ref",
        "cursor"
      ]
    },
    "SourceReadInput": {
      "title": "SourceReadInput",
      "type": "object",
      "additionalProperties": false,
