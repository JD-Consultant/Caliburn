          "type": "string",
          "enum": [
            "source_read"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "history"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/SourceMessageRecord"
          }
        }
      },
      "required": [
        "format_version",
        "view",
        "access",
        "source_ref",
        "messages"
      ]
    }
  }
