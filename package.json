{
  "name": "caliburn",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "up": "docker compose up -d db && turbo dev",
    "down": "docker compose down && kill-port 3000 8001",
    "infra": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @caliburn/api",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "turbo": "^2.3.0"
  }
}
