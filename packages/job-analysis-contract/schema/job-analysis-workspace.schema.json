{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliburn.dev/schema/job-analysis-workspace.schema.json",
  "title": "JobAnalysisWorkspaceContract",
  "description": "Local Web document and Current JD Task wire contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "DocumentMetadataWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string" }
      }
    },
    "DocumentMetadataView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "updated_at"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "DocumentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "task_count", "updated_at"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "task_count": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "JdHeaderView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competency_name",
        "occupation_category_name",
        "occupation_name",
        "occupation_code",
        "industry_name",
        "industry_code",
        "work_description",
        "competency_level",
        "notes"
      ],
      "properties": {
        "competency_name": { "type": ["string", "null"] },
        "occupation_category_name": { "type": ["string", "null"] },
        "occupation_name": { "type": ["string", "null"] },
        "occupation_code": { "type": ["string", "null"] },
        "industry_name": { "type": ["string", "null"] },
        "industry_code": { "type": ["string", "null"] },
        "work_description": { "type": ["string", "null"] },
        "competency_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "JdHeaderWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "competency_name": { "type": ["string", "null"], "default": null },
        "occupation_category_name": {
          "type": ["string", "null"],
          "default": null
        },
        "occupation_name": { "type": ["string", "null"], "default": null },
        "occupation_code": { "type": ["string", "null"], "default": null },
        "industry_name": { "type": ["string", "null"], "default": null },
        "industry_code": { "type": ["string", "null"], "default": null },
        "work_description": { "type": ["string", "null"], "default": null },
        "competency_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6,
          "default": null
        },
        "notes": { "type": ["string", "null"], "default": null }
      }
    },
    "ReadinessIssueView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "competency_name_missing",
            "work_description_missing",
            "competency_level_missing",
            "task_duty_missing",
            "task_competency_level_missing",
            "duty_without_task",
            "opks_task_link_missing"
          ]
        }
      }
    },
    "DocumentReadinessView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReadinessIssueView" }
        }
      }
    },
    "Enabler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["tool_system", "method", "knowledge", "skill", "other"]
        },
        "name": { "type": "string" }
      }
    },
    "JdTaskWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "purpose_result",
        "context",
        "frequency_text",
        "responsibility_role",
        "enablers"
      ],
      "properties": {
        "statement": { "type": "string" },
        "purpose_result": { "type": ["string", "null"] },
        "context": { "type": ["string", "null"] },
        "frequency_text": { "type": ["string", "null"] },
        "responsibility_role": {
          "type": ["string", "null"],
          "enum": ["primary", "shared", "assist", "", null]
        },
        "enablers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Enabler" }
        },
        "duty_id": { "type": ["string", "null"], "default": null },
        "competency_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6,
          "default": null
        }
      }
    },
    "JdTaskView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "statement",
        "purpose_result",
        "context",
        "frequency_text",
        "responsibility_role",
        "enablers",
        "display_order"
      ],
      "properties": {
        "task_id": { "type": "string" },
        "statement": { "type": "string" },
        "purpose_result": { "type": ["string", "null"] },
        "context": { "type": ["string", "null"] },
        "frequency_text": { "type": ["string", "null"] },
        "responsibility_role": {
          "type": ["string", "null"],
          "enum": ["primary", "shared", "assist", null]
        },
        "enablers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Enabler" }
        },
        "duty_id": { "type": ["string", "null"], "default": null },
        "competency_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6,
          "default": null
        },
        "display_order": { "type": "integer", "minimum": 0 }
      }
    },
    "DutyWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string" }
      }
    },
    "DutyView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duty_id", "statement", "display_order"],
      "properties": {
        "duty_id": { "type": "string" },
        "statement": { "type": "string" },
        "display_order": { "type": "integer", "minimum": 0 }
      }
    },
    "OpksItemWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_kind", "text", "task_refs", "indicator_refs"],
      "properties": {
        "entity_kind": {
          "type": "string",
          "enum": ["output", "indicator", "knowledge", "skill", "attitude"]
        },
        "text": { "type": "string" },
        "task_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "indicator_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "OpksItemView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_kind",
        "text",
        "task_refs",
        "indicator_refs",
        "evidence_quotes"
      ],
      "properties": {
        "entity_id": { "type": "string" },
        "entity_kind": {
          "type": "string",
          "enum": ["output", "indicator", "knowledge", "skill", "attitude"]
        },
        "text": { "type": "string" },
        "task_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "indicator_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_quotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "OpksTaskStatusView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status"],
      "properties": {
        "task_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_employee_answer",
            "proposals_ready",
            "not_ready_for_analysis"
          ]
        }
      }
    },
    "OpksProposalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "operation_id",
        "entity_id",
        "entity_kind",
        "action",
        "status",
        "before",
        "after",
        "edited_after",
        "rejection_reason",
        "stale_reason"
      ],
      "properties": {
        "proposal_id": { "type": "string" },
        "operation_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "entity_kind": {
          "type": "string",
          "enum": ["output", "indicator", "knowledge", "skill", "attitude"]
        },
        "action": {
          "type": "string",
          "enum": ["add", "revise", "remove"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "deferred", "accepted", "edited", "rejected", "stale"]
        },
        "before": {
          "oneOf": [
            { "$ref": "#/$defs/OpksItemView" },
            { "type": "null" }
          ]
        },
        "after": {
          "oneOf": [
            { "$ref": "#/$defs/OpksItemView" },
            { "type": "null" }
          ]
        },
        "edited_after": {
          "oneOf": [
            { "$ref": "#/$defs/OpksItemView" },
            { "type": "null" }
          ]
        },
        "rejection_reason": { "type": ["string", "null"] },
        "stale_reason": { "type": ["string", "null"] }
      }
    },
    "DocumentView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "updated_at",
        "jd_header",
        "readiness",
        "duties",
        "tasks",
        "opks_items",
        "opks_task_status"
      ],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" },
        "jd_header": { "$ref": "#/$defs/JdHeaderView" },
        "readiness": { "$ref": "#/$defs/DocumentReadinessView" },
        "duties": {
          "type": "array",
          "items": { "$ref": "#/$defs/DutyView" }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/JdTaskView" }
        },
        "opks_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpksItemView" }
        },
        "opks_task_status": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpksTaskStatusView" }
        }
      }
    },
    "ConversationTurnView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "speaker", "text"],
      "properties": {
        "turn_id": { "type": "string" },
        "speaker": { "type": "string", "enum": ["employee", "consultant"] },
        "text": { "type": "string" }
      }
    },
    "ActiveQuestionView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "text"],
      "properties": {
        "turn_id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "ProposalJdEntryView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "value"],
      "properties": {
        "task_id": { "type": "string" },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/JdTaskView" },
            { "type": "null" }
          ]
        }
      }
    },
    "ProposalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "action",
        "status",
        "jd_before",
        "jd_after",
        "edited_jd_after",
        "rejection_reason",
        "stale_reason",
        "evidence_quotes"
      ],
      "properties": {
        "proposal_id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["add", "revise", "withdraw", "merge", "split"]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "deferred",
            "accepted",
            "edited",
            "rejected",
            "revision_requested",
            "stale"
          ]
        },
        "jd_before": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProposalJdEntryView" }
        },
        "jd_after": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProposalJdEntryView" }
        },
        "edited_jd_after": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/ProposalJdEntryView" }
        },
        "rejection_reason": { "type": ["string", "null"] },
        "stale_reason": { "type": ["string", "null"] },
        "evidence_quotes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ConsultationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "conversation",
        "active_question",
        "proposals",
        "opks_proposals",
        "tasks",
        "opks_items",
        "opks_task_status"
      ],
      "properties": {
        "document": { "$ref": "#/$defs/DocumentMetadataView" },
        "conversation": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationTurnView" }
        },
        "active_question": {
          "oneOf": [
            { "$ref": "#/$defs/ActiveQuestionView" },
            { "type": "null" }
          ]
        },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProposalView" }
        },
        "opks_proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpksProposalView" }
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/JdTaskView" }
        },
        "opks_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpksItemView" }
        },
        "opks_task_status": {
          "type": "array",
          "items": { "$ref": "#/$defs/OpksTaskStatusView" }
        }
      }
    },
    "EmployeeTurnWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "ProposalDecisionWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accepted", "edited", "rejected", "deferred"]
        },
        "edited_jd_after": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/ProposalJdEntryView" },
          "default": null
        },
        "reason": { "type": ["string", "null"], "default": null }
      }
    },
    "OpksProposalDecisionWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accepted", "edited", "rejected", "deferred"]
        },
        "edited_text": { "type": ["string", "null"], "default": null },
        "reason": { "type": ["string", "null"], "default": null }
      }
    },
    "TaskOrderWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_task_ids"],
      "properties": {
        "ordered_task_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "DutyOrderWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_duty_ids"],
      "properties": {
        "ordered_duty_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ProblemFieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "message"],
      "properties": {
        "field": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ProblemDetail": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "title", "status"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "https://caliburn.dev/problems/job-analysis/document-not-found",
            "https://caliburn.dev/problems/job-analysis/task-not-found",
            "https://caliburn.dev/problems/job-analysis/idempotency-conflict",
            "https://caliburn.dev/problems/job-analysis/authority-conflict",
            "https://caliburn.dev/problems/job-analysis/invalid-task-order",
            "https://caliburn.dev/problems/job-analysis/duty-not-found",
            "https://caliburn.dev/problems/job-analysis/invalid-duty-order",
            "https://caliburn.dev/problems/job-analysis/invalid-request",
            "https://caliburn.dev/problems/job-analysis/proposal-not-found",
            "https://caliburn.dev/problems/job-analysis/consultant-unavailable",
            "https://caliburn.dev/problems/job-analysis/opks-item-not-found"
          ]
        },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": ["string", "null"], "default": null },
        "errors": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/ProblemFieldError" },
          "default": null
        }
      }
    }
  }
}
