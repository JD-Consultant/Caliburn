{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliburn.dev/schema/ocs-document.schema.json",
  "title": "OCSDocument",
  "description": "職能基準(OCS)來源文件 — pdf-to-json 產出、ocs-indexer 消費的交換格式。",
  "type": "object",
  "required": ["ocs_profile"],
  "additionalProperties": true,
  "properties": {
    "version_info": { "allOf": [{ "$ref": "#/$defs/VersionInfo" }], "default": {} },
    "ocs_profile": { "$ref": "#/$defs/OcsProfile" },
    "ocs_content": { "allOf": [{ "$ref": "#/$defs/OcsContent" }], "default": {} },
    "ocs_attitude": { "allOf": [{ "$ref": "#/$defs/OcsAttitude" }], "default": {} },
    "notes": { "allOf": [{ "$ref": "#/$defs/Notes" }], "default": {} }
  },
  "$defs": {
    "PendingSrc": {
      "type": "object",
      "additionalProperties": true,
      "description": "修訂出處:ref_urn(官方來源)與 quote(訪談原話)可並存;「至少一」由 verify 層強制(ADR 0030)。",
      "properties": {
        "ref_urn": { "type": ["string", "null"] },
        "quote": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["turn_id", "text"],
              "properties": { "turn_id": { "type": "integer" }, "text": { "type": "string" } }
            },
            { "type": "null" }
          ],
          "default": null
        }
      }
    },
    "PendingMark": {
      "type": "object",
      "additionalProperties": true,
      "description": "追蹤修訂標記(ADR 0030):AI 寫入一律以 pending 落文件,✓=去標、✗=還原;匯出/定稿由 _strip_underscore 剝除。mod 必帶 prev(舊值)。value 僅「延遲生效」欄位用(表頭主基準:欄位不動、提案值放標記,✓ 才寫入+觸發重算)。",
      "required": ["op", "by", "turn_id"],
      "properties": {
        "op": { "enum": ["add", "mod", "del"] },
        "by": { "const": "ai" },
        "turn_id": { "type": "integer" },
        "prev": {},
        "value": {},
        "src": { "anyOf": [{ "$ref": "#/$defs/PendingSrc" }, { "type": "null" }], "default": null }
      }
    },
    "CodeName": {
      "type": "object",
      "additionalProperties": true,
      "description": "OCS code↔name 條目;code/name 容忍缺漏(消費端 lockstep 過濾),但結構必為物件(防 string 飄移)。",
      "properties": {
        "code": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "_pending": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
      }
    },
    "CodeText": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "code": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "_pending": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
      }
    },
    "VersionEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" },
        "ocs_code": { "type": "string" },
        "ocs_name": { "type": "string" },
        "status": { "type": "string" },
        "update_note": { "type": ["string", "null"] },
        "update_date": { "type": "string" }
      }
    },
    "VersionInfo": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "versions": { "type": "array", "default": [], "items": { "$ref": "#/$defs/VersionEntry" } } }
    },
    "OcsName": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "job_category_name": { "type": ["string", "null"] },
        "occupation_name": { "type": ["string", "null"] }
      }
    },
    "Category": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "job_categories": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } },
        "occupations": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } },
        "industries": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } }
      }
    },
    "OcsProfile": {
      "type": "object",
      "required": ["ocs_code"],
      "additionalProperties": true,
      "properties": {
        "ocs_code": { "type": "string" },
        "ocs_name": { "allOf": [{ "$ref": "#/$defs/OcsName" }], "default": {} },
        "category": { "allOf": [{ "$ref": "#/$defs/Category" }], "default": {} },
        "job_description": { "type": "string" },
        "ocs_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "_pending": {
          "type": "object",
          "additionalProperties": true,
          "description": "表頭 scalar 欄位的修訂標記集合(槽名→PendingMark;ADR 0030)。",
          "properties": {
            "ocs_code": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "job_description": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "ocs_level": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
          }
        }
      }
    },
    "CompetencyBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "competency_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "_pending": {
          "type": "object",
          "additionalProperties": true,
          "description": "區塊 scalar 欄的修訂標記集合(ADR 0030;目前僅 competency_level)。",
          "properties": {
            "competency_level": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
          }
        },
        "indicators": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeText" } },
        "outputs": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } },
        "knowledge": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } },
        "skills": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } }
      }
    },
    "TaskDetails": {
      "type": "object",
      "additionalProperties": true,
      "description": "任務客製細項(訪談引擎 v1,ADR 0023/spec 2026-07-05;OCS 官方來源沒有——由訪談產生,全部 optional。v3 起(ADR 0030)溯源住各槽 _pending.src;已確認值不帶溯源。",
      "properties": {
        "frequency": { "type": ["string", "null"] },
        "time_share_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "duration": { "type": ["string", "null"] },
        "volume": { "type": ["string", "null"] },
        "trigger": { "type": ["string", "null"] },
        "inputs": { "type": ["string", "null"] },
        "tools": { "type": ["string", "null"] },
        "collaborators": { "type": ["string", "null"] },
        "wait_points": { "type": ["string", "null"] },
        "exceptions": { "type": ["string", "null"] },
        "standards": { "type": ["string", "null"] },
        "_pending": {
          "type": "object",
          "additionalProperties": true,
          "description": "細項 scalar 槽的修訂標記集合(槽名→PendingMark;ADR 0030)。",
          "properties": {
            "frequency": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "time_share_pct": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "duration": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "volume": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "trigger": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "inputs": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "tools": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "collaborators": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "wait_points": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "exceptions": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null },
            "standards": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
          }
        }
      }
    },
    "TaskGroup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "task_codes": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } },
        "competency_blocks": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CompetencyBlock" } },
        "details": { "anyOf": [{ "$ref": "#/$defs/TaskDetails" }, { "type": "null" }], "default": null },
        "_pending": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
      }
    },
    "OcuUnit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ocu_code": { "type": "string" },
        "ocu_name": { "type": "string" },
        "tasks": { "type": "array", "default": [], "items": { "$ref": "#/$defs/TaskGroup" } },
        "_pending": { "anyOf": [{ "$ref": "#/$defs/PendingMark" }, { "type": "null" }], "default": null }
      }
    },
    "OcsContent": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "ocu_units": { "type": "array", "default": [], "items": { "$ref": "#/$defs/OcuUnit" } } }
    },
    "OcsAttitude": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "attitudes": { "type": "array", "default": [], "items": { "$ref": "#/$defs/CodeName" } } }
    },
    "Notes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "prerequisites": { "type": "array", "default": [], "items": { "type": "string" } },
        "supplements": { "type": "array", "default": [], "items": { "type": "string" } }
      }
    }
  }
}
